---
import { publicBitmap } from '../utils/bitmap';
import { photoSrcset } from '../utils/photo-src';

interface Props {
  file: string;
  alt: string;
  eager?: boolean;
}

const { file, alt, eager = false } = Astro.props;
/* Ask for twice the viewport so a 1x screen does not stop on the gallery
   tier when the figure is a full column. Descriptors stay real widths. */
const sizes = 'calc((100vw - 2rem) * 2)';
const src = `/images/photography/gallery/${file}.webp`;
const dim = await publicBitmap(src);
---

<picture class="depth-photo">
  <source type="image/avif" srcset={photoSrcset(file, 'avif')} sizes={sizes} />
  <source type="image/webp" srcset={photoSrcset(file, 'webp')} sizes={sizes} />
  <img
    class="depth-photo__img"
    src={src}
    alt={alt}
    width={dim.width}
    height={dim.height}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>
