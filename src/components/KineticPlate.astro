---
/**
 * KineticPlate — luminance-bucketed 3D dot projection of a photograph
 * with multi-spectrum chromatic fringe (oil-on-water iridescence).
 *
 * v8 partitioned the grid across four depth-stacked canvases so the
 * subject pops forward of the background on tilt. v8.1–v8.2 added
 * two chroma canvases (red-orange, cyan-blue) that paint only the
 * outline dots of the bright bucket and screen-blend over the cream.
 *
 * v9.2 layers cursor-coupled color and depth modulation on top of the
 * scroll/tilt foundation. Three new effects, all CSS-variable driven
 * from the existing pointer rAF (no new event listeners, no new
 * canvases, no per-frame paint):
 *   A) Cursor X drives --hue (±30deg). The chroma canvases apply
 *      filter: hue-rotate(var(--hue)) so the rainbow ring shifts
 *      through the spectrum as the cursor sweeps left-to-right.
 *   B) Cursor distance from plate center drives --sat (1.40→0.85).
 *      filter: saturate(var(--sat)) brightens the chroma when the
 *      cursor approaches the subject and softens it at the rim.
 *   D) Cursor distance from plate center drives --depth-scale
 *      (1.30→1.00). Every layer's translateZ multiplies by this
 *      scalar, so the perspective volume expands when the user
 *      examines the plate and settles when they look away.
 *
 * The depth Z moves from `transform` onto the `translate` property
 * so it can transition independently of scroll-driven parallax (which
 * still lives on `transform` and must snap). The chroma layers also
 * gain `filter` to the transitioned property list. Scroll parallax
 * remains a single setProperty per frame.
 *
 * E (subject-locked rotation) is not implemented in v9.2 but is
 * signposted: each LAYERS entry now carries a rotScale field, and
 * the CSS layer rules note where per-layer rotation differentiation
 * would slot in. Cost to add E later: replace stage's rotateX/Y with
 * per-canvas rotateX/Y multiplied by rotScale. No data restructure.
 *
 * v9.0 moves scroll-driven parallax from per-frame canvas repaint to
 * the GPU compositor. The layer canvases used to be cleared and
 * repainted on every scroll rAF tick, with each dot's Y position
 * offset by progress * layer.parallax * MAX_PARALLAX_PX baked in.
 * That works on Apple Silicon but stutters on weaker CPUs because
 * Canvas 2D paints are CPU-bound and each plate runs 8 canvases.
 * In v9.0 the canvases paint exactly once at base position, and a
 * single scalar custom property --p (range roughly [-22, +22]) is
 * written on the stage per scroll frame. Each layer's CSS transform
 * applies its own parallax multiplier via calc(), so the browser
 * composites the motion on the GPU instead of repainting pixels.
 * Result: scroll cost drops from O(canvases × dots × DPR²) per frame
 * to O(1) — a single property write. Headroom restored for adding
 * more visual layers without regressing frame rate.
 *
 * v8.3 expands the chroma layer from 2 channels to 4: red, green,
 * blue, violet. Each channel lives on its own canvas at its own Z
 * depth (r=+40, g=+36, b=+32, v=+28) and sits at its own baseline
 * offset in a different compass direction at rest. At rest the four
 * channels form a rainbow ring around every silhouette. On pointer
 * tilt each channel also drifts in its own direction via CSS calc()
 * on a shared --cx/--cy, which rotates the ring around the rim.
 * Screen-blend overlaps produce spectral intermediates (red+green
 * yellow, blue+violet magenta) giving genuine prismatic depth.
 *
 * Outline detection: 4-neighbor luminance delta. A dot in the bright
 * bucket is "outline" if any cardinal neighbor sits below a fringe
 * threshold — the silhouette where subject meets background. Interior
 * highlight dots have bright neighbors and are excluded. All four
 * chroma channels paint the same outline cells; the ring is composed
 * by color / depth / offset differentiation, not by sparsity.
 *
 * v7 painted every dot on every layer at different opacities; layers
 * stacked but moved in lockstep on rotation. John correctly noticed
 * the plate was tilting as a rigid sheet rather than the subject
 * popping. v8 partitioned by luminance for subject-pop. v8.1/8.2
 * added chromatic fringe. v8.3 turns that fringe into a 4-channel
 * spectrum with per-channel depth — an extra layer of 3D separation
 * inside the chroma ring itself.
 *
 * Grid density: 128x128 (up from 96 in v7/v8 baseline) to give the
 * fringe enough perimeter resolution to read cleanly.
 *
 * Scroll parallax semantics are inverted to match depth: closer (bright)
 * layers drift MORE as the plate traverses the viewport, farther (dim)
 * layers stay anchored. Chroma plates inherit layer 0's parallax to
 * stay locked to the highlight dots they fringe.
 *
 * No autonomous animation loops. No time-based motion. Layers move
 * only when the user scrolls or the cursor travels over the plate.
 * Chroma separation is driven by CSS custom properties set from the
 * same pointer handler that drives --rx/--ry; no per-frame repaint
 * of the chroma canvases on tilt. Quiet Power discipline intact.
 *
 * Build-time derivation only — no runtime image decoding, no new CSP
 * surface. Decorative (role="img" on figure, canvases aria-hidden).
 * Respects prefers-reduced-motion by disabling pointer rotation,
 * scroll parallax, and chroma offset and painting a single static
 * frame. Pointer rotation is further gated on (hover: hover) and
 * (pointer: fine) so touch devices never see rogue tilt from taps.
 * Tears down listeners on astro:before-swap for clean view-transition
 * handoffs.
 *
 * Memory: back two layers render at DPR=1 regardless of device DPR;
 * all four chroma plates also cap at DPR=1 since they paint only
 * sparse silhouette dots and don't need full-res antialiasing.
 */
import signature from '../data/kinetic-signature.json';

export interface Props {
  category: 'sky' | 'earth' | 'water' | 'structure';
  /** Optional additional classes on the outer figure. */
  class?: string;
}

const { category, class: extraClass = '' } = Astro.props;

const frame = signature.frames.find((f: { id: string }) => f.id === category);
if (!frame) throw new Error(`KineticPlate: unknown category "${category}"`);

// v10: geometry is no longer inlined. scripts/emit-kinetic-frames.mjs writes
// each frame's grid to public/data/kinetic/<id>.json at build time; the
// hydration script fetches it at low priority. Removes ~80-130 KB of inline
// data-plate payload per plate from the HTML (/about renders three plates).
const plateSrc = `/data/kinetic/${category}.json`;
---

<figure
  class={`kinetic-plate ${extraClass}`}
  role="img"
  aria-label={`Dot projection of ${frame.alt}`}
  data-plate-src={plateSrc}
>
  <div class="kinetic-plate__stage">
    <canvas class="kinetic-plate__canvas" data-layer="3" aria-hidden="true"></canvas>
    <canvas class="kinetic-plate__canvas" data-layer="2" aria-hidden="true"></canvas>
    <canvas class="kinetic-plate__canvas" data-layer="1" aria-hidden="true"></canvas>
    <canvas class="kinetic-plate__canvas" data-layer="0" aria-hidden="true"></canvas>
    <canvas class="kinetic-plate__chroma" data-chroma="r" aria-hidden="true"></canvas>
    <canvas class="kinetic-plate__chroma" data-chroma="g" aria-hidden="true"></canvas>
    <canvas class="kinetic-plate__chroma" data-chroma="b" aria-hidden="true"></canvas>
    <canvas class="kinetic-plate__chroma" data-chroma="v" aria-hidden="true"></canvas>
  </div>
</figure>

<style>
  .kinetic-plate {
    display: block;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / 1;
    margin: 0;
    padding: 0;
    background: transparent;
    /* perspective on the figure, preserve-3d on the stage — the
       canvases then parallax correctly against each other on rotate. */
    perspective: 900px;
    perspective-origin: 50% 50%;
  }
  @media (max-width: 767px) {
    .kinetic-plate {
      max-width: 400px;
      margin: 0 auto;
    }
  }
  .kinetic-plate__stage {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 140ms ease-out;
    will-change: transform;
  }
  .kinetic-plate__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    backface-visibility: hidden;
    /* v9.2: depth Z lives on `translate` so it can transition
       independently of scroll parallax (which stays on `transform`
       and must snap). 140ms ease-out smooths the cursor-driven
       depth-scale expansion without smearing scroll. */
    transition: translate 140ms ease-out;
    will-change: transform, translate;
  }
  /* True Z-depth per layer, straddling zero. Bright highlights (layer 0)
     sit +32px closer to the viewer; dark shadows (layer 3) sit -32px
     away. 64px of depth separation. v9.2: each Z multiplies by
     --depth-scale (default 1, peaks at ~1.30 when cursor is at plate
     center) — perspective volume breathes with cursor proximity.

     v9.0 parallax: --p is a unitless scalar (roughly [-22, +22] px-
     equivalent) written on the stage per scroll frame. Each layer
     multiplies it by its own parallax constant via calc() so the
     translation is GPU-composited — no canvas repaint required.
     Closer (bright) layers drift more; layer 3 stays anchored. X
     drift is 0.35 of Y, matching the prior canvas-baked behavior.

     E-prep (future): per-layer rotation differentiation would land
     here. The stage rotateX/rotateY would move onto each canvas as
     rotateX(calc(var(--rx, 0deg) * <rotScale>)) — bright bucket gets
     a small rotScale (e.g. 0.7), dark bucket a large one (e.g. 1.3),
     creating a diorama "subject-locked" effect on tilt. rotScale
     values live in the JS LAYERS array. */
  .kinetic-plate__canvas[data-layer="0"] {
    translate: 0 0 calc(var(--depth-scale, 1) * 32px);
    transform: translate3d(calc(var(--p, 0) * 0.35 * 1px),
                           calc(var(--p, 0) * 1.00 * 1px), 0);
  }
  .kinetic-plate__canvas[data-layer="1"] {
    translate: 0 0 calc(var(--depth-scale, 1) * 12px);
    transform: translate3d(calc(var(--p, 0) * 0.21 * 1px),
                           calc(var(--p, 0) * 0.60 * 1px), 0);
  }
  .kinetic-plate__canvas[data-layer="2"] {
    translate: 0 0 calc(var(--depth-scale, 1) * -12px);
    transform: translate3d(calc(var(--p, 0) * 0.105 * 1px),
                           calc(var(--p, 0) * 0.30 * 1px), 0);
  }
  .kinetic-plate__canvas[data-layer="3"] {
    translate: 0 0 calc(var(--depth-scale, 1) * -32px);
    transform: none; /* parallax 0 — anchored */
  }

  /* Chromatic fringe — v8.3 four-channel spectrum. Each channel paints
     the same outline cells with its own color bias, sits at its own
     Z depth (12px total spread), and rests at its own baseline offset
     in a different compass direction. Together the four channels form
     a rainbow ring around every silhouette even at rest. Per-channel
     pointer coupling uses different sign patterns on --cx/--cy via
     CSS calc() so on tilt the channels rotate around the rim rather
     than drifting in lockstep. Screen-blend overlaps produce spectral
     intermediates (r+g=yellow, b+v=magenta). */
  .kinetic-plate__chroma {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    backface-visibility: hidden;
    mix-blend-mode: screen;
    /* v9.2: cursor X drives --hue (±30deg) for spectrum rotation;
       cursor distance from center drives --sat (1.40 peak, 0.85
       floor) for proximity-coupled iridescence. Both default to
       neutral (0deg / 1.0) so the rest state is unchanged. */
    filter: hue-rotate(var(--hue, 0deg)) saturate(var(--sat, 1));
    /* v9.1/v9.2: transition tilt-coupled translate AND filter, NOT
       transform. Scroll parallax lives on transform and must snap —
       transitioning it would desync the chroma ring from the base
       layers during fast scroll on high-refresh displays. */
    transition: translate 140ms ease-out, filter 140ms ease-out;
    will-change: transform, translate, filter;
  }
  /* Per-channel depth stagger: r in front, v in back. Spans 12px
     inside the bright layer's depth region (+32px) so the ring reads
     as a unit but each channel parallaxes at its own rate. Baseline
     offsets fan out in 4 compass directions (NE, SE, SW, NW) so at
     rest with --cx/--cy unset the fringe forms a visible ring. */
  /* Chroma channels share parallax 1.00 with layer 0 so the ring
     stays locked to the highlights it traces during scroll. v9.1
     split the transform: tilt-coupled compass + --cx/--cy lives on
     `translate` (transitioned for hover smoothness); scroll parallax
     lives on `transform` (snap, no transition). v9.2 folds the Z
     depth onto `translate` so it shares the smoothing path with
     --depth-scale, keeping the ring locked to layer 0 as the volume
     expands. */
  .kinetic-plate__chroma[data-chroma="r"] {
    /* Red-orange, NE baseline, forward-most depth */
    translate: calc( 1.5px + var(--cx, 0px))
               calc(-1.0px + var(--cy, 0px))
               calc(var(--depth-scale, 1) * 40px);
    transform:
      translate3d(calc(var(--p, 0) * 0.35 * 1px),
                  calc(var(--p, 0) * 1.00 * 1px), 0);
  }
  .kinetic-plate__chroma[data-chroma="g"] {
    /* Emerald green, SE baseline; --cy inverted so g and r rotate
       against each other on vertical pointer travel */
    translate: calc( 1.2px + var(--cx, 0px))
               calc( 1.2px - var(--cy, 0px))
               calc(var(--depth-scale, 1) * 36px);
    transform:
      translate3d(calc(var(--p, 0) * 0.35 * 1px),
                  calc(var(--p, 0) * 1.00 * 1px), 0);
  }
  .kinetic-plate__chroma[data-chroma="b"] {
    /* Cyan-blue, SW baseline, sign-inverted from r */
    translate: calc(-1.5px - var(--cx, 0px))
               calc( 1.0px - var(--cy, 0px))
               calc(var(--depth-scale, 1) * 32px);
    transform:
      translate3d(calc(var(--p, 0) * 0.35 * 1px),
                  calc(var(--p, 0) * 1.00 * 1px), 0);
  }
  .kinetic-plate__chroma[data-chroma="v"] {
    /* Violet, NW baseline, back-most depth; sign-inverted from g */
    translate: calc(-1.2px - var(--cx, 0px))
               calc(-1.2px + var(--cy, 0px))
               calc(var(--depth-scale, 1) * 28px);
    transform:
      translate3d(calc(var(--p, 0) * 0.35 * 1px),
                  calc(var(--p, 0) * 1.00 * 1px), 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .kinetic-plate__stage {
      transition: none;
      transform: none !important;
    }
    /* Reduced motion: freeze the ring at its baseline rest positions.
       We keep the per-channel Z depth and the compass baseline so the
       fringe is still visible as a static painting, just without any
       pointer-driven rotation. */
    .kinetic-plate__chroma {
      transition: none;
    }
    .kinetic-plate__chroma[data-chroma="r"] {
      translate:  1.5px -1.0px 40px !important;
      transform: none !important;
    }
    .kinetic-plate__chroma[data-chroma="g"] {
      translate:  1.2px  1.2px 36px !important;
      transform: none !important;
    }
    .kinetic-plate__chroma[data-chroma="b"] {
      translate: -1.5px  1.0px 32px !important;
      transform: none !important;
    }
    .kinetic-plate__chroma[data-chroma="v"] {
      translate: -1.2px -1.2px 28px !important;
      transform: none !important;
    }
  }
</style>

<script>
  type Plate = { cols: number; rows: number; grid: number[]; alt: string };

  /**
   * v8: each layer paints ONLY the dots whose luminance falls inside
   * its [lumLo, lumHi) band. Brightest layer sits in front (+translateZ
   * in CSS), darkest sits behind. On tilt, the perspective divide
   * makes the bright subject shift more than the dim background, which
   * is the holographic pop effect.
   *
   * Buckets are non-overlapping and exhaustive over [0, 1]. Each dot
   * paints on exactly one layer per frame, so total draw calls per
   * frame equal a single full grid pass — no regression on v7.
   *
   * Scroll parallax: closer (bright) layers drift more per unit of
   * viewport traversal. Physically consistent with the tilt-driven
   * parallax so both motion drivers reinforce depth the same way.
   */
  // rotScale (E-prep, unused in v9.2): when subject-locked rotation
  // ships, each layer's rotateX/rotateY will multiply the stage tilt
  // by its rotScale. Bright bucket (subject) gets a small value so
  // it stays anchored; dark bucket (background) gets a large value
  // so it swings around the subject. Currently all 1.0 — uniform
  // tilt, identical to v9.1 behavior.
  const LAYERS = [
    // 0: brightest highlights — pops forward, drifts most on scroll
    { lumLo: 0.60, lumHi: 1.01, opacity: 1.00, parallax: 1.00, capDpr: false, rotScale: 1.0 },
    // 1: mid-bright — slight forward pop, moderate drift
    { lumLo: 0.35, lumHi: 0.60, opacity: 0.92, parallax: 0.60, capDpr: false, rotScale: 1.0 },
    // 2: mid-dark — slight recession, mild drift
    { lumLo: 0.15, lumHi: 0.35, opacity: 0.78, parallax: 0.30, capDpr: true,  rotScale: 1.0 },
    // 3: darkest shadows — recedes to back, anchored in scroll
    { lumLo: -0.01, lumHi: 0.15, opacity: 0.62, parallax: 0.00, capDpr: true, rotScale: 1.0 },
  ];

  /**
   * Chromatic fringe channels — v8.3 four-channel spectrum. Each plate
   * paints the same OUTLINE dots of the bright bucket (silhouette
   * where subject meets background) tinted in its own color. The four
   * channels live at four staggered translateZ depths in CSS (40/36/
   * 32/28 px) and at four compass baseline offsets (NE/SE/SW/NW) so
   * the ring is visible at rest and parallaxes at per-channel rates
   * on tilt. Screen-blended on top of layer 0, they contribute only
   * where they sit over cream highlights, and overlaps produce
   * spectral mixes (r+g=yellow, b+v=magenta, r+v=magenta, g+b=cyan).
   *
   * Parallax on scroll is kept equal across channels (1.00) — the
   * ring should scroll as a cohesive unit, not fan out vertically
   * during page travel. The per-channel depth/offset handles the
   * visual differentiation on tilt.
   */
  const CHROMA = [
    { attr: 'r', rgb: '255,72,56',   alpha: 0.72, parallax: 1.00 }, // red-orange
    { attr: 'g', rgb: '80,255,140',  alpha: 0.60, parallax: 1.00 }, // emerald
    { attr: 'b', rgb: '56,168,255',  alpha: 0.72, parallax: 1.00 }, // cyan-blue
    { attr: 'v', rgb: '170,90,255',  alpha: 0.68, parallax: 1.00 }, // violet
  ];

  // Outline detection threshold. A bright-bucket dot is an outline if
  // any 4-neighbor luminance sits below this value. Loosened from the
  // initial tuning so soft cloud edges (thunderheads, diffuse highlights)
  // catch fringe, not just specular-on-shadow transitions.
  const OUTLINE_NEIGHBOR_MAX = 0.52;
  // Bright bucket floor for outline candidacy. Lowered beneath layer 0's
  // lumLo so mid-bright edges participate — the fringe otherwise only
  // lit the very brightest rim which reads as invisible on softer scenes.
  const OUTLINE_LUM_MIN = 0.48;
  // Chroma dot radius multiplier. Boosting past 1.0 lets the chroma
  // dots extend beyond the cream dot beneath them, so even at rest the
  // baseline CSS offsets reveal a visible colored rim.
  const CHROMA_RADIUS_BOOST = 1.45;
  // Pointer-driven chroma offset in CSS pixels. JS writes --cx/--cy
  // in [-MAX_CHROMA_PX, +MAX_CHROMA_PX]; CSS calc() combines that with
  // each channel's compass baseline. Zero at rest — each channel's
  // baseline is already non-zero in its own compass direction, so the
  // ring is visible without any pointer input.
  const MAX_CHROMA_PX = 3.2;

  // Dot shaping: both radius and alpha scale with luminance so the
  // photograph is immediately recognizable. Range identical to v5.
  const DOT_R_MIN          = 0.50;
  const DOT_R_MAX          = 1.70;
  const DOT_R_MOBILE_MIN   = 0.40;
  const DOT_R_MOBILE_MAX   = 1.35;
  const ALPHA_FLOOR        = 0.03;
  const ALPHA_RANGE        = 0.97;
  const RGB                = '253,252,250'; // cream token
  // Furthest layer can drift at most this many pixels when the plate
  // is at the top or bottom of the viewport. Front layer is anchored.
  const MAX_PARALLAX_PX    = 22;
  // Pointer tilt bound. Symmetric on both axes.
  const MAX_TILT_DEG       = 10;

  // v9.2 cursor-coupling bounds.
  // A: hue rotation. Cursor X drives ±MAX_HUE_DEG. 30° feels like
  // "the light source moved"; larger values rotate the rainbow
  // identity past recognizability.
  const MAX_HUE_DEG        = 30;
  // B: saturation pump. Cursor at plate center -> SAT_PEAK (vivid);
  // cursor at rim -> SAT_FLOOR (subdued). Pointer-leave -> 1.0.
  const SAT_PEAK           = 1.40;
  const SAT_FLOOR          = 0.85;
  // D: depth volume expansion. Cursor at center -> DEPTH_PEAK,
  // cursor at rim -> DEPTH_FLOOR. Pointer-leave -> 1.0.
  const DEPTH_PEAK         = 1.30;
  const DEPTH_FLOOR        = 1.00;
  // sqrt(2) — max possible distance for clamped normalized cursor
  // coords [-1,1]; pre-computed so we can map distance to [0,1].
  const NORM_MAX_DIST      = 1.4142135623730951;

  // v10: fetch geometry from public/data/kinetic/<id>.json rather than an
  // inline data-plate attribute. Returns a teardown synchronously so the mount
  // loop is unchanged; real listeners attach once the JSON resolves. The cancel
  // flag guards against a fast view-transition swap tearing down mid-fetch.
  function initKineticPlate(fig: HTMLElement): () => void {
    const src = fig.getAttribute('data-plate-src');
    if (!src) return () => {};
    let cancelled = false;
    let teardown: () => void = () => {};
    fetch(src, { priority: 'low' } as any)
      .then((r) => r.json())
      .then((data: Plate) => {
        if (cancelled) return;
        if (!data || !data.grid || !data.cols || !data.rows) return;
        teardown = setupPlate(fig, data);
      })
      .catch(() => { /* network/parse fail: leave canvases empty, never throw */ });
    return () => { cancelled = true; teardown(); };
  }

  function setupPlate(fig: HTMLElement, data: Plate): () => void {
    const stage = fig.querySelector('.kinetic-plate__stage') as HTMLElement | null;
    if (!stage) return () => {};

    const canvases: HTMLCanvasElement[] = [];
    const ctxs: CanvasRenderingContext2D[] = [];
    for (let i = 0; i < LAYERS.length; i++) {
      const c = fig.querySelector<HTMLCanvasElement>(`canvas[data-layer="${i}"]`);
      if (!c) return () => {};
      const cx = c.getContext('2d');
      if (!cx) return () => {};
      canvases[i] = c;
      ctxs[i] = cx;
    }

    // Chroma plates (red/blue outline fringe). If the DOM is missing
    // them, proceed without fringe rather than breaking the whole plate.
    const chromaCanvases: HTMLCanvasElement[] = [];
    const chromaCtxs: CanvasRenderingContext2D[] = [];
    for (let i = 0; i < CHROMA.length; i++) {
      const c = fig.querySelector<HTMLCanvasElement>(`canvas[data-chroma="${CHROMA[i].attr}"]`);
      if (!c) continue;
      const cx = c.getContext('2d');
      if (!cx) continue;
      chromaCanvases[i] = c;
      chromaCtxs[i] = cx;
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Density: halve on narrow viewports to protect frame budget.
    let colStep = 1, rowStep = 1;
    let narrow = false;
    const setDensity = () => {
      narrow = window.innerWidth < 640;
      colStep = narrow ? 2 : 1;
      rowStep = narrow ? 2 : 1;
    };
    setDensity();

    let width = 0, height = 0;
    const resize = () => {
      const rect = fig.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      const deviceDpr = Math.max(1, Math.min(3, window.devicePixelRatio || 1));
      for (let i = 0; i < LAYERS.length; i++) {
        const dpr = LAYERS[i].capDpr ? 1 : deviceDpr;
        const c = canvases[i];
        c.width = Math.floor(width * dpr);
        c.height = Math.floor(height * dpr);
        c.style.width = width + 'px';
        c.style.height = height + 'px';
        ctxs[i].setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      // Chroma plates cap DPR at 1 — sparse silhouette paints don't
      // need full-resolution antialiasing and capping keeps per-plate
      // backing-store growth in check with the two extra canvases.
      for (let i = 0; i < chromaCanvases.length; i++) {
        const c = chromaCanvases[i];
        if (!c) continue;
        c.width = Math.floor(width);
        c.height = Math.floor(height);
        c.style.width = width + 'px';
        c.style.height = height + 'px';
        chromaCtxs[i].setTransform(1, 0, 0, 1, 0, 0);
      }
      setDensity();
    };
    resize();

    /**
     * Scroll-driven parallax signal. Returns a number in roughly
     * [-1, 1]: -1 when the plate center sits at the top of the
     * viewport, +1 at the bottom, 0 when centered.
     *
     * v9.1: avoids getBoundingClientRect on the hot path. The figure's
     * absolute Y position is cached at mount, after resize, and on
     * visibility re-entry. Per-frame cost reduces to two cheap reads
     * (window.scrollY, window.innerHeight) and arithmetic — no forced
     * layout flush. With 4+ plates on a page this used to mean 4
     * synchronous layout queries per scroll frame.
     */
    let cachedFigCenterY = 0;  // absolute Y of figure center in document
    function refreshFigCache(): void {
      const r = fig.getBoundingClientRect();
      cachedFigCenterY = r.top + window.scrollY + r.height / 2;
    }
    function viewportProgress(): number {
      const vp = window.innerHeight || 1;
      const center = cachedFigCenterY - window.scrollY;
      const p = (center - vp / 2) / (vp / 2);
      return Math.max(-1, Math.min(1, p));
    }

    function drawLayer(layerIdx: number): void {
      const ctx = ctxs[layerIdx];
      const layer = LAYERS[layerIdx];

      ctx.clearRect(0, 0, width, height);

      // v9.0: paint at base position only. Scroll parallax is applied
      // by CSS via --p on the stage; canvas content is scroll-invariant.

      const cellW = width / (data.cols / colStep);
      const cellH = height / (data.rows / rowStep);

      const dotMin = narrow ? DOT_R_MOBILE_MIN : DOT_R_MIN;
      const dotMax = narrow ? DOT_R_MOBILE_MAX : DOT_R_MAX;

      ctx.globalAlpha = layer.opacity;

      for (let ry = 0, y = 0; ry < data.rows; ry += rowStep, y++) {
        const cy = y * cellH + cellH / 2;
        for (let rx = 0, x = 0; rx < data.cols; rx += colStep, x++) {
          const idx = ry * data.cols + rx;
          const lum = data.grid[idx];

          // v8 partition: this layer owns dots in [lumLo, lumHi).
          // Every dot lands on exactly one layer per frame; dots
          // outside the band are skipped — they belong to a sibling.
          if (lum < layer.lumLo || lum >= layer.lumHi) continue;

          const alpha = ALPHA_FLOOR + ALPHA_RANGE * lum;
          if (alpha < 0.03) continue;

          const r = dotMin + (dotMax - dotMin) * lum;
          const cx = x * cellW + cellW / 2;

          ctx.beginPath();
          ctx.fillStyle = `rgba(${RGB},${alpha.toFixed(3)})`;
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.globalAlpha = 1;
    }

    /**
     * Paint a single chromatic fringe plate. Only outline dots in the
     * bright bucket (layer 0 band) render — the silhouette ring where
     * subject meets background. Interior highlights are left dark so
     * the screen blend contributes nothing there and the cream stays
     * pure. Mirrors layer 0's parallax so the fringe stays locked to
     * the highlights it traces through scroll.
     */
    function drawChroma(chromaIdx: number): void {
      const ctx = chromaCtxs[chromaIdx];
      if (!ctx) return;
      const chroma = CHROMA[chromaIdx];

      ctx.clearRect(0, 0, width, height);
      if (reduced) return;

      // v9.0: chroma also paints at base position. Scroll parallax (1.00,
      // matching layer 0) is applied via --p in the chroma's CSS transform.

      const cellW = width / (data.cols / colStep);
      const cellH = height / (data.rows / rowStep);

      const dotMin = narrow ? DOT_R_MOBILE_MIN : DOT_R_MIN;
      const dotMax = narrow ? DOT_R_MOBILE_MAX : DOT_R_MAX;

      ctx.fillStyle = `rgba(${chroma.rgb},${chroma.alpha.toFixed(3)})`;

      for (let ry = 0, y = 0; ry < data.rows; ry += rowStep, y++) {
        const cy = y * cellH + cellH / 2;
        for (let rx = 0, x = 0; rx < data.cols; rx += colStep, x++) {
          const idx = ry * data.cols + rx;
          const lum = data.grid[idx];

          // Bright bucket gate — only highlight dots can be fringed.
          if (lum < OUTLINE_LUM_MIN) continue;

          // 4-neighbor luminance probe. A dot is an OUTLINE if any
          // cardinal neighbor sits below the fringe threshold. Edge
          // cells (no neighbor on one side) treat the missing
          // neighbor as dark — the plate edge is always a silhouette.
          const up    = ry > 0                 ? data.grid[idx - data.cols] : 0;
          const dn    = ry < data.rows - 1     ? data.grid[idx + data.cols] : 0;
          const lf    = rx > 0                 ? data.grid[idx - 1]         : 0;
          const rt    = rx < data.cols - 1     ? data.grid[idx + 1]         : 0;
          const minNbr = Math.min(up, dn, lf, rt);
          if (minNbr >= OUTLINE_NEIGHBOR_MAX) continue;

          // Radius tracks luminance the same way the base layer does,
          // boosted so the chroma dot extends beyond the cream dot it
          // fringes — the baseline CSS offset then exposes a visible
          // colored rim even before the user tilts the plate.
          const r = (dotMin + (dotMax - dotMin) * lum) * CHROMA_RADIUS_BOOST;
          const cx = x * cellW + cellW / 2;

          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function drawAll(): void {
      // v9.0: paint canvases at base position. Called only on initial
      // paint, resize, and visibility re-entry — never on scroll.
      for (let i = 0; i < LAYERS.length; i++) drawLayer(i);
      for (let i = 0; i < CHROMA.length; i++) drawChroma(i);
    }

    // Apply current scroll progress as a single CSS custom property.
    // Each layer's CSS transform multiplies --p by its own parallax
    // constant via calc(), so the browser composites the motion on
    // the GPU. Cost per scroll frame: one getBoundingClientRect (in
    // viewportProgress) + one setProperty.
    function applyScroll(): void {
      if (reduced) return;
      const p = viewportProgress() * MAX_PARALLAX_PX;
      stage.style.setProperty('--p', p.toFixed(2));
    }

    // Visibility gate: skip redraws while the plate is fully off-screen.
    // v9.1: also refresh the figure cache on visibility re-entry so any
    // layout shift that happened off-screen (images loading, etc.) is
    // picked up before the next scroll frame uses the stale Y.
    let visible = true;
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const wasVisible = visible;
            visible = e.isIntersecting;
            if (visible && !wasVisible) refreshFigCache();
          }
        },
        { rootMargin: '200px' },
      );
      io.observe(fig);
    }

    // rAF-coalesced scroll handler. v9.0: writes --p, does NOT repaint
    // the canvases. Single property write per scroll frame; the GPU
    // compositor handles the layer translations.
    let scrollScheduled = false;
    const scheduleScroll = () => {
      if (scrollScheduled) return;
      scrollScheduled = true;
      requestAnimationFrame(() => {
        scrollScheduled = false;
        if (visible) applyScroll();
      });
    };

    // Pointer-tracked tilt + chroma separation. Per-plate: each plate
    // tracks the cursor against its own bounding rect, so hovering one
    // plate does not affect the others. rAF-coalesced. The chroma
    // offset rides on the same signal as the tilt — same flush, no
    // canvas repaint, just CSS custom-property writes.
    let tiltRx = 0, tiltRy = 0;
    // Pointer-driven chroma offset. Zero at rest — each channel's
    // compass baseline lives in CSS calc() so the ring is visible
    // whether or not the cursor is over the plate.
    let chromaCx = 0, chromaCy = 0;
    // v9.2 cursor-coupling state: hue rotation (deg), saturation
    // multiplier, depth-volume scalar. All neutral at rest so the
    // figure is unchanged when the cursor is off-plate.
    let hueShift = 0;
    let satScale = 1;
    let depthScale = 1;
    let tiltScheduled = false;
    const applyTilt = () => {
      stage.style.setProperty('--rx', tiltRx.toFixed(2) + 'deg');
      stage.style.setProperty('--ry', tiltRy.toFixed(2) + 'deg');
      stage.style.setProperty('--cx', chromaCx.toFixed(2) + 'px');
      stage.style.setProperty('--cy', chromaCy.toFixed(2) + 'px');
      // v9.2 cursor-coupling: written on the same rAF as tilt so all
      // pointer-driven properties commit in a single style flush.
      stage.style.setProperty('--hue', hueShift.toFixed(2) + 'deg');
      stage.style.setProperty('--sat', satScale.toFixed(3));
      stage.style.setProperty('--depth-scale', depthScale.toFixed(3));
    };
    const scheduleTilt = () => {
      if (tiltScheduled) return;
      tiltScheduled = true;
      requestAnimationFrame(() => {
        tiltScheduled = false;
        applyTilt();
      });
    };
    const onPointerMove = (e: PointerEvent) => {
      const r = fig.getBoundingClientRect();
      if (r.width <= 0 || r.height <= 0) return;
      const nx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
      const ny = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
      // Clamp to [-1, 1], then scale to ±MAX_TILT_DEG.
      // Invert Y so moving cursor up tilts the plate's top away from viewer.
      const clampedNx = Math.max(-1, Math.min(1, nx));
      const clampedNy = Math.max(-1, Math.min(1, ny));
      tiltRy = clampedNx * MAX_TILT_DEG;
      tiltRx = -clampedNy * MAX_TILT_DEG;
      // Chroma offset: pure pointer-driven term. Each channel's CSS
      // transform combines this --cx/--cy with its own compass baseline
      // via calc(), so the same JS writes rotate all four channels
      // around the silhouette in their respective directions.
      chromaCx = clampedNx * MAX_CHROMA_PX;
      chromaCy = clampedNy * MAX_CHROMA_PX;
      // v9.2 cursor-coupling computations.
      // A) Hue rotation: cursor X maps linearly to ±MAX_HUE_DEG so
      // a left-to-right sweep rotates the rainbow ring through the
      // spectrum.
      hueShift = clampedNx * MAX_HUE_DEG;
      // Cursor distance from plate center, normalized to [0, 1].
      // Used by both saturation and depth scale below.
      const dist = Math.min(1,
        Math.sqrt(clampedNx * clampedNx + clampedNy * clampedNy) / NORM_MAX_DIST);
      // B) Saturation pump: vivid at center, subdued at rim. Linear
      // interp between SAT_PEAK and SAT_FLOOR.
      satScale = SAT_PEAK - (SAT_PEAK - SAT_FLOOR) * dist;
      // D) Depth volume expansion: full volume at center, base
      // volume at rim. Linear interp between DEPTH_PEAK and
      // DEPTH_FLOOR.
      depthScale = DEPTH_PEAK - (DEPTH_PEAK - DEPTH_FLOOR) * dist;
      scheduleTilt();
    };
    const onPointerLeave = () => {
      tiltRx = 0;
      tiltRy = 0;
      // Return chroma offset to zero — each channel falls back to its
      // CSS compass baseline, so the ring stays visible when the cursor
      // leaves the plate.
      chromaCx = 0;
      chromaCy = 0;
      // v9.2: reset cursor-coupled properties to neutral so the plate
      // settles back to its rest expression (zero hue shift, default
      // saturation, base depth volume).
      hueShift = 0;
      satScale = 1;
      depthScale = 1;
      scheduleTilt();
    };

    // Initial paint + seed scroll position so the plate sits at its
    // current viewport-progress offset before the user scrolls.
    refreshFigCache();
    drawAll();
    applyScroll();

    const onScroll = () => scheduleScroll();
    const onResize = () => { resize(); refreshFigCache(); drawAll(); applyScroll(); };

    window.addEventListener('resize', onResize, { passive: true });
    if (!reduced) {
      window.addEventListener('scroll', onScroll, { passive: true });
      if (finePointer) {
        fig.addEventListener('pointermove', onPointerMove, { passive: true });
        fig.addEventListener('pointerleave', onPointerLeave, { passive: true });
      }
    }

    return () => {
      window.removeEventListener('resize', onResize);
      window.removeEventListener('scroll', onScroll);
      fig.removeEventListener('pointermove', onPointerMove);
      fig.removeEventListener('pointerleave', onPointerLeave);
    };
  }

  let teardowns: Array<() => void> = [];
  const mountAll = () => {
    teardowns.forEach((fn) => fn());
    teardowns = [];
    document.querySelectorAll<HTMLElement>('.kinetic-plate').forEach((el) => {
      teardowns.push(initKineticPlate(el));
    });
  };
  mountAll();
  document.addEventListener('astro:after-swap', mountAll);
  document.addEventListener('astro:before-swap', () => {
    teardowns.forEach((fn) => fn());
    teardowns = [];
  });
</script>
