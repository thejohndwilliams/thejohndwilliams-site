    <p class="case-study-title">Case study title</p>
    <figure class="case-study-figure" aria-hidden="true">
      <div class="case-study-frame"></div>
    </figure>
    <div class="case-study-body">
      <p>Paragraph</p>
      <p>Paragraph</p>
      <p>Paragraph</p>
    </div>
  </div>
</section>
)}
