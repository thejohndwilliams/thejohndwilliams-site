---
import { getCurrentYear } from '../utils/date';
import GlassPillGL from './GlassPillGL.astro';

const currentYear = getCurrentYear();
---

{/* Spruced 2026-08-01 (owner order): the inquiry moves home to the foot of
    every page, in the material. The verse keeps the last word's weight;
    the small print stays small. */}
<footer class="glass-footer border-t border-white/5" transition:persist>
  <div class="container-narrow py-12 sm:py-16">
    <div class="flex flex-col items-center text-center gap-8 sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <p class="font-serif italic text-base sm:text-lg text-cream/70">
        <a
          href="https://www.biblegateway.com/passage/?search=John%2015%3A13&amp;version=KJV"
          target="_blank"
          rel="noopener noreferrer"
          class="link-draw hover:text-cream transition-colors duration-300"
        >John 15:13</a>
      </p>
      <GlassPillGL label="Inquire" href="mailto:jndwcreative@gmail.com" variant="c" class="shrink-0" />
    </div>
    <div class="mt-10 pt-6 border-t border-white/5 flex flex-col items-center gap-2 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-xs opacity-50">
        &copy; {currentYear} John D. Williams &middot; <a href="/privacy/" class="link-draw hover:text-cream transition-colors duration-300">Privacy</a>
      </p>
      <a href="/llms.txt" class="text-xs text-mute link-draw hover:text-cream transition-colors duration-300 min-h-[44px] flex items-center">
        For AI agents
      </a>
    </div>
  </div>
</footer>
