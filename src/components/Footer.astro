---
import { getCurrentYear } from '../utils/date';

const currentYear = getCurrentYear();
---

<footer class="py-8 sm:py-12 md:py-16 glass-footer" transition:persist>
  <div class="container-narrow">
    <div class="flex flex-col items-center text-center sm:text-left sm:flex-row sm:items-center sm:justify-between gap-4 sm:gap-6">
      <div class="space-y-1">
        <p class="text-xs sm:text-sm opacity-60">
          &copy; {currentYear} John D. Williams ·
          <a href="/writing" class="link-draw hover:text-cream transition-colors duration-300">Writing</a> ·
          <a href="/privacy" class="link-draw hover:text-cream transition-colors duration-300">Privacy</a>
        </p>
        <p class="text-xs sm:text-sm opacity-50 italic font-serif">
          <a href="https://www.biblegateway.com/passage/?search=John%2015%3A13&amp;version=KJV" target="_blank" rel="noopener noreferrer" class="link-draw hover:text-cream transition-colors duration-300">John 15:13</a>
        </p>
      </div>

      <div class="flex items-center">
        <a
          href="/llms.txt"
          class="text-xs sm:text-sm text-mute link-draw hover:text-cream transition-colors duration-300 min-h-[44px] flex items-center"
        >
          For AI agents
        </a>
      </div>
    </div>
  </div>
</footer>
