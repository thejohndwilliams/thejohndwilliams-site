---
import { getCurrentYear, socialLinks } from '../utils/date';

const currentYear = getCurrentYear();
---

<footer class="py-8 sm:py-12 md:py-16 border-t border-white/5" transition:persist>
  <div class="container-narrow">
    <div class="flex flex-col items-center text-center sm:text-left sm:flex-row sm:items-center sm:justify-between gap-4 sm:gap-6">
      <div class="space-y-1">
        <p class="text-xs sm:text-sm opacity-60">
          &copy; {currentYear} John D. Williams ·
          <a href="/privacy" class="hover:text-stone-light transition-colors duration-300">Privacy</a>
        </p>
        <p class="text-xs sm:text-sm opacity-50 italic font-serif">
          John 15:13
        </p>
        <button
          id="theme-toggle"
          type="button"
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 text-[10px] sm:text-xs text-mute hover:text-stone-light transition-colors duration-300 min-h-[44px]"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3a9 9 0 010 18z" fill="currentColor" stroke="none" />
          </svg>
          <span id="theme-toggle-label">Dim</span><span class="sr-only"> background</span>
        </button>
      </div>

      <div class="flex items-center gap-6 sm:gap-8">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs sm:text-sm text-mute hover:text-stone-light transition-colors duration-300 min-h-[44px] flex items-center"
          >
            {link.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<script>
  // Dim <-> true-black toggle. The pre-paint script in BaseLayout has already
  // applied any saved preference; this only wires the control and keeps the
  // label / theme-color meta in sync. The footer persists across View
  // Transitions (transition:persist), so guard against double-binding.
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-toggle-label');
    const meta = document.querySelector('meta[name="theme-color"]');
    if (!btn) return;
    const sync = () => {
      const black = document.documentElement.getAttribute('data-theme') === 'black';
      if (label) label.textContent = black ? 'True black' : 'Dim';
      btn.setAttribute('aria-pressed', String(black));
      if (meta) meta.setAttribute('content', black ? '#000000' : '#0a0a0a');
    };
    sync();
    if ((btn as HTMLElement).dataset.bound) return;
    (btn as HTMLElement).dataset.bound = '1';
    btn.addEventListener('click', () => {
      const black = document.documentElement.getAttribute('data-theme') === 'black';
      if (black) document.documentElement.removeAttribute('data-theme');
      else document.documentElement.setAttribute('data-theme', 'black');
      try { localStorage.setItem('jw-theme', black ? 'dim' : 'black'); } catch (e) {}
      sync();
    });
  }
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>