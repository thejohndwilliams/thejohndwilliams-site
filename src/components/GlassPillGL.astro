---
/* GlassPillGL (Glass Build B, v1 - 2026-08-01)
 * A pill that BENDS the photograph behind it (owner ruling, June 2026:
 * "the pill needs to be a glass pill that bends the light coming from my
 * work behind it" - refraction, never tint).
 *
 * THE WORKING - first principles, named:
 *   Geometry   IQ rounded-box signed distance -> a height field whose
 *              curvature concentrates at the rim (Gaussian bump in d),
 *              flat and clear at the center. Real lens edges, calm middle.
 *   Refraction Snell's law via GLSL refract(), incident ray (0,0,-1),
 *              one thin interface. Screen-space displacement of the
 *              backdrop sample - an approximation, and an honest one.
 *   Dispersion Per-channel index of refraction (R/G/B sample slightly
 *              different bent rays), the same reason a prism rainbows.
 *   Rim        Schlick's approximation of Fresnel reflectance,
 *              F = F0 + (1-F0)(1-cos t)^5, F0 = 0.04 (glass in air),
 *              tinted cream - the site's one light.
 *   Specular   Gaussian falloff around the pointer, weighted by rim
 *              curvature. exp(-r^2/s^2) - the same kernel as the blur
 *              the Beyond envelope documents.
 *   Backdrop   The KNOWN hero asset re-sampled as a texture; UV window
 *              computed from the object-fit:cover geometry. Never
 *              html2canvas, never a DOM capture.
 * Fallback: no WebGL2 -> the canvas is removed and the anchor's CSS
 * glass (the site's material tokens) carries the pill. Reduced motion:
 * one static frame, no clock, no pointer.
 */
interface Props {
  label: string;
  variant: 'a' | 'b' | 'c';
  href?: string;
  class?: string;
  /** Descriptive accessible name when the visible label is terse ("More"). */
  ariaLabel?: string;
}
const { label, variant, href = 'mailto:jndwcreative@gmail.com', class: cls = '', ariaLabel } = Astro.props;
---

<a href={href} class={`gpill press-feedback ${cls}`} data-variant={variant} data-gpill aria-label={ariaLabel}>
  <canvas class="gpill-gl" aria-hidden="true"></canvas>
  <span class="gpill-label">
    {label}
    <svg class="gpill-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
  </span>
</a>

<style>
  .gpill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.9rem;
    border-radius: 9999px;
    overflow: hidden;
    isolation: isolate;
    /* CSS fallback body = the site's rest-state material; the canvas
       replaces the backdrop when WebGL2 is present. */
    border: 1px solid var(--m-rest-border);
    box-shadow: inset 0 1px 0 var(--m-rest-inset), 0 0 24px var(--m-rest-glow);
    background: rgba(255, 255, 255, 0.04);
    transition: border-color 0.5s ease, box-shadow 0.5s ease;
  }
  .gpill:hover { border-color: var(--m-lit-border); box-shadow: inset 0 1px 0 var(--m-lit-inset), 0 0 28px var(--m-lit-glow); }
  /* One object, never a pill layered on a pill (owner catch 2026-08-01):
     when the shader owns the material, the CSS chrome stands down entirely.
     The Fresnel rim IS the ring; the pointer specular IS the hover. */
  .gpill.gpill-live,
  .gpill.gpill-live:hover { border-color: transparent; background: transparent; box-shadow: none; }
  .gpill-gl { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  /* backdrop-filter law (vault, Liquid_Glass 2026-06-09): content above the
     glass paints only with position:relative + z-index. Same law holds for
     a canvas backdrop. */
  .gpill-label {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(244, 234, 222, 1);
    /* The halo is the contrast mechanism over refractive glass: a tight dark
       ring around each stroke, then two soft falls. */
    text-shadow:
      0 1px 2px rgba(7, 8, 10, 0.85),
      0 0 10px rgba(7, 8, 10, 0.65),
      0 0 22px rgba(7, 8, 10, 0.45);
  }
  .gpill-arrow { width: 1rem; height: 1rem; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .gpill:hover .gpill-arrow { transform: translateX(4px); }
</style>

<script>
  const VERT = `#version 300 es
  precision highp float;
  out vec2 vUv;
  void main() {
    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    vUv = p;
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
  }`;

  const FRAG = `#version 300 es
  precision highp float;
  in vec2 vUv;
  out vec4 fragColor;
  uniform sampler2D uTex;
  uniform vec2 uAspect;    // (cssW/cssH, 1)
  uniform vec2 uUV0;       // texture uv of the canvas' top-left (top-based v)
  uniform vec2 uUVScale;   // uv span of the whole canvas
  uniform vec2 uPointer;   // top-based, 0..1 in canvas space
  uniform float uPointerAmt;
  uniform float uTime;
  uniform float uBendUV;   // refraction displacement, in uv units
  uniform float uDisp;     // chromatic dispersion on/off
  uniform float uRim;      // Fresnel rim gain
  uniform float uSpec;     // pointer specular gain
  uniform float uBreath;   // slow living modulation
  uniform float uGrad;     // cream gradient gain
  uniform float uRidge;    // wall inset from silhouette
  uniform float uSigma;    // wall width
  uniform float uSlope;    // bend strength inside the wall
  uniform float uSmokeMax; // smoked-core ceiling over bright ground

  // IQ rounded-box signed distance (Inigo Quilez, distance functions).
  float sdRoundedBox(vec2 p, vec2 b, float r) {
    vec2 q = abs(p) - b + r;
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - r;
  }

  void main() {
    // Top-based frame position, height-normalized geometry.
    vec2 f = vec2(vUv.x, 1.0 - vUv.y);          // 0..1, y down
    vec2 p = (f - 0.5) * uAspect;               // centered, y in [-0.5, 0.5]
    float r = 0.5 - 0.02;                        // capsule
    vec2 b = uAspect * 0.5 - 0.02;
    float d = sdRoundedBox(p, b, r);             // < 0 inside
    float aa = 1.5 * fwidth(d);
    float mask = 1.0 - smoothstep(-aa, aa, d);
    if (mask <= 0.0) { fragColor = vec4(0.0); return; }

    // Height field: curvature lives at the rim (Gaussian bump in distance),
    // the center stays optically flat - lens edge, clear middle.
    float breath = 1.0 + uBreath * 0.06 * sin(uTime * 0.55);
    float sigma = uSigma * breath;
    float rimBump = exp(-pow((d + uRidge) / sigma, 2.0));

    // Backdrop luminance (one tap, unbent) tempers the rim: cream holds
    // over dark ground, restrains over bright - the light must never blow.
    vec2 uvBase = uUV0 + f * uUVScale;
    float lumB = dot(texture(uTex, clamp(uvBase, 0.0, 1.0)).rgb, vec3(0.299, 0.587, 0.114));
    float rimTemper = mix(1.0, 0.32, smoothstep(0.45, 0.85, lumB));

    // Surface normal from the numeric gradient of the distance field
    // (central differences), tilted by rim slope.
    float e = 0.004;
    vec2 g = vec2(
      sdRoundedBox(p + vec2(e, 0.0), b, r) - sdRoundedBox(p - vec2(e, 0.0), b, r),
      sdRoundedBox(p + vec2(0.0, e), b, r) - sdRoundedBox(p - vec2(0.0, e), b, r)
    ) / (2.0 * e);
    float slope = uSlope * rimBump;
    vec3 n = normalize(vec3(-g * slope, 1.0));

    // Snell through one thin interface, per channel (dispersion).
    float bend = uBendUV;
    vec3 iorOff = vec3(0.0, 0.014, 0.028) * uDisp;
    vec3 col;
    for (int c = 0; c < 3; c++) {
      float eta = 1.0 / (1.45 + iorOff[c]);
      vec3 refr = refract(vec3(0.0, 0.0, -1.0), n, eta);
      vec2 uv = clamp(uvBase + refr.xy * bend, 0.0, 1.0);
      // Edge frost: the wall reads the photograph through a blurred mip -
      // hard edges smear like liquid instead of tearing into shards.
      col[c] = texture(uTex, uv, rimBump * 4.0)[c];
    }

    // A breath of clarity: the glass slightly lifts the backdrop's floor.
    col = col * 0.96 + 0.012;

    // Smoked core (owner note 2026-08-01: label was hard to read over the
    // bright wall). A tinted ellipse in the glass center gives the type its
    // footing - luminance-aware like the rim: near-invisible over dark
    // ground, up to a third of the light absorbed over bright.
    vec2 q = p / vec2(max(b.x * 1.1, 0.2), 0.85);
    float smoke = exp(-dot(q, q));
    float ink = smoke * (0.03 + uSmokeMax * smoothstep(0.40, 0.85, lumB));
    col *= (1.0 - ink);

    // Schlick Fresnel rim, cream - the site's single light.
    float cosT = clamp(n.z, 0.0, 1.0);
    float F = 0.04 + 0.96 * pow(1.0 - cosT, 5.0);
    vec3 cream = vec3(0.957, 0.918, 0.871);
    col += cream * F * uRim * rimTemper;

    // Fixed key glint (upper rim) + pointer-tracked Gaussian specular.
    // (key glint retired 2026-08-01: it painted an inner arc - the Fresnel
    //  hair at the silhouette is the only edge light now)
    if (uSpec > 0.0) {
      vec2 pp = (vec2(uPointer.x, uPointer.y) - 0.5) * uAspect;
      float s2 = 0.030;
      float spec = exp(-dot(p - pp, p - pp) / s2) * (0.35 + 0.65 * rimBump);
      col += cream * spec * uSpec * uPointerAmt * 0.5;
    }

    // Owner ruling: the crown must read EVERYWHERE - strong over dark
    // ground (where the old additive vanished), restrained over bright.
    col += cream * uGrad * (1.0 - f.y) * (0.03 + 0.15 * (1.0 - lumB));

    fragColor = vec4(col * mask, mask);  // premultiplied
  }`;

  function makeProgram(gl: WebGL2RenderingContext) {
    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        throw new Error(gl.getShaderInfoLog(sh) || 'shader');
      }
      return sh;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error('link');
    return prog;
  }

  // THE LINE (owner-tuned on the console, 2026-08-01, locked verbatim):
  // uRidge=0.000 uSigma=0.054 uSlope=3.450 uRim=0.000 uSmokeMax=0.000 uGrad=0.950
  // One material now. The a/b/c props remain for markup compatibility; all
  // grades render the Line.
  const LINE = { disp: 1, rim: 0.0, spec: 1, breath: 1, grad: 0.95, bendPx: 22 };
  const VARIANTS: Record<string, typeof LINE> = { a: LINE, b: LINE, c: LINE };

  function initPill(pill: HTMLElement, img: HTMLImageElement | null) {
    const canvas = pill.querySelector('canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const gl = canvas.getContext('webgl2', { alpha: true, antialias: false, premultipliedAlpha: true });
    if (!gl) { canvas.remove(); return; }   // CSS glass carries the pill

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const v = VARIANTS[pill.dataset.variant || 'b'] || VARIANTS.b;

    let prog: WebGLProgram;
    try { prog = makeProgram(gl); } catch { canvas.remove(); return; }
    pill.classList.add('gpill-live');
    gl.useProgram(prog);
    const U = (n: string) => gl.getUniformLocation(prog, n);

    const tex = gl.createTexture();
    function upload() {
      gl!.bindTexture(gl!.TEXTURE_2D, tex);
      gl!.pixelStorei(gl!.UNPACK_FLIP_Y_WEBGL, false); // v=0 = image top; top-based uv throughout
      if (img) {
        gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGBA, gl!.RGBA, gl!.UNSIGNED_BYTE, img);
      } else {
        // No photograph behind this pill: the material stands on the site's
        // own onyx. Chrome edge, clear body, crown - the About-me-over-black
        // reading, anywhere on the site.
        gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGBA, 1, 1, 0, gl!.RGBA, gl!.UNSIGNED_BYTE, new Uint8Array([10, 11, 13, 255]));
      }
      gl!.generateMipmap(gl!.TEXTURE_2D); // rim frost samples blurred mips
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MIN_FILTER, gl!.LINEAR_MIPMAP_LINEAR);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_S, gl!.CLAMP_TO_EDGE);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE);
    }
    upload();
    // The home hero rotates its photograph by hour; when the img swaps, the
    // glass must bend the NEW light, not a stale texture.
    if (img) img.addEventListener('load', () => { upload(); layout(); frame(performance.now()); });

    let uvScaleAvg = 0;
    function layout() {
      const cr = canvas!.getBoundingClientRect();
      const ir = img ? img.getBoundingClientRect() : cr;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      // Full DPR (was 0.75x): two tiny canvases afford it, and a soft edge
      // reads as a WIDE wall - crispness is what makes the wall thin.
      canvas!.width = Math.max(2, Math.round(cr.width * dpr));
      canvas!.height = Math.max(2, Math.round(cr.height * dpr));
      gl!.viewport(0, 0, canvas!.width, canvas!.height);
      if (!img) {
        gl!.uniform2f(U('uUV0'), 0.5, 0.5);
        gl!.uniform2f(U('uUVScale'), 0.0, 0.0);
        gl!.uniform2f(U('uAspect'), cr.width / cr.height, 1.0);
        gl!.uniform1f(U('uBendUV'), 0.0);
        return;
      }
      // object-fit: cover geometry -> the uv window this canvas sees.
      const s = Math.max(ir.width / img.naturalWidth, ir.height / img.naturalHeight);
      const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
      const ox = (dw - ir.width) / 2, oy = (dh - ir.height) / 2;
      const u0 = (cr.left - ir.left + ox) / dw;
      const v0 = (cr.top - ir.top + oy) / dh;
      gl!.uniform2f(U('uUV0'), u0, v0);
      gl!.uniform2f(U('uUVScale'), cr.width / dw, cr.height / dh);
      gl!.uniform2f(U('uAspect'), cr.width / cr.height, 1.0);
      uvScaleAvg = (cr.width / dw + cr.height / dh) / 2;
      gl!.uniform1f(U('uBendUV'), (v.bendPx / ((cr.width + cr.height) / 2)) * uvScaleAvg * 60.0);
    }

    gl.uniform1f(U('uDisp'), v.disp);
    gl.uniform1f(U('uRim'), v.rim);
    gl.uniform1f(U('uSpec'), v.spec);
    gl.uniform1f(U('uBreath'), reduce ? 0 : v.breath);
    gl.uniform1f(U('uGrad'), v.grad);
    gl.uniform1f(U('uRidge'), 0.0);
    gl.uniform1f(U('uSigma'), 0.054);
    gl.uniform1f(U('uSlope'), 3.45);
    gl.uniform1f(U('uSmokeMax'), 0.18); // polish: engages only over bright ground
    gl.uniform1i(U('uTex'), 0);
    // Lab tuning registry: only pages that opt in with [data-glass-tune]
    // expose the knobs. The owner's eye drives; values get locked in code.
    if (document.querySelector('[data-glass-tune]')) {
      const w = window as any;
      w.__gtuneState = w.__gtuneState || {};
      const me = {
        set(name: string, val: number) { gl!.uniform1f(U(name), val); },
        draw() { frame(performance.now()); },
      };
      // Late pills (lazy benches below the fold) inherit the tuned state
      // the moment they register - the console governs all glass equally.
      Object.entries(w.__gtuneState as Record<string, number>).forEach(([k, v]) => me.set(k, v));
      (w.__gpills = w.__gpills || []).push(me);
      w.__glassTune = (name: string, val: number) => {
        w.__gtuneState[name] = val;
        (w.__gpills as any[]).forEach((g) => { g.set(name, val); g.draw(); });
      };
    }

    let px = 0.5, py = 0.5, amt = 0, amtTarget = 0;
    pill.addEventListener('pointermove', (ev) => {
      const cr = canvas.getBoundingClientRect();
      px = (ev.clientX - cr.left) / cr.width;
      py = (ev.clientY - cr.top) / cr.height;
      amtTarget = 1;
    });
    pill.addEventListener('pointerleave', () => { amtTarget = 0; });

    const t0 = performance.now();
    function frame(now: number) {
      amt += (amtTarget - amt) * 0.12;
      gl!.uniform2f(U('uPointer'), px, py);
      gl!.uniform1f(U('uPointerAmt'), amt);
      gl!.uniform1f(U('uTime'), (now - t0) / 1000);
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }

    layout();
    frame(t0);

    if (reduce) return; // one static frame; no clock, no pointer chase

    // RAF only while visible (O2: runtime is the authority; idle costs zero).
    let raf = 0;
    let running = false;
    const loop = (now: number) => { frame(now); raf = requestAnimationFrame(loop); };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting && !running) { running = true; raf = requestAnimationFrame(loop); }
        else if (!en.isIntersecting && running) { running = false; cancelAnimationFrame(raf); }
      });
    }, { threshold: 0.05 });
    io.observe(pill);
    window.addEventListener('resize', () => { layout(); }, { passive: true });
  }

  function initAll() {
    // Promotion tier gate (O2 law: runtime and capability decide, not hope).
    // Touch devices keep the CSS pill: the pointer specular has nothing to
    // anchor to, and the mobile GPU budget belongs to the photographs.
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const mem = (navigator as any).deviceMemory;
    if (!fine || (mem !== undefined && mem < 4)) return;
    document.querySelectorAll<HTMLElement>('[data-gpill]').forEach((pill) => {
      // The footer persists across ClientRouter swaps; its pill must not
      // re-initialize a second context on every navigation.
      if (pill.dataset.gpillInit) return;
      pill.dataset.gpillInit = '1';
      const bench = pill.closest('[data-glass-bench]');
      const img = bench?.querySelector('img') as HTMLImageElement | null;
      if (!img) { initPill(pill, null); return; }
      const go = () => initPill(pill, img);
      if (img.complete && img.naturalWidth > 0) go();
      else img.addEventListener('load', go, { once: true });
    });
  }
  document.addEventListener('astro:page-load', initAll);
</script>
