---
import { navItems } from '../utils/date';
---

<header class="py-4 sm:py-6 md:py-8" transition:persist>
  <div class="container-narrow">
    <nav class="flex items-center justify-between">
      <a href="/" class="text-xl font-serif tracking-tight hover:opacity-70 transition-opacity duration-300 text-gold min-h-[44px] flex items-center" transition:name="logo">
        JW
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm opacity-40 hover:opacity-100 transition-opacity duration-300 py-2"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu Button — 44px touch target -->
      <button
        id="menu-toggle"
        class="md:hidden w-11 h-11 flex items-center justify-center opacity-40 hover:opacity-100 transition-opacity duration-300 -mr-2"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>

    <!-- Mobile Navigation — slide-down with fade -->
    <div id="mobile-menu" class="mobile-menu-closed md:hidden overflow-hidden">
      <div class="pt-4 pb-2 border-t border-white/10 mt-4">
        <ul class="space-y-1">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-3 px-2 opacity-50 hover:opacity-100 active:opacity-100 transition-opacity duration-300 text-base min-h-[44px] flex items-center"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-menu-closed {
    max-height: 0;
    opacity: 0;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu-open {
    max-height: 300px;
    opacity: 1;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.05s;
  }
</style>

<script>
  function initMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    let isOpen = false;

    function setMenuState(open: boolean) {
      isOpen = open;
      if (open) {
        menu?.classList.remove('mobile-menu-closed');
        menu?.classList.add('mobile-menu-open');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
      } else {
        menu?.classList.remove('mobile-menu-open');
        menu?.classList.add('mobile-menu-closed');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
      toggle?.setAttribute('aria-expanded', String(open));
    }

    toggle?.addEventListener('click', () => setMenuState(!isOpen));

    // Close menu on navigation
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => setMenuState(false));
    });
  }
  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>
