---
import { navItems } from '../utils/date';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header id="site-header" class="py-4 sm:py-6 md:py-8 sticky top-0 z-40 transition-all duration-500" transition:persist>
  <div class="nav-shell">
    <nav class="flex items-center justify-between">
      <a href="/" class="text-xl font-serif tracking-tight hover:opacity-70 transition-opacity duration-300 text-cream min-h-[44px] flex items-center" transition:name="logo">
        JW
      </a>

      {/* Desktop navigation + Inquire CTA. On mobile the header is just the
          wordmark - navigation lives in the bottom tab bar (BaseLayout), in
          the thumb zone, so there is no hamburger menu. */}
      <div class="hidden md:flex items-center gap-8">
        <ul class="flex items-center gap-8">
          {navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  class={`text-sm transition-opacity duration-300 py-2 ${isActive ? 'opacity-100 text-navy-hour' : 'text-mute hover:opacity-100 hover:text-navy-hour'}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.name}
                </a>
              </li>
            );
          })}
        </ul>
        <a
          href="mailto:jndwcreative@gmail.com"
          class="inline-flex items-center gap-1.5 text-xs tracking-[0.15em] uppercase font-medium px-4 py-2 rounded-full border border-cream/25 text-cream hover:border-cream/50 hover:bg-cream/5 transition-all duration-300"
        >
          Inquire
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>

      {/* Mobile icon nav - lives in the header (top), beside JW which is home. No bottom bar (it collided with the browser chrome). */}
      <div class="flex md:hidden items-center gap-1.5">
        <a href="/photography" data-path="/photography" aria-label="Photography" class={`m-nav-item flex items-center justify-center min-h-[44px] min-w-[44px] rounded-full transition-colors duration-300 ${currentPath === '/photography' ? 'text-navy-hour' : 'text-mute'}`} aria-current={currentPath === '/photography' ? 'page' : undefined}>
          <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M4 8.6A1.6 1.6 0 0 1 5.6 7h1.9l1-1.5h7l1 1.5h1.9A1.6 1.6 0 0 1 20 8.6v8.8a1.6 1.6 0 0 1-1.6 1.6H5.6A1.6 1.6 0 0 1 4 17.4V8.6Z" /><circle cx="12" cy="13" r="3.3" stroke-width="1.4" /></svg>
        </a>
        <a href="/work" data-path="/work" aria-label="Work" class={`m-nav-item flex items-center justify-center min-h-[44px] min-w-[44px] rounded-full transition-colors duration-300 ${currentPath === '/work' ? 'text-navy-hour' : 'text-mute'}`} aria-current={currentPath === '/work' ? 'page' : undefined}>
          <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M9.7 19 14.3 5M16.8 8.5 20.5 12l-3.7 3.5M7.2 15.5 3.5 12l3.7-3.5" /></svg>
        </a>
        <a href="/about" data-path="/about" aria-label="About" class={`m-nav-item flex items-center justify-center min-h-[44px] min-w-[44px] rounded-full transition-colors duration-300 ${currentPath === '/about' ? 'text-navy-hour' : 'text-mute'}`} aria-current={currentPath === '/about' ? 'page' : undefined}>
          <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="8.4" r="3.7" stroke-width="1.4" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M5.6 19.8a6.4 6.4 0 0 1 12.8 0" /></svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Desktop nav active-state sync after View Transitions + the solid
  // "scrolled" shelf state. Mobile navigation is the bottom tab bar in
  // BaseLayout; the header carries no mobile menu.
  function updateActiveNav() {
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('header nav > div.hidden ul a').forEach(link => {
      const href = new URL(link.getAttribute('href') || '', window.location.origin).pathname.replace(/\/$/, '');
      const isActive = href === currentPath;
      link.className = `text-sm transition-opacity duration-300 py-2 ${isActive ? 'opacity-100 text-navy-hour' : 'text-mute hover:opacity-100 hover:text-navy-hour'}`;
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
    document.querySelectorAll('header .m-nav-item').forEach(link => {
      const href = link.getAttribute('data-path') || '';
      const isActive = href === currentPath;
      link.classList.toggle('text-navy-hour', isActive);
      link.classList.toggle('text-mute', !isActive);
      if (isActive) { link.setAttribute('aria-current', 'page'); } else { link.removeAttribute('aria-current'); }
    });
  }

  function initGlassHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (window.scrollY > 40) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    if (window.scrollY > 40) header.classList.add('scrolled');
  }

  updateActiveNav();
  initGlassHeader();
  document.addEventListener('astro:after-swap', () => {
    updateActiveNav();
    initGlassHeader();
  });
</script>
