---
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticPlate from '../components/KineticPlate.astro';
import KineticPlate3D from '../components/KineticPlate3D.astro';

// Unlinked, noindexed comparison lab. Side-by-side: the current 2.5D
// stacked-canvas plate vs the true-3D depth-mapped WebGL point cloud, for
// every featured photograph. Built for John's in-browser judgement on the
// preview deployment; not part of the production page set.
// P1 lock, 2026-07-19: this lab must never ship on the production branch.
// Cloudflare Pages sets CF_PAGES_BRANCH at build time; on main the route
// becomes a plain redirect home, so no "Private" copy exists in production
// HTML. Preview branches and local builds keep the full lab.
// Pages production (main, or missing branch) never emits the lab.
// Local and CI omit CF_PAGES, so tests still see the full bench.
if (process.env.CF_PAGES === '1' && (process.env.CF_PAGES_BRANCH || 'main') === 'main') {
  return Astro.redirect('/', 308);
}

const ROWS = [
  { id: 'earth', label: 'Earth · rain-wet leaf', note: 'A dark subject. Luminance buries it; depth stands it forward.' },
  { id: 'structure', label: 'Structure · Shanghai Tower', note: 'Shot against bright sky. Depth keeps the tower near, the sky far.' },
  { id: 'sky', label: 'Sky · thunderheads', note: 'The nearest billows read closest; the void recedes to black.' },
  { id: 'water', label: 'Water · El Arco', note: 'A distant scene. The arch holds its place in real space.' },
] as const;
---

<BaseLayout
  title="Kinetic Plate Lab"
  description="Private comparison lab."
  noindex={true}
>
  <section class="py-12 sm:py-16 md:py-20 overflow-hidden">
    <div class="container-narrow">
      <p class="eyebrow mb-3 sm:mb-4">Lab · Kinetic Plates</p>
      <h1 class="mb-5 sm:mb-7">True 3D, judged against the original</h1>
      <div class="prose max-w-2xl">
        <p>
          The same photographs, twice. On the left, today's plate: four flat
          canvases stacked to fake relief. On the right, the genuine article:
          a WebGL point cloud where every dot sits at the true depth the
          photograph holds, baked from a monocular depth model. No flat planes.
          Real geometry the silhouette honors as it turns.
        </p>
        <p class="text-sm opacity-60">
          On a trackpad or mouse, sweep across a plate to orbit it. Release
          mid-turn and it carries, then settles back to rest. On a phone, scroll
          and watch each cloud roll with the page. Reduced motion holds a still
          frame.
        </p>
      </div>
    </div>
  </section>

  <div class="lab-fade">
    <label class="lab-fade__label" for="fadeRange">Far-fade</label>
    <input id="fadeRange" class="lab-fade__range" type="range" min="0" max="1" step="0.05" value="0.3" aria-label="Far-fade amount" />
    <output id="fadeVal" class="lab-fade__val">0.30</output>
  </div>

  {ROWS.map((row, i) => (
    <section class={`py-10 sm:py-14 md:py-16 ${i % 2 === 1 ? 'section-light' : ''}`}>
      <div class="container-wide">
        <p class="eyebrow mb-2">{row.label}</p>
        <p class="text-sm opacity-55 mb-8 max-w-xl">{row.note}</p>
        <div class="grid gap-10 md:grid-cols-2 md:gap-12 items-start">
          <div>
            <KineticPlate category={row.id} />
            <p class="plate-tag">2.5D · stacked canvases <span>current</span></p>
          </div>
          <div>
            <KineticPlate3D category={row.id} />
            <p class="plate-tag">True 3D · depth-mapped cloud <span>new</span></p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="py-12 sm:py-16">
    <div class="container-narrow">
      <p class="text-xs tracking-[0.3em] uppercase opacity-40">
        Private preview. Not linked, not indexed.
      </p>
    </div>
  </section>
  <script>
    // Live far-fade tuning: drives every mounted 3D plate via the renderer's
    // global setter, so John can dial subject-isolation to taste and we bake
    // the chosen value into the manifest (render.depthFade).
    const range = document.getElementById('fadeRange') as HTMLInputElement | null;
    const out = document.getElementById('fadeVal');
    const apply = (v: number) => {
      if (out) out.textContent = v.toFixed(2);
      (window as any).kineticSetFade?.(v);
    };
    range?.addEventListener('input', () => apply(Number(range.value)));
    // plates mount asynchronously (they fetch geometry); apply once they're up
    setTimeout(() => apply(range ? Number(range.value) : 0.3), 700);
  </script>
</BaseLayout>

<style>
  .plate-tag {
    margin-top: 1rem;
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(244, 234, 222, 0.62);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .plate-tag span {
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    padding: 0.18rem 0.5rem;
    border: 1px solid rgba(244, 234, 222, 0.27); /* blue-hour hairline */
    border-radius: 999px;
    color: #F4EADE;
  }
  .lab-fade {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: rgba(20, 20, 22, 0.55);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid rgba(244, 234, 222, 0.168);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }
  .lab-fade__label {
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(244, 234, 222, 0.7);
  }
  .lab-fade__range { width: 140px; accent-color: #F4EADE; }
  .lab-fade__val {
    font-variant-numeric: tabular-nums;
    font-size: 0.7rem;
    color: #F4EADE;
    min-width: 2.4ch;
    text-align: right;
  }
</style>
