---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidPlate from '../components/LiquidPlate.astro';

const projects = [
  {
    title: 'Queue Forecast Dashboard',
    description: 'Forecasting tool for enterprise support operations. Holt-Winters exponential smoothing predicts queue demand across time windows. Sanitized and open-sourced with proportions-only output to respect operational security.',
    tags: ['Python', 'Forecasting', 'Holt-Winters', 'Operations'],
    outcome: 'Used in production for workforce planning',
    github: 'https://github.com/thejohndwilliams/queue-forecast-dashboard',
    image: 'gv-1fd48bd9'
  },
  {
    title: 'Job Application Analytics',
    description: 'Analysis of 580+ job applications over two years. Predictive models for rejection patterns, anomaly detection on response rates, isolation of which variables actually move hiring outcomes. Python, full statistical methodology.',
    tags: ['Python', 'Machine Learning', 'Data Analysis', 'Statistics'],
    outcome: 'Identified actionable patterns across 580+ applications',
    github: 'https://github.com/thejohndwilliams/jobappanalysis',
    image: 'dscf1059'
  },
  {
    title: 'Government Cybersecurity Assessment',
    description: 'NIST-framework risk assessment for government sector organizations. Threat analysis, control mapping, and remediation planning against NIST CSF and 800-53 Rev 5.',
    tags: ['NIST CSF', 'NIST 800-53', 'Risk Assessment', 'Cybersecurity'],
    outcome: 'Full threat model with prioritized remediation roadmap',
    github: 'https://github.com/thejohndwilliams/Government-Sector-Cybersecurity-Assessment',
    image: 'dsc-0329'
  },
  {
    title: 'Healthcare Security Strategy',
    description: 'MBA capstone at Baylor. Security framework for a healthcare organization: NIST CSF and 800-53 Rev 5 controls, risk assessment methodology, compliance mapping, implementation roadmap.',
    tags: ['NIST CSF', 'NIST 800-53', 'Capstone', 'Compliance'],
    outcome: 'Baylor University MBA Cybersecurity Capstone',
    github: 'https://github.com/thejohndwilliams/Healthcare-Security-Strategy-ZetaAlpha',
    image: 'dscf0423'
  }
];

const expertise = [
  'Data Engineering', 'Cybersecurity', 'Incident Command', 'Python',
  'Power BI', 'SQL', 'Operations Analytics', 'Forecasting', 'Photography'
];
---

<BaseLayout
  title="Work"
  description="Selected projects by John D. Williams: data engineering, cybersecurity, and operations. Plus Beyond Photography, an experiment turning his photographs into palettes, wallpapers, and textures."
  ogImage="/images/photography/hero/dscf0331.webp"
  lcpImage="dscf0331"
>
  <!-- HERO -->
  <section class="relative min-h-[65vh] sm:min-h-[75vh] md:min-h-[80vh] flex items-end overflow-hidden">
    <img
      src="/images/photography/gallery/dscf0331.webp"
      srcset="/images/photography/thumb/dscf0331.webp 400w, /images/photography/gallery/dscf0331.webp 1200w, /images/photography/hero/dscf0331.webp 2400w"
      sizes="100vw"
      alt="Lanterns glowing along a shrine at night, a car passing below"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0" style="background-image: linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.78) 22%, rgba(10,10,10,0.56) 44%, rgba(10,10,10,0.28) 68%, rgba(10,10,10,0) 100%);"></div>
    <div class="hero-lockup relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-12 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">Building</p>
        <h1 class="mb-5 sm:mb-8">Selected Work</h1>
      </div>
    </div>
  </section>

  <!-- ACT I - THE WORK · image-backed bento -->
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="reveal max-w-2xl mb-8 sm:mb-12">
        <p class="text-[11px] tracking-[0.18em] uppercase text-stone-light opacity-80 mb-2">The work I can show</p>
        <p class="text-sm sm:text-base opacity-55">
          Data, security, and operations, sanitized for the public web. The
          discipline, not the details.
        </p>
      </div>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-3 sm:gap-4 md:gap-5">
        {projects.map((project, i) => {
          const isWide = i === 0 || i === 3;
          const span = isWide ? 'col-span-2 md:col-span-7' : 'col-span-1 md:col-span-5';
          return (
            <div class={`glass-luminous group relative rounded-card overflow-hidden ring-1 ring-white/5 hover:ring-navy-hour/30 transition-all duration-500 min-h-[280px] sm:min-h-[340px] flex ${span}`}>
              <picture>
                <source type="image/avif" srcset={`/images/photography/thumb/${project.image}.avif 400w, /images/photography/gallery/${project.image}.avif 1200w`} sizes={isWide ? '(max-width: 767px) 100vw, 58vw' : '(max-width: 767px) 50vw, 42vw'} />
                <source type="image/webp" srcset={`/images/photography/thumb/${project.image}.webp 400w, /images/photography/gallery/${project.image}.webp 1200w`} sizes={isWide ? '(max-width: 767px) 100vw, 58vw' : '(max-width: 767px) 50vw, 42vw'} />
                <img src={`/images/photography/gallery/${project.image}.webp`} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" decoding="async" />
              </picture>
              <div class="absolute inset-0" style="background-image: linear-gradient(to top, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.84) 36%, rgba(10,10,10,0.52) 70%, rgba(10,10,10,0.22) 100%);"></div>
              <div class="relative z-10 w-full flex flex-col justify-end p-4 sm:p-6 md:p-7">
                <h2 class="t-sub font-serif mb-2 text-cream">{project.title}</h2>
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {project.tags.slice(0, 3).map((tag: string) => (
                    <span class="glass-tag text-[10px] sm:text-xs px-2 sm:px-3 py-1 rounded-md sm:rounded-lg opacity-80">{tag}</span>
                  ))}
                </div>
                <p class={`text-sm opacity-70 mb-3 sm:mb-4 leading-relaxed ${isWide ? '' : 'hidden sm:block'}`}>{project.description}</p>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mt-auto">
                  <p class="text-xs sm:text-sm text-stone-light">{project.outcome}</p>
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm opacity-70 hover:opacity-100 hover:text-navy-hour transition-all duration-300 min-h-[44px] flex items-center">
                      View on GitHub →
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="reveal mt-8 sm:mt-12">
        <div class="flex flex-wrap gap-2">
          {expertise.map((skill) => (
            <span class="glass-tag px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm opacity-60 rounded-md sm:rounded-lg">{skill}</span>
          ))}
        </div>
      </div>
      <div class="reveal mt-10 sm:mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
        <p class="text-sm sm:text-base opacity-55 flex-1">
          Have a project in mind? I take on consulting in data engineering,
          cybersecurity, and operational analytics.
        </p>
        <a href="mailto:jndwcreative@gmail.com" class="btn btn-primary shrink-0 w-full sm:w-auto justify-center">
          Inquire
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- DIVIDER -->
  <section class="relative h-[42vh] sm:h-[52vh] overflow-hidden">
    <img
      src="/images/photography/gallery/dsc-0014.webp"
      srcset="/images/photography/thumb/dsc-0014.webp 400w, /images/photography/gallery/dsc-0014.webp 1200w, /images/photography/hero/dsc-0014.webp 2400w"
      sizes="100vw"
      alt="A ram skull, stark against shadow"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background-image: linear-gradient(to bottom, rgba(10,10,10,0.55) 0%, rgba(10,10,10,0.15) 40%, rgba(10,10,10,0.55) 100%);"></div>
    <div class="absolute inset-0 flex items-end justify-center pb-8 sm:pb-12">
      <p class="text-[11px] sm:text-xs tracking-[0.3em] uppercase text-cream/85" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">Here am I. Send me.</p>
    </div>
  </section>

  <!-- ACT II - BEYOND PHOTOGRAPHY -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container-narrow mb-10 sm:mb-16">
      <h2 class="t-sub font-serif mb-3 sm:mb-4">Beyond Photography</h2>
      <p class="font-serif text-lg sm:text-xl text-cream/90 mb-3 max-w-xl">Lift each experience from its frame.</p>
      <p class="text-sm sm:text-base opacity-55 max-w-xl">
        Download custom wallpapers, textures, and color palettes from any frame below, free to take.
        <a href="mailto:jndwcreative@gmail.com?subject=Beyond%20Photography" class="text-cream/80 underline underline-offset-4 hover:text-navy-hour transition-colors duration-300">Inquire</a>
        for prints, licensing, or the full-resolution files.
      </p>
    </div>
    <div class="container-wide space-y-16 sm:space-y-24 md:space-y-28">
      <div class="reveal"><LiquidPlate src="img-6552" alt="Last light over a ridge at dusk" label="Sky" note="Last light, going down behind the ridge." index={0} /></div>
      <div class="reveal"><LiquidPlate src="7r51018-enhanced-sr" alt="Rain beaded across a dark green leaf" label="Earth" note="Rain on a leaf. The surface, up close." index={1} reverse /></div>
      <div class="reveal"><LiquidPlate src="dscf1022" alt="A wall combed into vertical ribs of light and shadow" label="Stone" note="A wall, raked into ribs of light." index={2} /></div>
    </div>
  </section>
</BaseLayout>
