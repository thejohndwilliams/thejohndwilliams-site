---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidPlate from '../components/LiquidPlate.astro';

const projects = [
  {
    title: 'Queue Forecast Dashboard',
    description: 'Forecasting tool for enterprise support operations. Holt-Winters exponential smoothing predicts queue demand across time windows. Sanitized and open-sourced with proportions-only output to respect operational security.',
    tags: ['Python', 'Forecasting', 'Holt-Winters', 'Operations'],
    outcome: 'Used in production for workforce planning',
    github: 'https://github.com/thejohndwilliams/queue-forecast-dashboard'
  },
  {
    title: 'Job Application Analytics',
    description: 'Analysis of 580+ job applications over two years. Predictive models for rejection patterns, anomaly detection on response rates, isolation of which variables actually move hiring outcomes. Python, full statistical methodology.',
    tags: ['Python', 'Machine Learning', 'Data Analysis', 'Statistics'],
    outcome: 'Identified actionable patterns across 580+ applications',
    github: 'https://github.com/thejohndwilliams/jobappanalysis'
  },
  {
    title: 'Government Cybersecurity Assessment',
    description: 'NIST-framework risk assessment for government sector organizations. Threat analysis, control mapping, and remediation planning against NIST CSF and 800-53 Rev 5.',
    tags: ['NIST CSF', 'NIST 800-53', 'Risk Assessment', 'Cybersecurity'],
    outcome: 'Full threat model with prioritized remediation roadmap',
    github: 'https://github.com/thejohndwilliams/Government-Sector-Cybersecurity-Assessment'
  },
  {
    title: 'Healthcare Security Strategy',
    description: 'MBA capstone at Baylor. Security framework for a healthcare organization: NIST CSF and 800-53 Rev 5 controls, risk assessment methodology, compliance mapping, implementation roadmap.',
    tags: ['NIST CSF', 'NIST 800-53', 'Capstone', 'Compliance'],
    outcome: 'Baylor University MBA Cybersecurity Capstone',
    github: 'https://github.com/thejohndwilliams/Healthcare-Security-Strategy-ZetaAlpha'
  }
];

const expertise = [
  'Data Engineering', 'Cybersecurity', 'Incident Command', 'Python',
  'Power BI', 'SQL', 'Operations Analytics', 'Forecasting', 'Photography'
];
---

<BaseLayout
  title="Work"
  description="Selected projects by John D. Williams — data engineering, cybersecurity, and operations — and Beyond Photography, an experiment turning his photographs into palettes, wallpapers, and textures."
  ogImage="/images/photography/hero/img-7576-enhanced.webp"
  lcpImage="img-7576-enhanced"
>
  <!-- HERO -->
  <section class="relative py-10 sm:py-16 md:py-24 overflow-hidden">
    <img
      src="/images/photography/gallery/img-7576-enhanced.webp"
      srcset="/images/photography/thumb/img-7576-enhanced.webp 400w, /images/photography/gallery/img-7576-enhanced.webp 1200w, /images/photography/hero/img-7576-enhanced.webp 2400w"
      sizes="100vw"
      alt="Architectural study in glass and steel"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0" style="background-image: linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.78) 22%, rgba(10,10,10,0.56) 44%, rgba(10,10,10,0.28) 68%, rgba(10,10,10,0) 100%);"></div>
    <div class="relative z-10 container-narrow">
      <div class="reveal max-w-2xl mb-10 sm:mb-16">
        <p class="eyebrow mb-3 sm:mb-4">Building</p>
        <h1 class="mb-5 sm:mb-8">Selected Work</h1>
      </div>
    </div>
  </section>

  <!-- ACT I — THE WORK (professional) -->
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal max-w-2xl mb-8 sm:mb-12">
        <p class="text-[11px] tracking-[0.18em] uppercase text-stone-light opacity-80 mb-2">The work I can show</p>
        <p class="text-sm sm:text-base opacity-55">
          Data, security, and operations — sanitized for the public web. The
          discipline, not the details.
        </p>
      </div>
      <div class="stagger-children grid sm:grid-cols-2 gap-4 sm:gap-6">
        {projects.map((project) => (
          <div class="glass-card p-5 sm:p-7 md:p-8 flex flex-col">
            <h2 class="t-sub font-serif mb-3">{project.title}</h2>
            <p class="text-sm opacity-55 mb-4 sm:mb-5 leading-relaxed flex-1">{project.description}</p>
            <div class="flex flex-wrap gap-1.5 mb-4 sm:mb-5">
              {project.tags.map((tag: string) => (
                <span class="glass-tag text-[10px] sm:text-xs px-2 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg opacity-70">{tag}</span>
              ))}
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-0 mt-auto">
              <p class="text-xs sm:text-sm text-stone-light">{project.outcome}</p>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm opacity-60 hover:opacity-80 hover:text-navy-hour transition-all duration-300 min-h-[44px] flex items-center">
                  View on GitHub →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="reveal mt-8 sm:mt-12">
        <div class="flex flex-wrap gap-2">
          {expertise.map((skill) => (
            <span class="glass-tag px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm opacity-60 rounded-md sm:rounded-lg">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- DIVIDER — the turn from professional to personal -->
  <section class="relative h-[42vh] sm:h-[52vh] overflow-hidden">
    <img
      src="/images/photography/gallery/dsc-0014.webp"
      srcset="/images/photography/thumb/dsc-0014.webp 400w, /images/photography/gallery/dsc-0014.webp 1200w, /images/photography/hero/dsc-0014.webp 2400w"
      sizes="100vw"
      alt="A ram skull, stark against shadow"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background-image: linear-gradient(to bottom, rgba(10,10,10,0.55) 0%, rgba(10,10,10,0.15) 40%, rgba(10,10,10,0.55) 100%);"></div>
    <div class="absolute inset-0 flex items-end justify-center pb-8 sm:pb-12">
      <p class="text-[11px] sm:text-xs tracking-[0.3em] uppercase text-cream/85" style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);">and the work I make for its own sake</p>
    </div>
  </section>

  <!-- ACT II — BEYOND PHOTOGRAPHY (creative / maker) -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container-narrow mb-10 sm:mb-16">
      <p class="text-[11px] tracking-[0.18em] uppercase text-stone-light opacity-80 mb-2">Building now</p>
      <h2 class="t-sub font-serif mb-4">Beyond Photography</h2>
      <p class="text-sm sm:text-base opacity-55 max-w-xl">
        Ever wanted to lift a color straight out of a photograph — or your phone
        wearing one? Each frame gives back its palette, its wallpaper, and its
        texture. Take what you like.
      </p>
    </div>
    <div class="container-wide space-y-16 sm:space-y-24 md:space-y-28">
      <div class="reveal"><LiquidPlate src="img-6552" alt="A single cumulus cloud against deep blue" label="Sky" note="A single cloud, held against the dark." index={0} /></div>
      <div class="reveal"><LiquidPlate src="7r51018-enhanced-sr" alt="Rain beaded across a dark green leaf" label="Earth" note="Rain on a leaf — the surface, up close." index={1} reverse /></div>
      <div class="reveal"><LiquidPlate src="dscf1022" alt="Long-exposure water turned to silk" label="Water" note="Water, slowed until it turns to silk." index={2} /></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal glass-card p-6 sm:p-8 md:p-10 max-w-lg">
        <h2 class="t-sub font-serif mb-3 sm:mb-4">Have a project in mind?</h2>
        <p class="text-sm sm:text-base opacity-50 mb-6 sm:mb-8">
          I take on consulting work in data engineering, cybersecurity, and
          operational analytics.
        </p>
        <a href="mailto:jndwcreative@gmail.com" class="btn btn-primary w-full sm:w-auto">
          Inquire
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
