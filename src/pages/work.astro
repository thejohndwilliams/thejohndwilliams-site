---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidPlate from '../components/LiquidPlate.astro';

const projects = [
  {
    title: 'Queue Forecast Dashboard',
    description: 'Forecasting tool for enterprise support operations. Holt-Winters exponential smoothing predicts queue demand across time windows. Sanitized and open-sourced with proportions-only output to respect operational security.',
    tags: ['Python', 'Forecasting', 'Holt-Winters', 'Operations'],
    outcome: 'Used in production for workforce planning',
    github: 'https://github.com/thejohndwilliams/queue-forecast-dashboard'
  },
  {
    title: 'Job Application Analytics',
    description: 'Analysis of 580+ job applications over two years. Predictive models for rejection patterns, anomaly detection on response rates, isolation of which variables actually move hiring outcomes. Python, full statistical methodology.',
    tags: ['Python', 'Machine Learning', 'Data Analysis', 'Statistics'],
    outcome: 'Identified actionable patterns across 580+ applications',
    github: 'https://github.com/thejohndwilliams/jobappanalysis'
  },
  {
    title: 'Government Cybersecurity Assessment',
    description: 'NIST-framework risk assessment for government sector organizations. Threat analysis, control mapping, and remediation planning against NIST CSF and 800-53 Rev 5.',
    tags: ['NIST CSF', 'NIST 800-53', 'Risk Assessment', 'Cybersecurity'],
    outcome: 'Full threat model with prioritized remediation roadmap',
    github: 'https://github.com/thejohndwilliams/Government-Sector-Cybersecurity-Assessment'
  },
  {
    title: 'Healthcare Security Strategy',
    description: 'MBA capstone at Baylor. Security framework for a healthcare organization: NIST CSF and 800-53 Rev 5 controls, risk assessment methodology, compliance mapping, implementation roadmap.',
    tags: ['NIST CSF', 'NIST 800-53', 'Capstone', 'Compliance'],
    outcome: 'Baylor University MBA Cybersecurity Capstone',
    github: 'https://github.com/thejohndwilliams/Healthcare-Security-Strategy-ZetaAlpha'
  }
];

const expertise = [
  'Data Engineering',
  'Cybersecurity',
  'Incident Command',
  'Python',
  'Power BI',
  'SQL',
  'Operations Analytics',
  'Forecasting',
  'Photography'
];
---

<BaseLayout
  title="Work"
  description="Selected projects by John D. Williams — data engineering, cybersecurity, and operations."
  ogImage="/images/photography/hero/img-7576-enhanced.webp"
  lcpImage="img-7576-enhanced"
>
  <!-- HERO — with architectural accent -->
  <section class="relative py-10 sm:py-16 md:py-24 overflow-hidden">
    <img
      src="/images/photography/gallery/img-7576-enhanced.webp"
      srcset="/images/photography/thumb/img-7576-enhanced.webp 400w, /images/photography/gallery/img-7576-enhanced.webp 1200w, /images/photography/hero/img-7576-enhanced.webp 2400w"
      sizes="100vw"
      alt="Architectural study in glass and steel"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.78) 22%, rgba(10,10,10,0.56) 44%, rgba(10,10,10,0.28) 68%, rgba(10,10,10,0) 100%);"
    ></div>
    <div class="relative z-10 container-narrow">
      <div class="reveal max-w-2xl mb-10 sm:mb-16">
        <p class="eyebrow mb-3 sm:mb-4">Building</p>
        <h1 class="mb-5 sm:mb-8">Selected Work</h1>
      </div>
    </div>
  </section>

  <!-- Visual accent — horizontal image strip between hero and projects -->
  <section class="py-0 -mt-4 sm:-mt-8 relative z-10">
    <div class="container-wide">
      <div class="reveal grid grid-cols-3 gap-1.5 sm:gap-2">
        <div class="glass-luminous rounded-lg overflow-hidden aspect-[16/9]">
          <img
            src="/images/photography/gallery/7r50993-enhanced-sr.webp"
            srcset="/images/photography/thumb/7r50993-enhanced-sr.webp 400w, /images/photography/gallery/7r50993-enhanced-sr.webp 1200w"
            sizes="33vw"
            alt="Blue hour over harbor"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="glass-luminous rounded-lg overflow-hidden aspect-[16/9]">
          <img
            src="/images/photography/gallery/img-7598-enhanced-sr.webp"
            srcset="/images/photography/thumb/img-7598-enhanced-sr.webp 400w, /images/photography/gallery/img-7598-enhanced-sr.webp 1200w"
            sizes="33vw"
            alt="Chinese pagoda at night"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="glass-luminous rounded-lg overflow-hidden aspect-[16/9]">
          <img
            src="/images/photography/gallery/dscf0261.webp"
            srcset="/images/photography/thumb/dscf0261.webp 400w, /images/photography/gallery/dscf0261.webp 1200w"
            sizes="33vw"
            alt="Urban night architecture"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- BEYOND PHOTOGRAPHY — liquid plates (building now) -->
  <section class="py-10 sm:py-16 md:py-20">
    <div class="container-narrow">
      <div class="reveal mb-6 sm:mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-6">
        <div>
          <p class="text-[11px] tracking-[0.18em] uppercase text-stone-light opacity-80 mb-2">Building now</p>
          <h2 class="t-sub font-serif">Beyond Photography</h2>
        </div>
        <p class="text-xs sm:text-sm opacity-55 max-w-md">
          Ever wanted to lift a color straight out of a photograph? Pick a frame —
          here you go: its palette as hex or CSS now, its wallpaper soon.
        </p>
      </div>
      <div class="stagger-children grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-3">
        <LiquidPlate src="7r52326" alt="Cumulus cloud against a deep blue sky" label="Sky" index={0} />
        <LiquidPlate src="7r51108-enhanced-sr" alt="Sunlight through a green canopy" label="Earth" index={1} />
        <LiquidPlate src="7r50993-enhanced-sr" alt="Blue hour over the harbor" label="Water" index={2} />
      </div>
      <div class="reveal mt-3 sm:mt-4 flex flex-wrap gap-1.5 sm:gap-2">
        <span class="glass-tag text-[10px] sm:text-xs px-2 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg opacity-70">Wallpaper — soon</span>
        <span class="glass-tag text-[10px] sm:text-xs px-2 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg opacity-70">Texture — soon</span>
        <span class="glass-tag text-[10px] sm:text-xs px-2 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg opacity-70">SVG refraction</span>
      </div>
    </div>
  </section>

  <!-- PROJECTS — alternating section -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="stagger-children space-y-4 sm:space-y-6 mb-10 sm:mb-16">
        {projects.map((project) => (
          <div class="glass-card p-5 sm:p-8 md:p-10">
            <h2 class="t-sub font-serif mb-3 sm:mb-4">{project.title}</h2>
            <p class="text-sm sm:text-base opacity-55 mb-4 sm:mb-6 leading-relaxed">{project.description}</p>
            <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-4 sm:mb-6">
              {project.tags.map((tag: string) => (
                <span class="glass-tag text-[10px] sm:text-xs px-2 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg opacity-70">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-0">
              <p class="text-xs sm:text-sm text-stone-light">{project.outcome}</p>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm opacity-60 hover:opacity-80 hover:text-navy-hour transition-all duration-300 min-h-[44px] flex items-center">
                  View on GitHub →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPERTISE -->
  <section class="py-10 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal">
        <h2 class="text-subhead mb-5 sm:mb-8">Expertise</h2>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          {expertise.map((skill) => (
            <span class="glass-tag px-3 py-1.5 sm:px-5 sm:py-2.5 text-xs sm:text-sm opacity-60 rounded-md sm:rounded-lg">
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Visual break — cinematic landscape -->
  <section class="py-0">
    <div class="container-wide">
      <div class="reveal relative rounded-lg sm:rounded-card overflow-hidden aspect-[21/9] sm:aspect-[3/1]">
        <img
          src="/images/photography/gallery/7r52314.webp"
          srcset="/images/photography/thumb/7r52314.webp 400w, /images/photography/gallery/7r52314.webp 1200w, /images/photography/hero/7r52314.webp 2400w"
          sizes="100vw"
          alt="Backlit dramatic cloudscape"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#111111]/60 to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- CTA — alternating -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal glass-card p-6 sm:p-8 md:p-10 max-w-lg">
        <h2 class="t-sub font-serif mb-3 sm:mb-4">Have a project in mind?</h2>
        <p class="text-sm sm:text-base opacity-50 mb-6 sm:mb-8">
          I take on consulting work in data engineering,
          cybersecurity, and operational analytics.
        </p>
        <a href="mailto:jndwcreative@gmail.com" class="btn btn-primary w-full sm:w-auto">
          Inquire
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
