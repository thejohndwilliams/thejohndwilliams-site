---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bleedSizes, heroCapClass, photoSrcset, PROJECT_NARROW_SIZES, PROJECT_WIDE_SIZES } from '../utils/photo-src';


type ProjectCard = {
  title: string;
  description: string;
  tags: string[];
  outcome?: string;
  github?: string;
  page?: string;
  image: string;
  alt: string;
  wideRow?: boolean;
};

const projects: ProjectCard[] = [
  {
    title: 'Queue Forecast Dashboard',
    description: 'Forecasting tool for enterprise support operations. Holt-Winters exponential smoothing predicts queue demand across time windows. Sanitized and open-sourced with proportions-only output to respect operational security.',
    tags: ['Python', 'Forecasting', 'Holt-Winters', 'Operations'],
    outcome: 'Used in production for workforce planning',
    github: 'https://github.com/thejohndwilliams/queue-forecast-dashboard',
    image: 'gv-1fd48bd9',
    alt: 'Glass tower rising into the night'
  },
  {
    title: 'Job Application Analytics',
    description: 'Analysis of 580+ job applications over two years. Predictive models for rejection patterns, anomaly detection on response rates, isolation of which variables actually move hiring outcomes. Python, full statistical methodology.',
    tags: ['Python', 'Machine Learning', 'Data Analysis', 'Statistics'],
    outcome: 'Identified actionable patterns across 580+ applications',
    github: 'https://github.com/thejohndwilliams/jobappanalysis',
    image: 'dscf1059',
    alt: 'A spire against a bruised twilight'
  },
  {
    title: 'Government Cybersecurity Assessment',
    description: 'NIST-framework risk assessment for government sector organizations. Threat analysis, control mapping, and remediation planning against NIST CSF and 800-53 Rev 5.',
    tags: ['NIST CSF', 'NIST 800-53', 'Risk Assessment', 'Cybersecurity'],
    outcome: 'Full threat model with prioritized remediation roadmap',
    github: 'https://github.com/thejohndwilliams/Government-Sector-Cybersecurity-Assessment',
    image: 'dsc-0329',
    alt: 'Light through a derelict hall'
  },
  {
    title: 'Healthcare Security Strategy',
    description: 'MBA capstone at Baylor. Security framework for a healthcare organization: NIST CSF and 800-53 Rev 5 controls, risk assessment methodology, compliance mapping, implementation roadmap.',
    tags: ['NIST CSF', 'NIST 800-53', 'Capstone', 'Compliance'],
    outcome: 'Baylor University MBA Cybersecurity Capstone',
    github: 'https://github.com/thejohndwilliams/Healthcare-Security-Strategy-ZetaAlpha',
    image: 'dscf0423',
    alt: 'Japanese alleyway at night'
  },
  {
    title: 'Human Oversight for a Multi-Agent System: Approval Gates, Evidence and Separation of Duties',
    description: 'This page describes a design and its rules.',
    tags: ['Approval gates', 'Evidence', 'Duties'],
    page: '/work/agent-governance/',
    image: 'img-7395-enhanced-sr',
    alt: 'Temple gate against blue sky',
    wideRow: true
  }
];

const expertise = [
  'Data Engineering', 'Cybersecurity', 'Process Controls', 'Python',
  'Power BI', 'SQL', 'Operations Analytics', 'Photography'
];
---

<BaseLayout
  title="Work"
  description="Data, cybersecurity and operations projects by John D. Williams, with writings and research to come."
  ogImage="/og/pages/work.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  lcpImage="dscf0331"
  lcpImageSizes="100vw"
>
  <!-- HERO. Full-bleed lockup. dscf0331 is a 1349px portrait; the position
       class keeps the lanterns and the car in the wide crop. -->
  <section class="relative min-h-[65vh] sm:min-h-[75vh] md:min-h-[80vh] flex items-end overflow-hidden" data-glass-bench>
    <picture>
      <source type="image/avif" srcset={photoSrcset('dscf0331', 'avif')} sizes="100vw" />
      <source type="image/webp" srcset={photoSrcset('dscf0331', 'webp')} sizes="100vw" />
      <img
        src="/images/photography/hero/dscf0331.webp"
        alt="Lanterns glowing along a shrine at night, a car passing below"
        class="hero-pos-lanterns absolute inset-0 h-full w-full object-cover"
        data-bleed-short
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero-scrim-left absolute inset-0"></div>
    <div class="hero-lockup relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-12 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">Building</p>
        <h1 class="t-title mb-4 sm:mb-5 font-serif tracking-tight">Selected Work</h1>
        <p class="text-base leading-relaxed max-w-xl">
          Consulting in data engineering, cybersecurity, and operational
          analytics.
        </p>
      </div>
    </div>
  </section>

  <!-- ACT I - THE WORK · image-backed bento -->
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="reveal max-w-2xl mb-8 sm:mb-12">
        <p class="text-sm tracking-[0.18em] uppercase text-stone-light mb-2">Selected work</p>
        <p class="text-base text-mute">
          Data, security, and operations. The discipline, not the details.
        </p>
      </div>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-3 sm:gap-4 md:gap-5">
        {projects.map((project, i) => {
          const isWide = i === 0 || i === 3;
          const span = project.wideRow
            ? 'col-span-2 md:col-span-12'
            : isWide
              ? 'col-span-2 md:col-span-7'
              : 'col-span-1 md:col-span-5';
          const sizes = project.wideRow
            ? '(max-width: 767px) 100vw, 72rem'
            : isWide
              ? PROJECT_WIDE_SIZES
              : PROJECT_NARROW_SIZES;
          const showCopy = isWide || project.wideRow;
          return (
            <div class={`glass-luminous group relative rounded-card overflow-hidden ring-1 ring-white/5 hover:ring-cream/20 focus-within:ring-cream/20 transition-[box-shadow] duration-500 ease-smooth min-h-[280px] sm:min-h-[340px] flex ${span}`}>
              <picture>
                <source type="image/avif" srcset={photoSrcset(project.image, 'avif')} sizes={sizes} />
                <source type="image/webp" srcset={photoSrcset(project.image, 'webp')} sizes={sizes} />
                <img src={`/images/photography/hero/${project.image}.webp`} alt={project.alt} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 group-focus-within:scale-105" loading="lazy" decoding="async" />
              </picture>
              <div class="overlay-scrim-work absolute inset-0"></div>
              <div class="relative z-10 w-full flex flex-col justify-end p-4 sm:p-6 md:p-7">
                <h2 class="t-sub font-serif mb-2 text-cream">{project.title}</h2>
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {project.tags.slice(0, 3).map((tag: string) => (
                    <span class="glass-tag text-sm px-2 sm:px-3 py-1 rounded-md sm:rounded-lg text-cream/90">{tag}</span>
                  ))}
                </div>
                <p class={`text-base mb-3 sm:mb-4 leading-relaxed ${showCopy ? '' : 'hidden sm:block'}`}>{project.description}</p>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mt-auto">
                  {project.outcome && <p class="text-base text-stone-light">{project.outcome}</p>}
                  {(project.page || project.github) && (
                    <a
                      href={project.page || project.github}
                      target={project.page ? undefined : '_blank'}
                      rel={project.page ? undefined : 'noopener noreferrer'}
                      aria-label={project.page ? `View ${project.title}` : undefined}
                      class="text-sm text-cream/80 hover:text-cream transition-[color,outline,outline-offset] duration-300 ease-smooth min-h-[44px] min-w-[44px] flex items-center"
                    >
                      {project.page ? 'View' : 'View on GitHub →'}
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="reveal mt-8 sm:mt-12">
        <div class="flex flex-wrap gap-2">
          {expertise.map((skill) => (
            <span class="glass-tag px-3 py-1.5 sm:px-4 sm:py-2 text-sm text-mute rounded-md sm:rounded-lg">{skill}</span>
          ))}
        </div>
      </div>
      <p class="reveal mt-8 sm:mt-10 text-base text-mute">
        The photography experiments, from depth studies to a photograph cut as a surface, live in <a href="/beyond/" class="link-draw text-cream/85 hover:text-cream">Beyond</a>.
      </p>
      {/* A2.1 (owner ruling 2026-07-31): two floating pills made this band
          loud. One flame, one whisper: the resume becomes a drawn-underline
          text link; the inquiry keeps the ivory, compact. */}
    </div>
  </section>

  <!-- DIVIDER -->
  <section class:list={['hero-bleed', heroCapClass('dsc-0014'), 'relative h-[42vh] sm:h-[52vh] overflow-hidden']}>
    <picture class="absolute inset-0">
      <source type="image/avif" srcset={photoSrcset('dsc-0014', 'avif')} sizes={bleedSizes('dsc-0014')} />
      <img
        src="/images/photography/hero/dsc-0014.webp"
        srcset={photoSrcset('dsc-0014', 'webp')}
        sizes={bleedSizes('dsc-0014')}
        alt="A ram skull, stark against shadow"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-0" style="background-image: linear-gradient(to bottom, rgba(10,10,10,0.55) 0%, rgba(10,10,10,0.12) 38%, rgba(10,10,10,0.78) 100%);"></div>
    <div class="absolute inset-0 flex items-end justify-center pb-10 sm:pb-14">
      {/* A2.1 legibility (owner, 2026-07-31): the line was whispering into
          the bright plate between the horns. Larger, full cream, a deeper
          scrim below and a double shadow - still reverent, now readable. */}
      <div class="text-center">
        <p class="text-sm md:text-base tracking-[0.3em] uppercase text-cream" style="text-shadow: 0 1px 3px rgba(0,0,0,0.9), 0 2px 18px rgba(0,0,0,0.75);">Here am I. Send me.</p>
        <p class="mt-2 text-sm tracking-[0.3em] uppercase text-cream/80" style="text-shadow: 0 1px 3px rgba(0,0,0,0.9);">Isaiah 6:8</p>
      </div>
    </div>
  </section>

  
</BaseLayout>
