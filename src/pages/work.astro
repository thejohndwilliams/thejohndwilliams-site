---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Queue Forecast Dashboard',
    description: 'A browser-based forecasting tool I built from scratch for enterprise support operations. Uses Holt-Winters exponential smoothing to predict queue demand across time windows. Sanitized and open-sourced with proportions-only output to respect operational security.',
    tags: ['Python', 'Forecasting', 'Holt-Winters', 'Operations'],
    outcome: 'Used in production for workforce planning',
    github: 'https://github.com/thejohndwilliams/queue-forecast-dashboard'
  },
  {
    title: 'Job Application Analytics',
    description: 'Data science project analyzing 580+ job applications over two years. Built predictive models for rejection patterns, ran anomaly detection on response rates, and identified which variables actually matter in hiring outcomes. Written in Python with full statistical methodology.',
    tags: ['Python', 'Machine Learning', 'Data Analysis', 'Statistics'],
    outcome: 'Identified actionable patterns across 580+ applications',
    github: 'https://github.com/thejohndwilliams/jobappanalysis'
  },
  {
    title: 'Government Cybersecurity Assessment',
    description: 'NIST-framework risk assessment for government sector organizations. Covers threat analysis, control mapping, and remediation planning using NIST CSF and 800-53 Rev 5.',
    tags: ['NIST CSF', 'NIST 800-53', 'Risk Assessment', 'Cybersecurity'],
    outcome: 'Full threat model with prioritized remediation roadmap',
    github: 'https://github.com/thejohndwilliams/Government-Sector-Cybersecurity-Assessment'
  },
  {
    title: 'Healthcare Security Strategy',
    description: 'MBA cybersecurity capstone project at Baylor University. Designed a comprehensive security framework for a healthcare organization using NIST CSF and 800-53 Rev 5 controls, including risk assessment methodology, compliance mapping, and implementation roadmap.',
    tags: ['NIST CSF', 'NIST 800-53', 'Capstone', 'Compliance'],
    outcome: 'Baylor University MBA Cybersecurity Capstone',
    github: 'https://github.com/thejohndwilliams/Healthcare-Security-Strategy-ZetaAlpha'
  }
];

const expertise = [
  'Data Engineering',
  'Cybersecurity',
  'Incident Command',
  'Python',
  'Power BI',
  'SQL',
  'Operations Analytics',
  'Forecasting',
  'Photography'
];
---

<BaseLayout
  title="Work"
  description="Selected projects by John D. Williams — data engineering, cybersecurity, and operations."
>
  <section class="py-16 md:py-24">
    <div class="container-narrow">
      <div class="max-w-xl mb-14">
        <h1 class="text-3xl md:text-4xl mb-6">Work</h1>
        <p class="text-lg leading-relaxed opacity-75">
          Projects I have built, shipped, or open-sourced. Everything here is real
          work — no demos, no hypotheticals.
        </p>
      </div>

      <div class="space-y-6 mb-16">
        {projects.map((project) => (
          <div class="glass-card p-6 md:p-8">
            <h2 class="text-lg font-serif mb-3">{project.title}</h2>
            <p class="opacity-60 mb-5 leading-relaxed text-sm">{project.description}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tags.map((tag: string) => (
                <span class="text-xs px-3 py-1 bg-white/5 border border-white/10 rounded opacity-70">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex items-center justify-between">
              <p class="text-sm text-gold">{project.outcome}</p>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-sm opacity-50 hover:opacity-80 hover:text-gold transition-all">
                  View on GitHub →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <div>
        <h2 class="text-subhead mb-6">Expertise</h2>
        <div class="flex flex-wrap gap-2">
          {expertise.map((skill) => (
            <span class="px-4 py-2 text-sm opacity-70 bg-white/5 border border-white/10 rounded">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-16 pt-12 border-t border-white/5">
        <div class="glass-card p-8 max-w-md">
          <h2 class="text-lg font-serif mb-3">Have a project in mind?</h2>
          <p class="opacity-60 mb-6 text-sm">
            I take on select consulting engagements in data engineering,
            cybersecurity, and operational analytics.
          </p>
          <a href="mailto:hello@thejohndwilliams.com" class="btn btn-primary">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
