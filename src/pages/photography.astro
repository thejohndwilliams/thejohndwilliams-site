---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Photography"
  description="Nature and landscape photography by John D. Williams. Shot on Sony A7R."
>
  <!-- HERO -->
  <section class="py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal max-w-2xl mb-16">
        <h1 class="mb-8">Photography</h1>
        <p class="text-lg md:text-xl leading-relaxed opacity-70">
          Nature and landscape work, shot on a Sony A7R system. Nearly 3,000 images
          in the archive. This is what I see when I step outside.
        </p>
      </div>
    </div>
  </section>

  <!-- GALLERY PLACEHOLDER — alternating section -->
  <section class="section-light py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal glass-card p-10 mb-16">
        <p class="opacity-60 leading-relaxed mb-4">
          Gallery loading soon. I am curating selects from the Lightroom archive —
          landscape, nature, and light studies from across Texas and beyond.
        </p>
        <p class="opacity-60 leading-relaxed">
          In the meantime, visual work is on
          <a href="https://www.instagram.com/thejohndwilliams/" target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold/80 border-b border-gold/30 hover:border-gold transition-all duration-300">Instagram</a>
          and
          <a href="https://www.behance.net/killthewizard" target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold/80 border-b border-gold/30 hover:border-gold transition-all duration-300">Behance</a>.
        </p>
      </div>

      <!-- Placeholder grid -->
      <div class="stagger-children grid grid-cols-2 md:grid-cols-3 gap-4">
        {Array.from({ length: 6 }).map(() => (
          <div class="aspect-[4/3] bg-white/[0.03] border border-white/[0.06] rounded-card overflow-hidden flex items-center justify-center">
            <span class="text-xs opacity-15 tracking-wider uppercase">Image</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DETAILS -->
  <section class="py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal grid md:grid-cols-2 gap-12">
        <div>
          <p class="text-subhead mb-4">Equipment</p>
          <p class="opacity-50">Sony A7R system &middot; Nature &amp; Landscape &middot; Lightroom</p>
        </div>
        <div>
          <p class="text-subhead mb-4">Noticing Nature</p>
          <p class="opacity-50 leading-relaxed mb-4">
            Photography operates under Noticing Nature, one arm of the Noticing venture.
            Print sales and licensing are coming.
          </p>
          <a href="mailto:hello@thejohndwilliams.com" class="text-sm text-gold hover:text-gold/80 border-b border-gold/30 hover:border-gold transition-all duration-300">
            Get in touch →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
