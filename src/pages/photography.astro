const allCategories = ['all', ...categories.map(c => c.id)];
---

<BaseLayout
  title="Photography"
  description="Fine art photography by John D. Williams. Sky, earth, water, structure, and light — shot on Sony Alpha and Fujifilm X-Series."
>
  <!-- HERO — Featured image full-bleed -->
  <section class="relative min-h-[50vh] sm:min-h-[60vh] md:min-h-[80vh] flex items-end overflow-hidden">
    <img
      src="/images/photography/gallery/7r52326.webp"
      srcset="/images/photography/thumb/7r52326.webp 400w, /images/photography/gallery/7r52326.webp 1200w, /images/photography/hero/7r52326.webp 2400w"
      sizes="100vw"
      alt="Thunderheads against black sky"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/40 to-transparent"></div>
    <div class="relative z-10 container-narrow pb-10 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-40 mb-3 sm:mb-4 font-light">Noticing</p>
        <h1 class="text-title md:text-headline font-serif mb-4 sm:mb-6 tracking-tight">Photography</h1>
        <p class="text-base sm:text-lg md:text-xl leading-relaxed opacity-60 max-w-lg">
          The art of looking up. The art of looking close.
        </p>
      </div>
    </div>
  </section>

  <!-- CATEGORY FILTER -->
  <section class="section-light py-3 sm:py-4 md:py-5 sticky top-0 z-30 backdrop-blur-xl bg-[#111111]/90 border-b border-white/5">
    <div class="container-narrow">
      <nav class="flex items-center gap-1 sm:gap-4 md:gap-6 overflow-x-auto scrollbar-hide -mx-1 px-1" id="category-nav" role="tablist">
        <button
          class="category-btn active text-sm opacity-90 whitespace-nowrap py-2 px-3 sm:px-2 sm:pb-2 sm:pt-0 border-b-2 border-gold transition-all duration-300 min-h-[44px] flex items-center"
          data-category="all"
          role="tab"
          aria-selected="true"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            class="category-btn text-sm opacity-40 hover:opacity-70 whitespace-nowrap py-2 px-3 sm:px-2 sm:pb-2 sm:pt-0 border-b-2 border-transparent transition-all duration-300 min-h-[44px] flex items-center"
            data-category={cat.id}
            role="tab"
            aria-selected="false"
          >
            {cat.name}
          </button>
        ))}
      </nav>
    </div>
  </section>

  <!-- GALLERY SECTIONS -->
  {categories.map((cat, catIndex) => (
    <section
      class={`gallery-section py-10 sm:py-16 md:py-24 ${catIndex % 2 === 0 ? '' : 'section-light'}`}
      data-category={cat.id}
      id={`gallery-${cat.id}`}
    >
      <div class="container-wide">
        <!-- Category header -->
        <div class="reveal mb-6 sm:mb-10 md:mb-14">
          <h2 class="text-xl sm:text-2xl md:text-3xl font-serif mb-1 sm:mb-2 tracking-tight">{cat.name}</h2>
          <p class="text-xs sm:text-sm opacity-40 italic">{cat.description}</p>
        </div>

        <!-- Masonry-style grid — 1col phone, 2col phablet, 3col tablet, 4col desktop -->
        <div class="stagger-children grid grid-cols-1 min-[480px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 min-[480px]:gap-3 md:gap-4">
          {cat.images.map((img, i) => {
            const spanClass = img.featured
              ? 'min-[480px]:col-span-2 min-[480px]:row-span-2'
              : img.orientation === 'portrait'
                ? 'min-[480px]:row-span-2'
                : '';
            const aspectClass = img.featured
              ? 'aspect-[16/9] min-[480px]:aspect-square md:aspect-auto md:h-full'
              : img.orientation === 'portrait'
                ? 'aspect-[4/3] min-[480px]:aspect-[3/4]'
                : 'aspect-[4/3]';

            return (
              <div
                class={`gallery-item group relative overflow-hidden rounded-lg sm:rounded-card ring-1 ring-white/5 hover:ring-gold/20 active:ring-gold/30 transition-all duration-500 cursor-pointer ${spanClass}`}
                data-src={`/images/photography/hero/${img.file}.webp`}
                data-alt={img.alt}
              >
                <img
                  src={`/images/photography/gallery/${img.file}.webp`}
                  srcset={`/images/photography/thumb/${img.file}.webp 400w, /images/photography/gallery/${img.file}.webp 1200w`}
                  sizes={img.featured
                    ? '(max-width: 479px) 100vw, (max-width: 767px) 100vw, (max-width: 1023px) 66vw, 50vw'
                    : '(max-width: 479px) 100vw, (max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw'}
                  alt={img.alt}
                  class={`w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-[1.03] will-change-transform ${aspectClass}`}
                  loading={catIndex === 0 && i < 4 ? 'eager' : 'lazy'}
                  decoding={catIndex === 0 && i < 4 ? 'auto' : 'async'}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none">
                  <p class="text-[10px] sm:text-xs opacity-60">{img.alt}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <!-- LIGHTBOX — touch-friendly with swipe support -->
  <div id="lightbox" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-xl hidden items-center justify-center" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button id="lightbox-close" class="absolute top-3 right-3 sm:top-6 sm:right-6 z-10 w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center opacity-60 sm:opacity-40 hover:opacity-100 transition-opacity duration-300 bg-black/30 sm:bg-transparent rounded-full" aria-label="Close">
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button id="lightbox-prev" class="hidden sm:flex absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 items-center justify-center opacity-30 hover:opacity-100 transition-opacity duration-300" aria-label="Previous image">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button id="lightbox-next" class="hidden sm:flex absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 items-center justify-center opacity-30 hover:opacity-100 transition-opacity duration-300" aria-label="Next image">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-[96vw] sm:max-w-[92vw] max-h-[85vh] sm:max-h-[90vh] object-contain select-none" draggable="false" />
    <p id="lightbox-caption" class="absolute bottom-3 sm:bottom-6 left-1/2 -translate-x-1/2 text-xs sm:text-sm opacity-40 whitespace-nowrap max-w-[90vw] truncate"></p>
    <!-- Mobile swipe hint — shows once then fades -->
    <div id="swipe-hint" class="sm:hidden absolute bottom-10 left-1/2 -translate-x-1/2 flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] opacity-0 transition-opacity duration-500 pointer-events-none">
      <svg class="w-4 h-4 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" /></svg>
      <span class="opacity-40">Swipe</span>
      <svg class="w-4 h-4 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
    </div>
  </div>

  <!-- ABOUT / EQUIPMENT -->
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal grid sm:grid-cols-2 gap-8 sm:gap-12 md:gap-16">
        <div>
          <p class="text-xs tracking-[0.25em] uppercase opacity-30 mb-3 sm:mb-4">Equipment</p>
          <p class="text-base sm:text-lg font-serif mb-1.5 sm:mb-2 opacity-80">Sony Alpha 7R V</p>
          <p class="text-xs sm:text-sm opacity-40 mb-4 sm:mb-6">Primary system. Landscape, macro, and fine art work.</p>
          <p class="text-base sm:text-lg font-serif mb-1.5 sm:mb-2 opacity-80">Fujifilm X100VI</p>
          <p class="text-xs sm:text-sm opacity-40">Street, travel, and night photography.</p>
        </div>
        <div>
          <p class="text-xs tracking-[0.25em] uppercase opacity-30 mb-3 sm:mb-4">Noticing</p>
          <p class="text-sm sm:text-base opacity-50 leading-relaxed mb-4 sm:mb-6">
            The threshold between the vast and the intimate. Where a thunderhead holds the same weight as a single rain-wet leaf. This is what I notice.
          </p>
          <p class="text-sm sm:text-base opacity-50 leading-relaxed mb-6 sm:mb-8">
            Fine art prints and licensing inquiries welcome.
          </p>
          <a href="mailto:hello@thejohndwilliams.com" class="btn btn-primary w-full sm:w-auto">
            Inquire about prints
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SCRIPTURE -->
  <section class="py-12">
    <div class="container-narrow text-center">
      <p class="text-sm opacity-20 italic font-serif">John 15:13</p>
    </div>
  </section>
</BaseLayout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  .gallery-section[data-hidden="true"] { display: none; }

  #lightbox.active { display: flex; }

  #lightbox img {
    animation: lightbox-in 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes lightbox-in {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  function initGallery() {
    // Category filtering
    const buttons = document.querySelectorAll('.category-btn');
    const sections = document.querySelectorAll('.gallery-section');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category;

        buttons.forEach(b => {
          b.classList.remove('active', 'opacity-90', 'border-gold');
          b.classList.add('opacity-40', 'border-transparent');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active', 'opacity-90', 'border-gold');
        btn.classList.remove('opacity-40', 'border-transparent');
        btn.setAttribute('aria-selected', 'true');

        sections.forEach(s => {
          if (cat === 'all' || s.dataset.category === cat) {
            s.removeAttribute('data-hidden');
            s.style.display = '';
          } else {
            s.setAttribute('data-hidden', 'true');
            s.style.display = 'none';
          }
        });
      });
    });

    // Lightbox
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const items = document.querySelectorAll('.gallery-item');
    let currentIndex = 0;
    let visibleItems: Element[] = [];

    function updateVisibleItems() {
      visibleItems = Array.from(document.querySelectorAll('.gallery-section:not([data-hidden]) .gallery-item'));
    }

    let swipeHintShown = false;

    function openLightbox(index: number) {
      updateVisibleItems();
      currentIndex = index;
      const item = visibleItems[currentIndex] as HTMLElement;
      if (!item) return;
      lightboxImg!.src = item.dataset.src || '';
      lightboxImg!.alt = item.dataset.alt || '';
      lightboxCaption!.textContent = item.dataset.alt || '';
      lightbox!.classList.add('active');
      document.body.style.overflow = 'hidden';

      // Show swipe hint on first mobile open
      if (!swipeHintShown && window.innerWidth < 640) {
        swipeHintShown = true;
        const hint = document.getElementById('swipe-hint');
        if (hint) {
          setTimeout(() => { hint.style.opacity = '1'; }, 400);
          setTimeout(() => { hint.style.opacity = '0'; }, 2500);
        }
      }
    }

    function closeLightbox() {
      lightbox!.classList.remove('active');
      document.body.style.overflow = '';
    }

    function navigate(dir: number) {
      updateVisibleItems();
      currentIndex = (currentIndex + dir + visibleItems.length) % visibleItems.length;
      const item = visibleItems[currentIndex] as HTMLElement;
      if (!item) return;
      lightboxImg!.src = item.dataset.src || '';
      lightboxImg!.alt = item.dataset.alt || '';
      lightboxCaption!.textContent = item.dataset.alt || '';
    }

    items.forEach((item, i) => {
      item.addEventListener('click', () => {
        updateVisibleItems();
        const idx = visibleItems.indexOf(item);
        openLightbox(idx >= 0 ? idx : 0);
      });
    });

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => navigate(-1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => navigate(1));

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
    });

    // Touch/swipe support for mobile lightbox
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;

    lightbox?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    lightbox?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const deltaX = touchEndX - touchStartX;
      const deltaY = e.changedTouches[0].screenY - touchStartY;

      // Only handle horizontal swipes (ignore vertical scroll)
      if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
        if (deltaX < 0) navigate(1);  // Swipe left → next
        else navigate(-1);             // Swipe right → prev
      }
    }, { passive: true });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
