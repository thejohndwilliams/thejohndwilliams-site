---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';

// Image basenames; thumb/gallery/hero variants exist in both AVIF + WebP.
// srcset ladder (400/1200/2400w) lets the browser pick the right tier per
// viewport + DPR -- saves ~600KB on mobile vs always pulling 2400w hero.
const socialLinks = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/john-davis-williams/',
    handle: 'john-davis-williams',
    icon: '/images/previews/linkedin.svg',
    basename: '7r51025-enhanced-sr',
    heroAlt: 'Rain-wet leaf in low light',
    size: 'large'
  },
  {
    name: 'GitHub',
    url: 'https://github.com/thejohndwilliams',
    handle: 'thejohndwilliams',
    icon: '/images/previews/github.svg',
    basename: 'burningcold-enhanced',
    heroAlt: 'Structure catching evening fire',
    size: 'medium'
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/thejohndwilliams/',
    handle: '@thejohndwilliams',
    icon: '/images/previews/instagram.svg',
    basename: '7r51505-enhanced-sr',
    heroAlt: 'Bee on citrus blossom',
    size: 'medium'
  },
  {
    name: 'Behance',
    url: 'https://www.behance.net/killthewizard',
    handle: 'killthewizard',
    icon: '/images/previews/behance.svg',
    basename: 'img-7610-enhanced-sr',
    heroAlt: 'Pagoda reflected in still water',
    size: 'large'
  }
];

// Tile sizes: full container (~390px) on mobile, ~50vw on tablet, capped
// at ~600px on desktop (max-w-5xl container, 7/12 of grid = 597px).
const TILE_SIZES = '(min-width: 1024px) 600px, (min-width: 768px) 50vw, calc(100vw - 32px)';
const tierSrcset = (basename, ext) =>
  `/images/photography/thumb/${basename}.${ext} 400w, /images/photography/gallery/${basename}.${ext} 1200w, /images/photography/hero/${basename}.${ext} 2400w`;
---

<BaseLayout title="Links" description="Connect with John D. Williams across platforms." ogImage="/images/photography/hero/7r50804-enhanced-sr.webp" lcpImage="7r51025-enhanced-sr" lcpImageSizes={TILE_SIZES}>
  <section class="min-h-screen py-10 sm:py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 w-full">

      <div class="reveal text-center mb-10 sm:mb-16">
        <h1 class="text-title md:text-headline font-serif mb-3 sm:mb-4 tracking-tight" transition:name="site-title">John D. Williams</h1>
        <p class="text-[10px] sm:text-xs tracking-[0.25em] uppercase opacity-60 font-light">DATA &middot; SECURITY &middot; DECISIONS</p>
      </div>

      <!-- Staggered bento grid — 2col mobile, bento on md+ -->
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-2 sm:gap-3 md:gap-5 mb-10 sm:mb-16">

        {socialLinks.map((link, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          const priority = i < 2;

          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`group relative block rounded-lg sm:rounded-card overflow-hidden ${mdSpan} aspect-square sm:aspect-[16/10] ${mdAspect} ring-1 ring-white/5 hover:ring-gold/30 active:ring-gold/40 transition-all duration-500`}
            >
              <picture>
                <source
                  type="image/avif"
                  srcset={tierSrcset(link.basename, 'avif')}
                  sizes={TILE_SIZES}
                />
                <source
                  type="image/webp"
                  srcset={tierSrcset(link.basename, 'webp')}
                  sizes={TILE_SIZES}
                />
                <img
                  src={`/images/photography/gallery/${link.basename}.webp`}
                  alt={link.heroAlt}
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                  loading={priority ? 'eager' : 'lazy'}
                  decoding={priority ? 'auto' : 'async'}
                  fetchpriority={priority ? 'high' : undefined}
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-5 md:p-8">
                <div class="flex items-center gap-2.5 sm:gap-3.5 mb-1 sm:mb-3">
                  <SocialIcon
                    name={link.name.toLowerCase()}
                    class="w-6 h-6 sm:w-8 sm:h-8 flex-shrink-0 text-cream group-hover:text-gold-light transition-colors duration-300"
                  />
                  <span class="font-serif text-base sm:text-lg md:text-xl text-cream">{link.name}</span>
                </div>
                <p class="text-[10px] sm:text-sm opacity-60 font-mono hidden sm:block">{link.handle}</p>
              </div>
              <div class="absolute top-2 right-2 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}

      </div>

      <div class="reveal max-w-md mx-auto">
        <a
          href="mailto:jndwcreative@gmail.com"
          class="btn btn-primary w-full justify-center"
        >
          Get in touch
        </a>
      </div>

      <div class="mt-12 sm:mt-20 text-center">
        <p class="text-xs sm:text-sm opacity-60 italic font-serif">John 15:13</p>
      </div>

    </div>
  </section>
</BaseLayout>
