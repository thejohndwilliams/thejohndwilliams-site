---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPillGL from '../components/GlassPillGL.astro';
import { navItems, socialLinks } from '../utils/date';
import { photoTiers } from '../utils/photo-src';

// 2026-11-14 review, pass 4: eight identical grey panels became rows that
// each carry a small photograph, the same frames the home cards and page
// heroes use, so the bio link reads like the site it points to.
const NAV_PHOTO: Record<string, { file: string; alt: string }> = {
  '/photography/': { file: '7r52326', alt: '' },
  '/work/': { file: 'dscf0331', alt: '' },
  '/beyond/': { file: 'gv-3b61b429', alt: '' },
  '/about/': { file: 'img-0132', alt: '' },
};
const thumb = (file: string) => photoTiers(file).thumb;
---

<BaseLayout
  title="Links"
  description="John D. Williams: photography, work, and where to reach me."
>
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container-narrow max-w-xl">
      <p class="eyebrow mb-3 sm:mb-4">Connect</p>
      <h1 class="mb-4">John D. Williams</h1>
      <p class="text-lg opacity-70 mb-10 sm:mb-12">Operations, risk and controls. Fine-art photographer.</p>

      <ul class="space-y-3 mb-10">
        {navItems.map((item) => {
          const photo = NAV_PHOTO[item.href];
          const t = photo ? thumb(photo.file) : null;
          return (
            <li>
              <a href={item.href} class="links-row glass-card text-cream">
                {photo && t && (
                  <picture class="links-row__thumb">
                    <source type="image/avif" srcset={`/images/photography/thumb/${photo.file}.avif`} />
                    <img
                      src={`/images/photography/thumb/${photo.file}.webp`}
                      alt={photo.alt}
                      width={t.w}
                      height={t.h}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
                <span class="links-row__text">
                  <span class="block">{item.name}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>

      <ul class="space-y-3 mb-12">
        {socialLinks.map((item) => (
          <li>
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="links-row glass-card"
            >
              <picture class="links-row__thumb">
                <source srcset={item.thumbAvif} type="image/avif" />
                <source srcset={item.thumb ?? item.hero} type="image/webp" />
                <img
                  src={item.thumbFallback ?? item.heroFallback}
                  alt=""
                  width={item.thumbW}
                  height={item.thumbH}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <span class="links-row__text">
                <span class="block text-cream">{item.name}</span>
                <span class="block text-sm text-mute">{item.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <GlassPillGL label="Contact" href="mailto:jndwcreative@gmail.com" variant="c" />
    </div>
  </section>
</BaseLayout>

<style>
  .links-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 72px;
    padding: 0.625rem 1.25rem 0.625rem 0.625rem;
    opacity: 0.92;
    transition: opacity 200ms linear;
  }
  .links-row:hover,
  .links-row:focus-visible {
    opacity: 1;
  }
  .links-row__thumb,
  .links-row__thumb img {
    display: block;
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    border-radius: 8px;
    object-fit: cover;
    overflow: hidden;
  }
  .links-row__text {
    min-width: 0;
  }
</style>
