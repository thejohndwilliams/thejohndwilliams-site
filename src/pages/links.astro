---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/john-davis-williams/',
    handle: 'john-davis-williams',
    icon: '/images/previews/linkedin.svg',
    hero: '/images/photography/hero/7r51025-enhanced-sr.webp',
    heroFallback: '/images/photography/gallery/7r51025-enhanced-sr.webp',
    size: 'large'
  },
  {
    name: 'GitHub',
    url: 'https://github.com/thejohndwilliams',
    handle: 'thejohndwilliams',
    icon: '/images/previews/github.svg',
    hero: '/images/photography/hero/burningcold-enhanced.webp',
    heroFallback: '/images/photography/gallery/burningcold-enhanced.webp',
    size: 'medium'
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/thejohndwilliams/',
    handle: '@thejohndwilliams',
    icon: '/images/previews/instagram.svg',
    hero: '/images/photography/hero/7r52258.webp',
    heroFallback: '/images/photography/gallery/7r52258.webp',
    size: 'medium'
  },
  {
    name: 'Behance',
    url: 'https://www.behance.net/killthewizard',
    handle: 'killthewizard',
    icon: '/images/previews/behance.svg',
    hero: '/images/photography/hero/img-7610-enhanced-sr.webp',
    heroFallback: '/images/photography/gallery/img-7610-enhanced-sr.webp',
    size: 'large'
  }
];
---

<BaseLayout title="Links" description="Connect with John D. Williams across platforms.">
  <section class="min-h-screen py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 w-full">

      <div class="reveal text-center mb-16">
        <h1 class="text-title md:text-headline font-serif mb-4 tracking-tight" transition:name="site-title">John D. Williams</h1>
        <p class="text-xs tracking-[0.25em] uppercase opacity-40 font-light">DATA &middot; SECURITY &middot; DECISIONS</p>
      </div>

      <!-- Staggered bento grid -->
      <div class="stagger-children grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-5 mb-16">

        <!-- LinkedIn — wide hero -->
        <a
          href={socialLinks[0].url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block rounded-card overflow-hidden md:col-span-7 aspect-[16/10] md:aspect-[16/9] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500"
        >
          <picture>
            <source srcset={socialLinks[0].hero} type="image/webp" />
            <img
              src={socialLinks[0].heroFallback}
              alt=""
              class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
              fetchpriority="high"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-white/10 backdrop-blur-sm p-2 flex-shrink-0 ring-1 ring-white/10">
                <img src={socialLinks[0].icon} alt="" class="w-full h-full object-contain" />
              </div>
              <span class="font-serif text-xl text-white">{socialLinks[0].name}</span>
            </div>
            <p class="text-sm opacity-40 font-mono">{socialLinks[0].handle}</p>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </div>
        </a>

        <!-- GitHub — tall right -->
        <a
          href={socialLinks[1].url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block rounded-card overflow-hidden md:col-span-5 aspect-[16/10] md:aspect-[4/3] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500"
        >
          <picture>
            <source srcset={socialLinks[1].hero} type="image/webp" />
            <img
              src={socialLinks[1].heroFallback}
              alt=""
              class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
              fetchpriority="high"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-white/10 backdrop-blur-sm p-2 flex-shrink-0 ring-1 ring-white/10">
                <img src={socialLinks[1].icon} alt="" class="w-full h-full object-contain" />
              </div>
              <span class="font-serif text-xl text-white">{socialLinks[1].name}</span>
            </div>
            <p class="text-sm opacity-40 font-mono">{socialLinks[1].handle}</p>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </div>
        </a>

        <!-- Instagram — tall left -->
        <a
          href={socialLinks[2].url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block rounded-card overflow-hidden md:col-span-5 aspect-[16/10] md:aspect-[4/3] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500"
        >
          <picture>
            <source srcset={socialLinks[2].hero} type="image/webp" />
            <img
              src={socialLinks[2].heroFallback}
              alt=""
              class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-white/10 backdrop-blur-sm p-2 flex-shrink-0 ring-1 ring-white/10">
                <img src={socialLinks[2].icon} alt="" class="w-full h-full object-contain" />
              </div>
              <span class="font-serif text-xl text-white">{socialLinks[2].name}</span>
            </div>
            <p class="text-sm opacity-40 font-mono">{socialLinks[2].handle}</p>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </div>
        </a>

        <!-- Behance — wide bottom -->
        <a
          href={socialLinks[3].url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block rounded-card overflow-hidden md:col-span-7 aspect-[16/10] md:aspect-[16/9] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500"
        >
          <picture>
            <source srcset={socialLinks[3].hero} type="image/webp" />
            <img
              src={socialLinks[3].heroFallback}
              alt=""
              class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-white/10 backdrop-blur-sm p-2 flex-shrink-0 ring-1 ring-white/10">
                <img src={socialLinks[3].icon} alt="" class="w-full h-full object-contain" />
              </div>
              <span class="font-serif text-xl text-white">{socialLinks[3].name}</span>
            </div>
            <p class="text-sm opacity-40 font-mono">{socialLinks[3].handle}</p>
          </div>
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </div>
        </a>

      </div>

      <div class="reveal max-w-md mx-auto">
        <a
          href="mailto:hello@thejohndwilliams.com"
          class="btn btn-primary w-full justify-center"
        >
          Get in touch
        </a>
      </div>

      <div class="mt-20 text-center">
        <p class="text-sm opacity-30 italic font-serif">John 15:13</p>
      </div>

    </div>
  </section>
</BaseLayout>
