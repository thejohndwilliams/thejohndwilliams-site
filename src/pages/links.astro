---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/john-davis-williams/',
    handle: 'john-davis-williams',
    icon: '/images/previews/linkedin.svg',
    hero: '/images/photography/hero/7r51025-enhanced-sr.webp',
    heroFallback: '/images/photography/gallery/7r51025-enhanced-sr.webp',
    size: 'large'
  },
  {
    name: 'GitHub',
    url: 'https://github.com/thejohndwilliams',
    handle: 'thejohndwilliams',
    icon: '/images/previews/github.svg',
    hero: '/images/photography/hero/burningcold-enhanced.webp',
    heroFallback: '/images/photography/gallery/burningcold-enhanced.webp',
    size: 'medium'
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/thejohndwilliams/',
    handle: '@thejohndwilliams',
    icon: '/images/previews/instagram.svg',
    hero: '/images/photography/hero/7r52258.webp',
    heroFallback: '/images/photography/gallery/7r52258.webp',
    size: 'medium'
  },
  {
    name: 'Behance',
    url: 'https://www.behance.net/killthewizard',
    handle: 'killthewizard',
    icon: '/images/previews/behance.svg',
    hero: '/images/photography/hero/img-7610-enhanced-sr.webp',
    heroFallback: '/images/photography/gallery/img-7610-enhanced-sr.webp',
    size: 'large'
  }
];
---

<BaseLayout title="Links" description="Connect with John D. Williams across platforms.">
  <section class="min-h-screen py-10 sm:py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 w-full">

      <div class="reveal text-center mb-10 sm:mb-16">
        <h1 class="text-title md:text-headline font-serif mb-3 sm:mb-4 tracking-tight" transition:name="site-title">John D. Williams</h1>
        <p class="text-[10px] sm:text-xs tracking-[0.25em] uppercase opacity-40 font-light">DATA &middot; SECURITY &middot; DECISIONS</p>
      </div>

      <!-- Staggered bento grid — 2col mobile, bento on md+ -->
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-2 sm:gap-3 md:gap-5 mb-10 sm:mb-16">

        {socialLinks.map((link, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          const priority = i < 2;

          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`group relative block rounded-lg sm:rounded-card overflow-hidden ${mdSpan} aspect-square sm:aspect-[16/10] ${mdAspect} ring-1 ring-white/6 hover:ring-gold/30 active:ring-gold/40 transition-all duration-500`}
            >
              <picture>
                <source srcset={link.hero} type="image/webp" />
                <img
                  src={link.heroFallback}
                  alt=""
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                  loading={priority ? 'eager' : 'lazy'}
                  decoding={priority ? 'auto' : 'async'}
                  fetchpriority={priority ? 'high' : undefined}
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-5 md:p-8">
                <div class="flex items-center gap-2 sm:gap-3 mb-1 sm:mb-3">
                  <div class="w-7 h-7 sm:w-10 sm:h-10 rounded-md sm:rounded-lg bg-white/10 backdrop-blur-sm p-1 sm:p-2 flex-shrink-0 ring-1 ring-white/10">
                    <img src={link.icon} alt="" class="w-full h-full object-contain" />
                  </div>
                  <span class="font-serif text-sm sm:text-lg md:text-xl text-white">{link.name}</span>
                </div>
                <p class="text-[10px] sm:text-sm opacity-40 font-mono hidden sm:block">{link.handle}</p>
              </div>
              <div class="absolute top-2 right-2 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}

      </div>

      <div class="reveal max-w-md mx-auto">
        <a
          href="mailto:hello@thejohndwilliams.com"
          class="btn btn-primary w-full justify-center"
        >
          Get in touch
        </a>
      </div>

      <div class="mt-12 sm:mt-20 text-center">
        <p class="text-xs sm:text-sm opacity-30 italic font-serif">John 15:13</p>
      </div>

    </div>
  </section>
</BaseLayout>
