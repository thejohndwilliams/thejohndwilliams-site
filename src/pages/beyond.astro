---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthPhoto from '../components/DepthPhoto.astro';
import DepthStack from '../components/DepthStack.astro';
import KineticPlate from '../components/KineticPlate.astro';
import KineticPlate3D from '../components/KineticPlate3D.astro';
import LiquidPlate from '../components/LiquidPlate.astro';
import ReliefStudies from '../components/ReliefStudies.astro';
import { publicBitmap } from '../utils/bitmap';
import { photoSrcset, photoTiers } from '../utils/photo-src';
import '../styles/beyond.css';
import '../styles/depth-study.css';

// Opening photograph, then the depth figure at rest, then the studies.
// The figure is the same component /depth uses. This page does not link
// to that route. The banner file is the page's existing landscape hero.
const SUBJECTS = [
  {
    id: 'earth',
    label: 'Earth',
    title: 'Earth · rain-wet leaf',
    note: 'A dark subject. Luminance buries it; depth stands it forward.',
    file: '7r51025-enhanced-sr',
    alt: 'Rain-wet leaf in darkness',
  },
  {
    id: 'structure',
    label: 'Structure',
    title: 'Structure · Shanghai Tower',
    note: 'Shot against bright sky. Depth keeps the tower near, the sky far.',
    file: 'img-7576-enhanced',
    alt: 'Shanghai Tower from below',
  },
  {
    id: 'sky',
    label: 'Sky',
    title: 'Sky · thunderheads',
    note: 'The nearest billows read closest; the void recedes to black.',
    file: '7r52326',
    alt: 'Thunderheads against black sky',
  },
  {
    id: 'water',
    label: 'Water',
    title: 'Water · El Arco',
    note: 'A distant scene. The arch holds its place in real space.',
    file: '7r50674-enhanced-sr',
    alt: 'El Arco de Cabo San Lucas',
  },
] as const;

const earth = SUBJECTS[0];

function orientOf(file: string): 'portrait' | 'landscape' | 'square' {
  const { w, h } = photoTiers(file).hero;
  const ratio = w / h;
  if (ratio > 0.92 && ratio < 1.08) return 'square';
  return h > w ? 'portrait' : 'landscape';
}
const BANNER = 'gv-3b61b429';
const bannerAlt = 'Lone tree against a smoldering horizon';
const banner = photoTiers(BANNER);
/* Phones ask for 2x the CSS width so cover does not upscale the thumb.
   Wider screens ask for the viewport: the band is full-bleed like Work and
   Photography, and data-bleed-short lets a 2400px master fill a wider
   display rather than leaving gutters (see e2e/image-resolution.spec.ts). */
const bannerSizes = '(max-width: 700px) 200vw, 100vw';
const thumbDims = Object.fromEntries(
  await Promise.all(
    SUBJECTS.map(async (row) => [row.file, await publicBitmap(`/images/photography/thumb/${row.file}.webp`)] as const),
  ),
);
---

<BaseLayout
  title="Beyond"
  description="Beyond the frame: photographs rebuilt as holograms and true point clouds, then studied as texture and as surface. The experiments of John D. Williams."
  ogImage="/og/photography/gv-3b61b429.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  lcpImage={BANNER}
  lcpImageSizes={bannerSizes}
  bodyClass="page-beyond"
>
  <div class="beyond-banner">
    <picture>
      <source type="image/avif" srcset={photoSrcset(BANNER, 'avif')} sizes={bannerSizes} />
      <img
        class="beyond-banner__img"
        src={`/images/photography/gallery/${BANNER}.webp`}
        srcset={photoSrcset(BANNER, 'webp')}
        sizes={bannerSizes}
        width={banner.gallery.w}
        height={banner.gallery.h}
        alt={bannerAlt}
        data-bleed-short
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="beyond-scrim"></div>
    <!-- The lockup is the Work and Photography hero pattern verbatim:
         eyebrow, t-title, one lede, inside .reveal so it fades up with the
         rest of the site. Geometry lives in beyond.css (.beyond-title). -->
    <header id="beyond" class="beyond-anchor beyond-title">
      <div class="beyond-text reveal">
        <p class="eyebrow mb-3 sm:mb-4">Lifting</p>
        <h1 class="t-title mb-4 sm:mb-5 font-serif tracking-tight">Beyond</h1>
        <p class="beyond-lede text-base leading-relaxed max-w-xl">
          Experiments in what a photograph can become once it leaves the
          frame. Each one starts the same way: a finished photograph, taken
          seriously enough to ask what else it holds. Depth, first. Then
          texture. Then surface.
        </p>
      </div>
    </header>
  </div>

  <!-- ACT I · DEPTH. One act header, two figures. The layer figure used to
       sit here with no heading at all (owner: "awkward", 2026-10-28); it is
       now the first figure of the act, and the Planes / Points study below
       is the second. The ids, hooks and the resting autoplay="0" are locked
       in tests/build.test.ts and e2e/depth-study.spec.ts. -->
  <section id="depth-layers" class="beyond-section beyond-anchor beyond-layers" data-depth-layers>
    <div class="beyond-col">
      <div class="beyond-text beyond-head">
        <p class="eyebrow">Depth</p>
        <h2 class="t-sub font-serif">Separate the photograph</h2>
        <p class="beyond-copy">
          Every study here starts with one finished frame and a depth estimate
          for each pixel. The first figure pulls a photograph apart into five
          layers, far to near. The second cuts a frame into stacked planes or
          scatters it into points, displaced along the axis the camera never
          recorded. One fakes relief beautifully; the other actually has it.
          Choose a subject, then Planes or Points, and sweep across the plate
          to orbit it. Reduced motion holds a still frame.
        </p>
      </div>
      <DepthStack priority={false} autoplay={false} />
    </div>
  </section>

  <section id="depth" class="beyond-section beyond-anchor" data-depth-study data-subject="earth" data-orient={orientOf(earth.file)} data-mode="rest">
    <div class="beyond-col" data-depth-slot>
      <div class="depth-layout">
      <div class="depth-stage">
        <div class="depth-frame" data-depth-frame data-mode="rest">
          <div data-depth-photo>
            <DepthPhoto file={earth.file} alt={earth.alt} />
          </div>
          <div data-depth-plate></div>
        </div>

        <!-- The aside follows the page's figure grammar: tag, caption,
             then the control row. Without JS the four subject notes all
             show and the controls stay hidden (depth-study.css). -->
        <div class="depth-aside bfig__side">
          <ul class="depth-index">
            {SUBJECTS.map((row, i) => (
              <li class:list={['depth-index__item', { 'is-shown': i === 0 }]} data-study-note={row.id}>
                <p class="bfig__tag">{row.title}</p>
                <p class="bfig__cap">{row.note}</p>
              </li>
            ))}
          </ul>

          <div class="depth-controls">
            <div class="depth-mode bfig__controls" role="group" aria-label="Depth rendering">
              <button type="button" class="depth-mode__btn bfig__action" data-depth-mode="planes" aria-pressed="false">Planes</button>
              <button type="button" class="depth-mode__btn bfig__action" data-depth-mode="points" aria-pressed="false">Points</button>
            </div>
          </div>
        </div>
      </div>

      <div class="depth-controls depth-controls--strip">
        <div class="depth-thumbs" role="group" aria-label="Depth study">
          {SUBJECTS.map((row, i) => (
            <button
              type="button"
              class="depth-thumb"
              data-study={row.id}
              data-orient={orientOf(row.file)}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <picture>
                <source type="image/avif" srcset={photoSrcset(row.file, 'avif', ['thumb', 'gallery'])} sizes="(max-width: 700px) 92vw, 520px" />
                <source type="image/webp" srcset={photoSrcset(row.file, 'webp', ['thumb', 'gallery'])} sizes="(max-width: 700px) 92vw, 520px" />
                <img src={`/images/photography/thumb/${row.file}.webp`} alt="" width={thumbDims[row.file].width} height={thumbDims[row.file].height} />
              </picture>
              <span>{row.label}</span>
            </button>
          ))}
        </div>
      </div>
      </div>
    </div>

    {SUBJECTS.map((row) => (
      <template data-study-tpl={row.id}>
        <div data-part="photo">
          <DepthPhoto file={row.file} alt={row.alt} />
        </div>
        <div data-part="hologram">
          <p class="plate-tag">Hologram · stacked planes</p>
          <KineticPlate category={row.id} />
        </div>
        <div data-part="cloud">
          <p class="plate-tag">Point cloud · true depth</p>
          <KineticPlate3D category={row.id} />
        </div>
      </template>
    ))}
  </section>

  <!-- ACT II · TEXTURE. Same header grammar as the other acts: eyebrow,
       serif h2, one paragraph, one italic method line. -->
  <section id="texture" class="beyond-section beyond-anchor">
    <div class="beyond-col">
      <div class="beyond-text beyond-head">
        <p class="eyebrow">Texture</p>
        <h2 class="t-sub font-serif">Drawn from single frames</h2>
        <p class="beyond-copy">
          The depth work above feeds these. Wallpapers, textures, and color
          palettes, each taken from one photograph, free to take.
        </p>
        <p class="beyond-copy beyond-copy--italic">
          Studies in texture. The blur behind each plate is a Gaussian
          convolution, the closed-form solution to the heat equation. Light
          diffuses through the glass the way heat moves through a solid.
        </p>
      </div>
      <div class="beyond-plates">
        <LiquidPlate src="img-2528" alt="A ribbon of light drawn in the dark" label="Ribbon" note="A ribbon of light drawn in the dark." index={0} />
        <LiquidPlate src="dsc-0014" alt="A carved ram emerging from black" label="Ram" note="A carved ram emerging from black." index={1} />
        <LiquidPlate src="dscf1022" alt="A wall combed into vertical ribs of light and shadow" label="Stone" note="A wall, raked into ribs of light." index={2} />
      </div>
    </div>
  </section>

  <ReliefStudies />

  <!-- CLOSE. The open questions and the calibration note were two
       sections; they are one restrained closing now. -->
  <section id="method" class="beyond-section beyond-anchor">
    <div class="beyond-col">
      <div class="beyond-text beyond-head">
        <p class="eyebrow">Open questions</p>
        <h2 class="t-sub font-serif">The envelope</h2>
        <p class="beyond-copy">
          Which relief depth survives ordinary room light? That one gets
          answered by a printed sample, not by a render.
        </p>
        <p class="beyond-copy">
          Every material on this site holds calibrated bounds: blur no higher
          than 44 pixels, saturation no higher than 1.85, text contrast at or
          above 4.5:1 at every tested opacity. Settings that survived a sweep,
          not settings that looked good once.
        </p>
        <p class="beyond-return">
          <a href="/photography/">Back to the photographs</a>
        </p>
      </div>
    </div>
  </section>

<script>
  import { initDepthStudy } from '../scripts/depth-study';
  import { initDepthScrub } from '../scripts/depth-scrub';

  function syncBeyondPage(): void {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.body.classList.toggle('page-beyond', path === '/beyond');
  }

  const flag = window as Window & { __beyondPage?: boolean };
  syncBeyondPage();
  initDepthStudy();
  initDepthScrub();
  if (!flag.__beyondPage) {
    flag.__beyondPage = true;
    document.addEventListener('astro:after-swap', () => {
      syncBeyondPage();
      initDepthStudy();
      initDepthScrub();
    });
  }
</script>
</BaseLayout>
