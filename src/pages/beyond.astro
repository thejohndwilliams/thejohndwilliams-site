---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthPhoto from '../components/DepthPhoto.astro';
import KineticPlate from '../components/KineticPlate.astro';
import KineticPlate3D from '../components/KineticPlate3D.astro';
import LiquidPlate from '../components/LiquidPlate.astro';
import ReliefStudies from '../components/ReliefStudies.astro';
import '../styles/beyond.css';
import '../styles/depth-study.css';

// One column, one depth frame, texture, then surface findings.
// The exploded-layers figure lives on /depth and is not imported here.
// #depth-layers is the empty hook it can fill later.
const SUBJECTS = [
  {
    id: 'earth',
    label: 'Earth',
    title: 'Earth · rain-wet leaf',
    note: 'A dark subject. Luminance buries it; depth stands it forward.',
    file: '7r51025-enhanced-sr',
    alt: 'Rain-wet leaf in darkness',
  },
  {
    id: 'structure',
    label: 'Structure',
    title: 'Structure · Shanghai Tower',
    note: 'Shot against bright sky. Depth keeps the tower near, the sky far.',
    file: 'img-7576-enhanced',
    alt: 'Shanghai Tower from below',
  },
  {
    id: 'sky',
    label: 'Sky',
    title: 'Sky · thunderheads',
    note: 'The nearest billows read closest; the void recedes to black.',
    file: '7r52326',
    alt: 'Thunderheads against black sky',
  },
  {
    id: 'water',
    label: 'Water',
    title: 'Water · El Arco',
    note: 'A distant scene. The arch holds its place in real space.',
    file: '7r50674-enhanced-sr',
    alt: 'El Arco de Cabo San Lucas',
  },
] as const;

const earth = SUBJECTS[0];
const DEPTH_SIZES = '(max-width: 767px) calc(100vw - 2rem), 1080px';
---

<BaseLayout
  title="Beyond"
  description="Beyond the frame: photographs rebuilt as holograms and true point clouds, then studied as texture and as surface. The experiments of John D. Williams."
  ogImage="/og/photography/gv-3b61b429.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  lcpImage={earth.file}
  lcpImageSizes={DEPTH_SIZES}
  bodyClass="page-beyond"
>
  <header id="beyond" class="beyond-section beyond-anchor beyond-title">
    <div class="beyond-col">
      <div class="beyond-text">
        <p class="eyebrow">Lifting</p>
        <h1 class="t-title font-serif">Beyond</h1>
        <p class="beyond-lede beyond-copy">
          Experiments in what a photograph can become once it leaves the
          frame. Each one starts the same way: a finished photograph, taken
          seriously enough to ask what else it holds. Depth, first. Then
          texture. Then surface.
        </p>
      </div>
    </div>
  </header>

  <section id="depth" class="beyond-section beyond-anchor" data-depth-study data-subject="earth" data-mode="rest">
    <div class="beyond-col">
      <div class="beyond-text">
        <h2 class="t-sub font-serif">The depth studies</h2>
        <p class="beyond-copy">
          The same photographs, twice. Planes: the frame cut into stacked
          planes that slide against each other as you move. Points: every
          dot sitting at the true depth the photograph holds, baked from its
          depth pass. One fakes relief beautifully; the other actually has
          it. The photograph stays in color until a mode is chosen. Sweep
          across a plate to orbit it; release mid-turn and it carries, then
          settles. On a phone, the clouds roll with the page. Reduced motion
          holds a still frame.
        </p>
        <p class="beyond-copy beyond-copy--italic">
          One photograph in. A depth estimate per pixel. The image cut into
          planes or scattered into points, displaced along the axis the camera
          never recorded.
        </p>
      </div>
    </div>

    {/* Study: depth layers. Empty on purpose. A later figure fills this
        hook. Do not import the separate /depth draft. */}
    <div id="depth-layers" class="beyond-layers" data-depth-layers hidden></div>

    <div class="beyond-col" data-depth-slot>
      <div class="depth-frame" data-depth-frame data-mode="rest">
        <div data-depth-photo>
          <DepthPhoto file={earth.file} alt={earth.alt} eager />
        </div>
        <div data-depth-plate></div>
      </div>

      <div class="depth-controls">
        <div class="depth-mode glass-chip-rail" role="group" aria-label="Depth rendering">
          <button type="button" class="depth-mode__btn" data-depth-mode="planes" aria-pressed="false">Planes</button>
          <button type="button" class="depth-mode__btn" data-depth-mode="points" aria-pressed="false">Points</button>
        </div>
        <div class="depth-thumbs" role="group" aria-label="Depth study">
          {SUBJECTS.map((row, i) => (
            <button
              type="button"
              class="depth-thumb"
              data-study={row.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <picture>
                <source type="image/avif" srcset={`/images/photography/thumb/${row.file}.avif`} />
                <img src={`/images/photography/thumb/${row.file}.webp`} alt="" width="96" height="96" />
              </picture>
              <span>{row.label}</span>
            </button>
          ))}
        </div>
      </div>

      <ul class="depth-index beyond-text">
        {SUBJECTS.map((row, i) => (
          <li class:list={['depth-index__item', { 'is-shown': i === 0 }]} data-study-note={row.id}>
            <p class="eyebrow">{row.title}</p>
            <p class="beyond-copy">{row.note}</p>
          </li>
        ))}
      </ul>
    </div>

    {SUBJECTS.map((row) => (
      <template data-study-tpl={row.id}>
        <div data-part="photo">
          <DepthPhoto file={row.file} alt={row.alt} />
        </div>
        <div data-part="hologram">
          <p class="plate-tag">Hologram · stacked planes</p>
          <KineticPlate category={row.id} />
        </div>
        <div data-part="cloud">
          <p class="plate-tag">Point cloud · true depth</p>
          <KineticPlate3D category={row.id} />
        </div>
      </template>
    ))}
  </section>

  <section class="beyond-section">
    <div class="beyond-col">
      <div class="beyond-text">
        <h2 class="t-sub font-serif">Texture and Gaussian studies</h2>
        <p class="beyond-kicker">Studies in texture.</p>
        <p class="beyond-copy">
          The depth work above feeds these. Wallpapers, textures, and color palettes drawn from single frames, free to take.
        </p>
        <p class="beyond-copy beyond-copy--italic">
          The blur behind each plate is a Gaussian convolution, the
          closed-form solution to the heat equation. Light diffuses through the
          glass the way heat moves through a solid.
        </p>
      </div>
      <div class="beyond-plates">
        <LiquidPlate src="img-2528" alt="A ribbon of light drawn in the dark" label="Ribbon" note="A ribbon of light drawn in the dark." index={0} />
        <LiquidPlate src="dsc-0014" alt="A carved ram emerging from black" label="Ram" note="A carved ram emerging from black." index={1} />
        <LiquidPlate src="dscf1022" alt="A wall combed into vertical ribs of light and shadow" label="Stone" note="A wall, raked into ribs of light." index={2} />
      </div>
    </div>
  </section>

  <ReliefStudies />

  <section id="method" class="beyond-section beyond-anchor">
    <div class="beyond-col">
      <div class="beyond-text beyond-method">
        <p class="eyebrow">The envelope</p>
        <p class="beyond-copy">
          Every material on this site holds calibrated bounds: blur no higher
          than 44 pixels, saturation no higher than 1.85, text contrast at or
          above 4.5:1 at every tested opacity. Settings that survived a sweep,
          not settings that looked good once.
        </p>
        <p class="beyond-return">
          <a href="/photography/">Back to the photographs</a>
        </p>
      </div>
    </div>
  </section>

<script>
  import { initDepthStudy } from '../scripts/depth-study';

  function syncBeyondPage(): void {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.body.classList.toggle('page-beyond', path === '/beyond');
  }

  const flag = window as Window & { __beyondPage?: boolean };
  syncBeyondPage();
  initDepthStudy();
  if (!flag.__beyondPage) {
    flag.__beyondPage = true;
    document.addEventListener('astro:after-swap', () => {
      syncBeyondPage();
      initDepthStudy();
    });
  }
</script>
</BaseLayout>
