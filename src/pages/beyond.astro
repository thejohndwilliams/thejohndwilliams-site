---
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticPlate from '../components/KineticPlate.astro';
import KineticPlate3D from '../components/KineticPlate3D.astro';
import LiquidPlate from '../components/LiquidPlate.astro';
import ReliefStudies from '../components/ReliefStudies.astro';
import { publicBitmap } from '../utils/bitmap';
import '../styles/depth-study.css';

const ROWS = [
  { id: 'earth', label: 'Earth · rain-wet leaf', note: 'A dark subject. Luminance buries it; depth stands it forward.' },
  { id: 'structure', label: 'Structure · Shanghai Tower', note: 'Shot against bright sky. Depth keeps the tower near, the sky far.' },
  { id: 'sky', label: 'Sky · thunderheads', note: 'The nearest billows read closest; the void recedes to black.' },
  { id: 'water', label: 'Water · El Arco', note: 'A distant scene. The arch holds its place in real space.' },
] as const;

const banner = await publicBitmap('/images/photography/hero/gv-3b61b429.webp');
---

<BaseLayout
  title="Beyond"
  description="Beyond the frame: photographs rebuilt as holograms and true point clouds, then studied as texture and as surface. The experiments of John D. Williams."
  ogImage="/og/photography/gv-3b61b429.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  lcpImage="gv-3b61b429"
>
  <section class="relative min-h-[50vh] sm:min-h-[60vh] md:min-h-[80vh] flex items-end overflow-hidden">
    <picture>
      <source
        type="image/avif"
        srcset="/images/photography/thumb/gv-3b61b429.avif 400w, /images/photography/gallery/gv-3b61b429.avif 1200w, /images/photography/hero/gv-3b61b429.avif 2400w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/photography/thumb/gv-3b61b429.webp 400w, /images/photography/gallery/gv-3b61b429.webp 1200w, /images/photography/hero/gv-3b61b429.webp 2400w"
        sizes="100vw"
      />
      <img
        src="/images/photography/hero/gv-3b61b429.webp"
        alt="A lone tree in silhouette against the last light of sunset beyond a dark ridge"
        class="absolute inset-0 w-full h-full object-cover"
        width={banner.width}
        height={banner.height}
        fetchpriority="high"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/40 to-transparent"></div>
    <div class="hero-lockup relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-10 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">Lifting</p>
        <h1 class="t-title font-serif mb-4 sm:mb-6 tracking-tight">Beyond</h1>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 md:py-20">
    <div class="container-narrow">
      <div class="prose max-w-2xl">
        <p>
          Experiments in what a photograph can become once it leaves the
          frame. Each one starts the same way: a finished photograph, taken
          seriously enough to ask what else it holds. Depth, first. Then
          texture. Then surface.
        </p>
      </div>
    </div>
  </section>

  <section id="depth" class="pt-4 pb-10 sm:pb-14 md:pb-16" data-depth-study>
    <div class="container-narrow">
      <h2 class="t-sub font-serif mb-3 sm:mb-4">The depth studies</h2>
      <p class="text-sm sm:text-base opacity-55 max-w-2xl">
        The same photographs, twice. On the left, a hologram: the frame cut
        into stacked planes that slide against each other as you move. On the
        right, a point cloud: every dot sitting at the true depth the
        photograph holds, baked from its depth pass. One fakes relief
        beautifully; the other actually has it. Sweep across a plate to orbit
        it; release mid-turn and it carries, then settles. On a phone, the
        clouds roll with the page. Reduced motion holds a still frame.
      </p>
      <p class="font-serif italic text-sm text-mute max-w-2xl mt-4">
        One photograph in. A depth estimate per pixel. The image cut into
        planes or scattered into points, displaced along the axis the camera
        never recorded.
      </p>
      <div class="depth-switch glass-chip-rail mt-8" role="group" aria-label="Depth study">
        {ROWS.map((row, i) => (
          <button
            type="button"
            class="depth-switch__btn"
            data-study={row.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {row.label.split(' · ')[0]}
          </button>
        ))}
      </div>
    </div>
    <div class="container-wide mt-8 sm:mt-10">
      <ul class="depth-index">
        {ROWS.map((row, i) => (
          <li class:list={['depth-index__item', { 'is-shown': i === 0 }]} data-study-note={row.id}>
            <p class="eyebrow mb-2">{row.label}</p>
            <p class="text-sm opacity-55 max-w-xl">{row.note}</p>
          </li>
        ))}
      </ul>
      <div class="study-grid grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-start mt-8" data-depth-slot>
        <div>
          <p class="plate-tag">Hologram · stacked planes</p>
          <div data-depth-hologram>
            <KineticPlate category="earth" />
          </div>
        </div>
        <div class="study-3d">
          <p class="plate-tag">Point cloud · true depth</p>
          <div data-depth-cloud>
            <KineticPlate3D category="earth" />
          </div>
        </div>
      </div>
      {ROWS.map((row) => (
        <template data-study-tpl={row.id}>
          <div data-part="hologram">
            <KineticPlate category={row.id} />
          </div>
          <div data-part="cloud">
            <KineticPlate3D category={row.id} />
          </div>
        </template>
      ))}
    </div>
  </section>

  <section class="py-12 sm:py-16 md:py-24 section-light">
    <div class="container-narrow mb-10 sm:mb-14">
      <h2 class="t-sub font-serif mb-3 sm:mb-4">Texture and Gaussian studies</h2>
      <p class="text-sm sm:text-base opacity-55 max-w-xl">
        The depth work above feeds these. Wallpapers, textures, and color palettes drawn from single frames, free to take.
      </p>
      <p class="font-serif italic text-sm text-mute max-w-xl mt-4">
        The blur behind each plate is a Gaussian convolution, the
        closed-form solution to the heat equation. Light diffuses through the
        glass the way heat moves through a solid.
      </p>
    </div>
    <div class="container-wide space-y-16 sm:space-y-24 md:space-y-28">
      <div class="reveal"><LiquidPlate src="img-2528" alt="A ribbon of light drawn in the dark" label="Ribbon" note="A ribbon of light drawn in the dark." index={0} /></div>
      <div class="reveal"><LiquidPlate src="dsc-0014" alt="A carved ram emerging from black" label="Ram" note="A carved ram emerging from black." index={1} reverse /></div>
      <div class="reveal"><LiquidPlate src="dscf1022" alt="A wall combed into vertical ribs of light and shadow" label="Stone" note="A wall, raked into ribs of light." index={2} /></div>
    </div>
  </section>

  <ReliefStudies />

  <section class="py-14 sm:py-20">
    <div class="container-narrow">
      <div class="border-t border-white/5 pt-8 sm:pt-10 max-w-2xl">
        <p class="eyebrow mb-3">The envelope</p>
        <p class="text-sm sm:text-base opacity-55 leading-relaxed">
          Every material on this site holds calibrated bounds: blur no higher
          than 44 pixels, saturation no higher than 1.85, text contrast at or
          above 4.5:1 at every tested opacity. Settings that survived a sweep,
          not settings that looked good once.
        </p>
      </div>
    </div>
  </section>

<script>
  import { initDepthStudy } from '../scripts/depth-study';

  const flag = window as Window & { __beyondDepth?: boolean };
  initDepthStudy();
  if (!flag.__beyondDepth) {
    flag.__beyondDepth = true;
    document.addEventListener('astro:after-swap', initDepthStudy);
  }
</script>
</BaseLayout>
