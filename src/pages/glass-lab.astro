---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPillGL from '../components/GlassPillGL.astro';

// Unlinked, noindexed shader-glass bench. Side-by-side: the site's CSS
// glass (material tokens) beside three grades of true refractive glass,
// over the same photograph, for John's in-browser judgement.
// Same production gate as about-lab (P1 lock pattern, 2026-07-19): on the
// main branch this route is a plain redirect home; preview branches and
// local builds keep the full bench.
// Pages production (main, or missing branch) never emits the lab.
// Local and CI omit CF_PAGES, so tests still see the full bench.
if (process.env.CF_PAGES === '1' && (process.env.CF_PAGES_BRANCH || 'main') === 'main') {
  return Astro.redirect('/', 308);
}
---

<BaseLayout
  title="Glass Lab"
  description="Private shader-glass bench."
  noindex={true}
>
  {/* STATEMENT */}
  <section class="py-12 sm:py-16 md:py-20">
    <div class="container-narrow">
      <p class="eyebrow mb-3 sm:mb-4">Lab &middot; Shader Glass</p>
      <h1 class="mb-5 sm:mb-7">Glass that bends the work</h1>
      <p class="font-serif italic text-sm text-cream/45 max-w-2xl mb-6">
        A fragment shader evaluating a material response per-pixel is field
        computation on a uniform grid.
      </p>
      <div class="prose max-w-2xl">
        <p>
          Four pills over the same photograph. The first is the site's
          current material: CSS glass, tokens and hairlines. The other three
          are true refractive glass, written from first principles: the
          photograph itself is re-sampled through a curved surface, so the
          wall's ribs bend at the rim the way they would through a real
          lens. Judge them against each other, over the same light.
        </p>
      </div>
    </div>
  </section>

  {/* THE BENCH - one photograph, four materials */}
  <section class="relative overflow-hidden" data-glass-bench>
    <div class="relative min-h-[70vh] sm:min-h-[78vh]">
      <picture>
        <source
          type="image/avif"
          srcset="/images/photography/gallery/dscf1022.avif 1200w, /images/photography/hero/dscf1022.avif 2400w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/photography/gallery/dscf1022.webp 1200w, /images/photography/hero/dscf1022.webp 2400w"
          sizes="100vw"
        />
        <img
          src="/images/photography/hero/dscf1022.webp"
          alt="A wall combed into vertical ribs of light and shadow"
          class="absolute inset-0 w-full h-full object-cover"
          fetchpriority="high"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/70 via-transparent to-[#0a0a0a]/30"></div>

      <div class="relative z-10 min-h-[70vh] sm:min-h-[78vh] flex items-center">
        <div class="container-narrow w-full">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-x-8 gap-y-10 items-start">
            <div class="flex flex-col items-start gap-3">
              <a href="mailto:jndwcreative@gmail.com" class="btn btn-outline btn-sm">
                Inquire
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </a>
              <p class="plate-tag">Reference &middot; CSS glass, today's material</p>
            </div>
            <div class="flex flex-col items-start gap-3">
              <GlassPillGL label="Inquire" variant="c" />
              <p class="plate-tag">The material &middot; your Line, locked</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* BENCH II - the home hero's own ground. Tune where it will live. */}
  <section class="relative overflow-hidden" data-glass-bench>
    <div class="relative min-h-[55vh] sm:min-h-[65vh]">
      <picture>
        <source type="image/avif" srcset="/images/photography/gallery/7r52326.avif 1200w, /images/photography/hero/7r52326.avif 2400w" sizes="100vw" />
        <source type="image/webp" srcset="/images/photography/gallery/7r52326.webp 1200w, /images/photography/hero/7r52326.webp 2400w" sizes="100vw" />
        <img src="/images/photography/hero/7r52326.webp" alt="Towering cumulus clouds against a dark sky" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a]/80 via-transparent to-[#0a0a0a]/40"></div>
      <div class="relative z-10 min-h-[55vh] sm:min-h-[65vh] flex items-center">
        <div class="container-narrow w-full">
          <div class="flex flex-col sm:flex-row gap-6 sm:gap-10 items-start">
            <div class="flex flex-col items-start gap-3">
              <GlassPillGL label="About me" variant="c" />
              <p class="plate-tag">Over the hero's own cloud</p>
            </div>
            <div class="flex flex-col items-start gap-3">
              <GlassPillGL label="Photography" variant="c" />
              <p class="plate-tag">The promotion, as it ships</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* THE CONSOLE - your eye drives; screenshot or copy the numbers back. */}
  <section class="py-10 sm:py-14" data-glass-tune>
    <div class="container-narrow">
      <div class="border-t border-white/5 pt-8 max-w-2xl">
        <p class="eyebrow mb-4">The console</p>
        <p class="text-sm opacity-55 mb-6">Every slider drives the live shader on all six pills above. When it looks right, copy the line below the sliders and send it back - the values get locked into the site.</p>
        <div id="tune-panel" class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-5 max-w-xl text-sm"></div>
        <p class="mt-6 text-[11px] tracking-[0.14em] uppercase opacity-45">The line</p>
        <code id="tune-readout" class="block mt-2 text-xs opacity-80 select-all break-all"></code>
      </div>
    </div>
  </section>

  {/* THE WORKING */}
  <section class="py-14 sm:py-20">
    <div class="container-narrow">
      <div class="border-t border-white/5 pt-8 sm:pt-10 max-w-2xl">
        <p class="eyebrow mb-3">The working</p>
        <p class="text-sm sm:text-base opacity-55 leading-relaxed mb-4">
          Snell's law through one thin interface, per color channel, so the
          red, green, and blue rays part company at the rim. Schlick's
          approximation of Fresnel reflectance holds the cream edge. The
          surface is a signed-distance capsule whose curvature is a Gaussian
          bump at the rim: lens at the edges, clear in the middle. The
          pointer light falls off as a Gaussian, the same kernel as the
          blur in the Beyond envelope.
        </p>
        <p class="text-sm sm:text-base opacity-55 leading-relaxed">
          The backdrop is the photograph itself, re-sampled from the known
          asset with the crop geometry computed, never captured from the
          page. Without WebGL2 the pill falls back to the site's CSS glass.
          Under reduced motion it renders one still frame and stops the
          clock. Offscreen it costs nothing.
        </p>
      </div>
    </div>
  </section>

<script>
  /* The console: sliders -> live uniforms via window.__glassTune. */
  const KNOBS: Array<[string, string, number, number, number, number]> = [
    // uniform, label, min, max, step, default
    ['uRidge', 'Wall inset', 0.0, 0.10, 0.002, 0.016],
    ['uSigma', 'Wall width', 0.004, 0.10, 0.002, 0.020],
    ['uSlope', 'Bend', 0.0, 3.5, 0.05, 2.1],
    ['uRim', 'Edge light', 0.0, 1.6, 0.05, 0.9],
    ['uSmokeMax', 'Smoke', 0.0, 0.5, 0.01, 0.18],
    ['uGrad', 'Crown gradient', 0.0, 1.0, 0.05, 1.0],
  ];
  function initConsole() {
    const panel = document.getElementById('tune-panel');
    const readout = document.getElementById('tune-readout');
    if (!panel || !readout || panel.childElementCount > 0) return;
    const state: Record<string, number> = {};
    const update = () => {
      readout.textContent = Object.entries(state)
        .map(([k, v]) => `${k}=${v.toFixed(3)}`)
        .join('  ');
    };
    KNOBS.forEach(([name, label, min, max, step, def]) => {
      state[name] = def;
      const wrap = document.createElement('label');
      wrap.className = 'flex flex-col gap-1.5';
      const row = document.createElement('span');
      row.className = 'flex justify-between opacity-70';
      const t = document.createElement('span'); t.textContent = label;
      const val = document.createElement('span'); val.textContent = String(def);
      row.append(t, val);
      const input = document.createElement('input');
      input.type = 'range';
      input.min = String(min); input.max = String(max); input.step = String(step); input.value = String(def);
      input.addEventListener('input', () => {
        const v = parseFloat(input.value);
        state[name] = v; val.textContent = v.toFixed(3);
        (window as any).__glassTune?.(name, v);
        update();
      });
      wrap.append(row, input);
      panel.append(wrap);
    });
    update();
  }
  document.addEventListener('astro:page-load', initConsole);
</script>

</BaseLayout>
