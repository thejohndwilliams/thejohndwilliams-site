---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/john-davis-williams/',
    description: 'Professional network',
    icon: '/images/previews/linkedin.svg',
    hero: '/images/linkedin-hero.webp',
    heroFallback: '/images/linkedin-hero.jpg'
  },
  {
    name: 'GitHub',
    url: 'https://github.com/thejohndwilliams',
    description: 'Code & projects',
    icon: '/images/previews/github.svg',
    hero: '/images/github-hero.webp',
    heroFallback: '/images/github-hero.jpg'
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/thejohndwilliams/',
    description: 'Visual journal',
    icon: '/images/previews/instagram.svg',
    hero: '/images/instagram-hero.webp',
    heroFallback: '/images/instagram-hero.jpg'
  },
  {
    name: 'Behance',
    url: 'https://www.behance.net/killthewizard',
    description: 'Design work',
    icon: '/images/previews/behance.svg',
    hero: '/images/behance-hero.webp',
    heroFallback: '/images/behance-hero.jpg'
  }
];
---

<BaseLayout title="Home" description="Film graduate, cybersecurity MBA, SpaceX engineer, nature photographer. Liberal arts meets technology.">

  <!-- HERO — Full-bleed cloudscape with centered identity -->
  <section class="relative min-h-[70vh] sm:min-h-[80vh] md:min-h-[90vh] flex items-center justify-center overflow-hidden">
    <img
      src="/images/photography/gallery/7r52326.webp"
      srcset="/images/photography/thumb/7r52326.webp 400w, /images/photography/gallery/7r52326.webp 1200w, /images/photography/hero/7r52326.webp 2400w"
      sizes="100vw"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-40"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/60 via-transparent to-[#0a0a0a]"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <div class="reveal">
        <p class="text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-40 mb-4 sm:mb-6 font-light">DATA &middot; SECURITY &middot; DECISIONS</p>
        <h1 class="text-title md:text-headline mb-6 sm:mb-8 font-serif tracking-tight" transition:name="site-title">John D. Williams</h1>
        <p class="text-base sm:text-lg md:text-xl opacity-50 leading-relaxed max-w-2xl mx-auto mb-8 sm:mb-12">
          Film graduate. Cybersecurity MBA. SpaceX engineer.
          <span class="hidden sm:inline"><br /></span>
          Nature photographer. Building at the intersection.
        </p>
      </div>

      <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center max-w-sm sm:max-w-none mx-auto">
        <a href="/about" class="btn btn-primary w-full sm:w-auto justify-center">
          About me
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="mailto:hello@thejohndwilliams.com" class="btn btn-outline w-full sm:w-auto justify-center">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- NAVIGATION CARDS — progressive disclosure -->
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-narrow">
      <p class="text-subhead mb-6 sm:mb-8 reveal">The Work</p>
      <div class="stagger-children grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        <a href="/about" class="press-feedback group relative block rounded-card overflow-hidden aspect-[16/9] sm:aspect-[4/3] ring-1 ring-white/5 hover:ring-gold/30 active:ring-gold/40 transition-all duration-500">
          <img
            src="/images/photography/gallery/7r52258.webp"
            srcset="/images/photography/thumb/7r52258.webp 400w, /images/photography/gallery/7r52258.webp 1200w"
            sizes="(max-width: 639px) 100vw, 33vw"
            alt="" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
            <h2 class="text-lg font-serif mb-1 group-hover:text-gold transition-colors duration-300">About</h2>
            <p class="text-xs opacity-40">The intersection of film, security, and light</p>
          </div>
        </a>
        <a href="/work" class="press-feedback group relative block rounded-card overflow-hidden aspect-[16/9] sm:aspect-[4/3] ring-1 ring-white/5 hover:ring-gold/30 active:ring-gold/40 transition-all duration-500">
          <img
            src="/images/photography/gallery/dscf0530.webp"
            srcset="/images/photography/thumb/dscf0530.webp 400w, /images/photography/gallery/dscf0530.webp 1200w"
            sizes="(max-width: 639px) 100vw, 33vw"
            alt="" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
            <h2 class="text-lg font-serif mb-1 group-hover:text-gold transition-colors duration-300">Work</h2>
            <p class="text-xs opacity-40">Data, security, and operational systems</p>
          </div>
        </a>
        <a href="/photography" class="press-feedback group relative block rounded-card overflow-hidden aspect-[16/9] sm:aspect-[4/3] ring-1 ring-white/5 hover:ring-gold/30 active:ring-gold/40 transition-all duration-500">
          <img
            src="/images/photography/gallery/dscf0952.webp"
            srcset="/images/photography/thumb/dscf0952.webp 400w, /images/photography/gallery/dscf0952.webp 1200w"
            sizes="(max-width: 639px) 100vw, 33vw"
            alt="" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
            <h2 class="text-lg font-serif mb-1 group-hover:text-gold transition-colors duration-300">Photography</h2>
            <p class="text-xs opacity-40">Looking up. Looking close.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- SOCIAL TILES — bento grid with hero images -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container-narrow">
      <p class="text-subhead mb-6 sm:mb-8 reveal">Connect</p>
      <div class="stagger-children grid grid-cols-2 gap-2 sm:gap-3 md:gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block rounded-card overflow-hidden aspect-square sm:aspect-[16/10] ring-1 ring-white/5 hover:ring-gold/30 active:ring-gold/40 transition-all duration-500"
          >
            <picture>
              <source srcset={link.hero} type="image/webp" />
              <img
                src={link.heroFallback}
                alt=""
                class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 md:p-6">
              <div class="flex items-center gap-2 sm:gap-3">
                <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-lg bg-white/10 backdrop-blur-sm p-1 sm:p-1.5 flex-shrink-0 ring-1 ring-white/10">
                  <img src={link.icon} alt="" class="w-full h-full object-contain" />
                </div>
                <div>
                  <span class="font-medium text-xs sm:text-sm text-white">{link.name}</span>
                  <p class="text-[10px] sm:text-xs opacity-50 hidden sm:block">{link.description}</p>
                </div>
              </div>
            </div>
            <div class="absolute top-3 right-3 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FOOTER SCRIPTURE -->
  <section class="pb-16 text-center">
    <p class="text-sm opacity-30 italic font-serif">John 15:13</p>
  </section>

</BaseLayout>
