---
import SocialIcon from '../components/SocialIcon.astro';
import { socialLinks } from '../utils/date';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPillGL from '../components/GlassPillGL.astro';
import { bleedSizes, CHARITY_NARROW_SIZES, CHARITY_WIDE_SIZES, heroCapClass, photoSrcset, portraitSizes, portraitSrcset, WORK_TILE_NARROW_SIZES, WORK_TILE_WIDE_SIZES } from '../utils/photo-src';

const charities = [
  {
    name: 'Global Christian Relief',
    mission: 'Support for the persecuted Church.',
    url: 'https://www.globalchristianrelief.org/',
    image: 'img-7029-hdr-enhanced',
    alt: 'Clouds parting over a deep blue sky, light breaking through'
  },
  {
    name: 'Restoring Faith',
    mission: 'Faith-based recovery and renewal.',
    url: 'https://www.restoringfaithinc.org/',
    image: '7r51108-enhanced-sr',
    alt: 'Sunlight filtering through a tree canopy'
  },
  {
    name: 'STCH Ministries',
    mission: 'Refuge and care for children in need.',
    url: 'https://www.stchm.org/',
    image: 'dscf0783',
    alt: 'Looking up through a bamboo canopy'
  },
  {
    name: 'St. Jude',
    mission: 'Treatment and research; no family ever billed.',
    url: 'https://www.stjude.org/',
    image: '7r51505-enhanced-sr',
    alt: 'A bee tending a lemon blossom in dark leaves'
  }
];

---

<BaseLayout title="Home" description="Making visible: threats on a network, patterns in data, light on a moment. Photography, cybersecurity, and data by John D. Williams." ogImage="/og/pages/home.jpg" ogImageWidth={1200} ogImageHeight={630} lcpImage="7r52326" lcpImagePortrait="7r52326" lcpImageSizes={bleedSizes('7r52326')}>

  {/* HERO - Full-bleed cloudscape with left-aligned identity.
      The section stops at the bitmap width. Phone art direction keeps its own crop. */}
  <section class:list={['hero-bleed', heroCapClass('7r52326'), 'relative min-h-[65vh] sm:min-h-[75vh] md:min-h-[80vh] flex items-end overflow-hidden']} data-glass-bench>
    <picture>
      <source media="(max-width: 640px)" type="image/avif" srcset={portraitSrcset('7r52326', 'avif')} sizes={portraitSizes('7r52326')} />
      <source media="(max-width: 640px)" type="image/webp" srcset={portraitSrcset('7r52326', 'webp')} sizes={portraitSizes('7r52326')} />
      <source
        type="image/avif"
        srcset={photoSrcset('7r52326', 'avif')}
        sizes={bleedSizes('7r52326')}
      />
      <source
        type="image/webp"
        srcset={photoSrcset('7r52326', 'webp')}
        sizes={bleedSizes('7r52326')}
      />
      <img
        src="/images/photography/hero/7r52326.webp"
        alt="Dramatic cloudscape with towering cumulus clouds illuminated against a dark sky"
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
        id="hero-img"
        data-dawn="/images/photography/hero/img-3058.webp"
        data-midday="/images/photography/hero/7r52326.webp"
        data-golden="/images/photography/hero/img-6552.webp"
        data-night="/images/photography/hero/7r52268.webp"
      />
    </picture>
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.78) 22%, rgba(10,10,10,0.56) 44%, rgba(10,10,10,0.28) 68%, rgba(10,10,10,0) 100%);"
    ></div>
    <div class="hero-lockup relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-12 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">making visible</p>
        <h1 class="t-title mb-4 sm:mb-5 font-serif tracking-tight">John D. Williams</h1>
        <p class="text-base leading-relaxed max-w-xl mb-6 sm:mb-8">
          Operations, risk and controls. Fine-art photographer.
        </p>
      </div>

      {/* Glass Build B promotion (owner verdict 2026-08-01: variant C).
          The cloud complications become true refractive glass - the pills
          bend the hero photograph behind them, per the June ruling. Both are
          secondaries; the nav's ivory key keeps the single flame. On touch
          or low tiers the component leaves the token CSS pill. */}
      <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-3 sm:gap-4 max-w-sm sm:max-w-none">
        <GlassPillGL label="About me" variant="c" href="/about/" class="w-full sm:w-auto justify-center" />
        <GlassPillGL label="Photography" variant="c" href="/photography/" class="w-full sm:w-auto justify-center" />
      </div>
    </div>
  </section>


  {/* IN SERVICE - charitable organizations, staggered bento */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">In Service</h2>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-3 md:gap-5">
        {charities.map((org, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          const sizes = isWide ? CHARITY_WIDE_SIZES : CHARITY_NARROW_SIZES;
          return (
            <a
              href={org.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-square sm:aspect-[16/10] ${mdAspect} ${mdSpan} ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-[box-shadow,transform,outline,outline-offset] duration-500 ease-smooth`}
            >
              <picture>
                <source type="image/avif" srcset={photoSrcset(org.image, 'avif')} sizes={sizes} />
                <source type="image/webp" srcset={photoSrcset(org.image, 'webp')} sizes={sizes} />
                <img
                  src={`/images/photography/hero/${org.image}.webp`}
                  alt={org.alt}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 group-focus-visible:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10"></div>
              <div class="absolute bottom-0 left-0 right-0 z-10 p-3 sm:p-5 md:p-6">
                <h3 class="t-sub font-serif mb-0.5 sm:mb-1 text-cream">{org.name}</h3>
                <p class="text-sm md:text-base hidden sm:block">{org.mission}</p>
              </div>
              <div class="absolute top-3 right-3 z-10 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 group-focus-visible:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* NAVIGATION CARDS - bento grid with visual hierarchy */}
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">The Work</h2>
      <div class="stagger-children grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-5">
        {/* Photography - the flagship. Spans all three rows of the right-hand
            stack; the image is absolutely positioned so the three 16:10 cards
            alone define the grid's row heights. */}
        <a href="/photography/" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[4/5] md:aspect-auto md:row-span-3 md:col-span-7 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-[box-shadow,transform,outline,outline-offset] duration-500 ease-smooth">
          <picture>
            <source type="image/avif" srcset={photoSrcset('7r51848', 'avif')} sizes={WORK_TILE_WIDE_SIZES} />
            <source type="image/webp" srcset={photoSrcset('7r51848', 'webp')} sizes={WORK_TILE_WIDE_SIZES} />
            <img
              src="/images/photography/hero/7r51848.webp"
              alt="A storm shelf at dusk, one ember of sunset at the horizon"
              class="absolute inset-0 w-full h-full object-cover object-[center_62%] transition-transform duration-700 ease-smooth group-hover:scale-105 group-focus-visible:scale-105"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 z-10 p-5 sm:p-6 md:p-8">
            <h3 class="t-sub font-serif mb-1.5 group-hover:text-cream group-focus-visible:text-cream transition-colors duration-300">Photography</h3>
            <p class="text-sm sm:text-base">Sky, earth, water, structure, light.</p>
          </div>
        </a>
        {/* About */}
        <a href="/about/" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-[box-shadow,transform,outline,outline-offset] duration-500 ease-smooth">
          <picture>
            <source type="image/avif" srcset={photoSrcset('img-0132', 'avif')} sizes={WORK_TILE_NARROW_SIZES} />
            <source type="image/webp" srcset={photoSrcset('img-0132', 'webp')} sizes={WORK_TILE_NARROW_SIZES} />
            <img
              src="/images/photography/hero/img-0132.webp"
              alt="A crystal chandelier lit low in a dark hall"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 group-focus-visible:scale-105"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 z-10 p-5 sm:p-6">
            <h3 class="t-sub font-serif mb-1 group-hover:text-cream group-focus-visible:text-cream transition-colors duration-300">About</h3>
            <p class="text-base">Operations, risk and controls. Film-trained eye.</p>
          </div>
        </a>
        {/* Work */}
        <a href="/work/" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-[box-shadow,transform,outline,outline-offset] duration-500 ease-smooth">
          <picture>
            <source type="image/avif" srcset={photoSrcset('dscf1928', 'avif')} sizes={WORK_TILE_NARROW_SIZES} />
            <source type="image/webp" srcset={photoSrcset('dscf1928', 'webp')} sizes={WORK_TILE_NARROW_SIZES} />
            <img
              src="/images/photography/hero/dscf1928.webp"
              alt="Windows lit at dusk across the water"
              class="absolute inset-0 w-full h-full object-cover object-[center_32%] transition-transform duration-700 ease-smooth group-hover:scale-105 group-focus-visible:scale-105"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 z-10 p-5 sm:p-6">
            <h3 class="t-sub font-serif mb-1 group-hover:text-cream group-focus-visible:text-cream transition-colors duration-300">Work</h3>
            <p class="text-sm sm:text-base">Data, security, operations.</p>
          </div>
        </a>
        {/* Relief - the object axis. The asset is a purpose-rendered 16:10
            detail of the carved hull (native 1280x800). max-w keeps the tile
            inside that bitmap. */}
        <a href="/beyond/" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 max-w-[1280px] ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-[box-shadow,transform,outline,outline-offset] duration-500 ease-smooth">
          <picture>
            <source type="image/avif" srcset="/images/relief/card.avif" />
            <img src="/images/relief/card.webp" alt="A tower carved as plaster relief, raked by one low light" width="1280" height="800" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 group-focus-visible:scale-105" loading="lazy" decoding="async" />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 z-10 p-5 sm:p-6">
            <h3 class="t-sub font-serif mb-1 group-hover:text-cream group-focus-visible:text-cream transition-colors duration-300">Beyond</h3>
            <p class="text-base">Depth, holograms, and a photograph cut as a surface.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* SOCIAL TILES - bento grid with alternating spans */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">Connect</h2>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-3 md:gap-5">
        {socialLinks.map((link, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`glass-luminous group relative block rounded-card overflow-hidden aspect-square sm:aspect-[16/10] ${mdAspect} ${mdSpan} ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-[box-shadow,outline,outline-offset] duration-500 ease-smooth`}
            >
              <picture>
                <source srcset={link.hero} type="image/webp" />
                <img
                  src={link.heroFallback}
                  alt={link.heroAlt}
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 md:p-6">
                <div class="flex items-center gap-2 sm:gap-3">
                  <SocialIcon
                    name={link.name.toLowerCase()}
                    class="w-5 h-5 sm:w-7 sm:h-7 flex-shrink-0 text-cream group-hover:text-cream transition-colors duration-300"
                  />
                  <div>
                    <span class="font-medium text-sm sm:text-base text-cream">{link.name}</span>
                    <p class="text-sm md:text-base text-mute hidden sm:block">{link.description}</p>
                  </div>
                </div>
              </div>
              <div class="absolute top-3 right-3 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    import photoDims from '../data/photo-dimensions.json';

    // Time-aware hero. The static midday photograph (7r52326) is the LCP
    // image and stays in the markup. After load, a wide viewport may dissolve
    // once to the visitor's local slot. Phones keep the portrait source.
    //
    // CRITICAL: the fetch starts only after load, on idle, so the initial
    // paint uses the preloaded LCP image. Mutating img.src before LCP fires
    // invalidates the preload and tanks lcp-discovery-insight (#20).
    //
    // getAttribute('src') is the raw relative path. img.src is absolute and
    // would not match the dataset, which re-downloaded midday.
    //
    // prefers-reduced-motion: the swap is skipped entirely. No clone, no cut.
    // The midday frame stays. document.hidden and viewports under 641px skip
    // the same way. A later client return to Home applies the already chosen
    // slot in astro:before-swap, so the incoming document never paints midday.

    let chosenSlot: string | null = null;
    let committed = false;
    let heroGen = 0;
    let heroAbort: AbortController | null = null;

    function slotFromHour(h: number): string {
      if (h >= 5 && h < 11) return 'dawn';
      if (h >= 11 && h < 16) return 'midday';
      if (h >= 16 && h < 20) return 'golden';
      return 'night';
    }

    function writeSlot(img: HTMLImageElement, src: string) {
      img.src = src;
      const picture = img.closest('picture');
      if (!picture) return;
      const stem = (src.split('/').pop() || '').replace(/\.webp$/i, '');
      const row = (photoDims as Record<string, { thumb: { w: number }; gallery: { w: number }; hero: { w: number } }>)[stem];
      if (!row) return;
      picture.querySelectorAll('source').forEach((s) => {
        if (s.hasAttribute('media')) return;
        const ext = s.getAttribute('type') === 'image/avif' ? 'avif' : 'webp';
        s.srcset = [
          `/images/photography/thumb/${stem}.${ext} ${row.thumb.w}w`,
          `/images/photography/gallery/${stem}.${ext} ${row.gallery.w}w`,
          `/images/photography/hero/${stem}.${ext} ${row.hero.w}w`,
        ].join(', ');
        s.setAttribute('sizes', `min(100vw, ${row.hero.w}px)`);
      });
      const section = img.closest('section');
      if (!section) return;
      section.classList.remove('hero-cap-2048', 'hero-cap-2400');
      section.classList.add(`hero-cap-${row.hero.w}`);
    }

    function stemOf(src: string): string {
      const file = src.split('/').pop() || '';
      return file.replace(/\.(webp|avif|jpe?g)$/i, '');
    }

    function decodeTarget(img: HTMLImageElement, slotSrc: string): string {
      const stem = stemOf(slotSrc);
      const current = img.currentSrc;
      if (!current) return slotSrc;
      try {
        const url = new URL(current, window.location.href);
        if (!/\.(avif|webp|jpe?g)$/i.test(url.pathname)) return slotSrc;
        url.pathname = url.pathname.replace(/[^/]+(?=\.(avif|webp|jpe?g)$)/i, stem);
        return url.pathname + url.search;
      } catch {
        return slotSrc;
      }
    }

    function skipMotion(): boolean {
      if (window.matchMedia('(max-width: 640px)').matches) return true;
      if (document.hidden) return true;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return true;
      return false;
    }

    function onBeforeSwap(ev: Event & { newDocument?: Document }) {
      if (!chosenSlot || chosenSlot === 'midday') return;
      const doc = ev.newDocument;
      if (!doc || typeof doc.getElementById !== 'function') return;
      const img = doc.getElementById('hero-img');
      if (!img || img.tagName !== 'IMG') return;
      const src = (img as HTMLImageElement).dataset[chosenSlot];
      if (!src || img.getAttribute('src') === src) return;
      writeSlot(img as HTMLImageElement, src);
    }

    function initTimeHero() {
      const gen = ++heroGen;
      if (heroAbort) heroAbort.abort();
      heroAbort = new AbortController();
      const signal = heroAbort.signal;

      const found = document.getElementById('hero-img');
      if (!found || found.tagName !== 'IMG') return;
      const img = found as HTMLImageElement;
      if (skipMotion()) return;

      const slot = chosenSlot || slotFromHour(new Date().getHours());
      const src = img.dataset[slot];
      if (!src) return;
      chosenSlot = slot;

      if (img.getAttribute('src') === src) {
        committed = true;
        return;
      }

      if (committed) {
        writeSlot(img, src);
        return;
      }

      const start = () => {
        if (signal.aborted || gen !== heroGen) return;
        void runFade(img, src, gen, signal);
      };

      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(start, { timeout: 3000 });
      } else {
        window.setTimeout(start, 2000);
      }
    }

    async function runFade(img: HTMLImageElement, src: string, gen: number, signal: AbortSignal) {
      const url = decodeTarget(img, src);
      const next = new Image();
      next.setAttribute('fetchpriority', 'low');
      next.src = url;
      try {
        await next.decode();
      } catch {
        if (!next.complete || next.naturalWidth === 0) return;
      }
      if (signal.aborted || gen !== heroGen || !img.isConnected || committed) return;

      const clone = document.createElement('img');
      clone.className = 'hero-xfade';
      clone.alt = '';
      clone.setAttribute('aria-hidden', 'true');
      clone.decoding = 'sync';
      clone.src = url;
      const picture = img.closest('picture');
      (picture || img).insertAdjacentElement('afterend', clone);

      const drop = () => {
        if (clone.isConnected) clone.remove();
      };
      signal.addEventListener('abort', drop, { once: true });

      requestAnimationFrame(() => {
        if (signal.aborted || gen !== heroGen) return;
        requestAnimationFrame(() => {
          if (signal.aborted || gen !== heroGen) return;
          clone.classList.add('is-shown');
        });
      });

      let settled = false;
      const fallback = window.setTimeout(() => { finish(); }, 1900);
      const stem = stemOf(src);

      function showingNext(): boolean {
        if (!img.complete || img.naturalWidth === 0 || !img.currentSrc) return false;
        return img.currentSrc.includes(stem);
      }

      let published = false;
      function publish() {
        if (published || gen !== heroGen || !img.isConnected) return;
        published = true;
        img.dispatchEvent(new Event('hero-slot-commit'));
        drop();
      }

      function finish() {
        if (settled) return;
        settled = true;
        window.clearTimeout(fallback);
        if (signal.aborted || gen !== heroGen || !img.isConnected) {
          drop();
          return;
        }
        writeSlot(img, src);
        committed = true;
        if (showingNext()) {
          publish();
          return;
        }
        const onLoad = () => {
          if (showingNext()) publish();
        };
        img.addEventListener('load', onLoad, { signal });
        window.setTimeout(() => {
          if (published || gen !== heroGen) return;
          publish();
        }, 1600);
      }

      clone.addEventListener('transitionend', (e) => {
        if (e.target !== clone) return;
        if (e.propertyName !== 'opacity') return;
        finish();
      }, { signal });
    }

    const bound = window as Window & { __timeHeroBound?: boolean };
    if (!bound.__timeHeroBound) {
      bound.__timeHeroBound = true;
      document.addEventListener('astro:before-swap', onBeforeSwap as EventListener);
      document.addEventListener('astro:after-swap', initTimeHero);
      if (document.readyState === 'complete') initTimeHero();
      else window.addEventListener('load', initTimeHero, { once: true });
    }
  </script>

</BaseLayout>
