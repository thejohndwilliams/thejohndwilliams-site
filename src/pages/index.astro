---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/john-davis-williams/',
    description: 'Professional network',
    icon: '/images/previews/linkedin.svg',
    hero: '/images/linkedin-hero.webp',
    heroFallback: '/images/linkedin-hero.jpg'
  },
  {
    name: 'GitHub',
    url: 'https://github.com/thejohndwilliams',
    description: 'Code & projects',
    icon: '/images/previews/github.svg',
    hero: '/images/github-hero.webp',
    heroFallback: '/images/github-hero.jpg'
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/thejohndwilliams/',
    description: 'Visual journal',
    icon: '/images/previews/instagram.svg',
    hero: '/images/instagram-hero.webp',
    heroFallback: '/images/instagram-hero.jpg'
  },
  {
    name: 'Behance',
    url: 'https://www.behance.net/killthewizard',
    description: 'Design work',
    icon: '/images/previews/behance.svg',
    hero: '/images/behance-hero.webp',
    heroFallback: '/images/behance-hero.jpg'
  }
];
---

<BaseLayout title="Home" description="Film graduate, cybersecurity MBA, SpaceX engineer, nature photographer. Liberal arts meets technology.">

  <!-- HERO — Full-bleed cloudscape with centered identity -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <img
      src="/images/photography/hero/7r52326.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-40"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/60 via-transparent to-[#0a0a0a]"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
      <div class="reveal">
        <p class="text-xs tracking-[0.3em] uppercase opacity-40 mb-6 font-light">DATA &middot; SECURITY &middot; DECISIONS</p>
        <h1 class="text-title md:text-headline mb-8 font-serif tracking-tight" transition:name="site-title">John D. Williams</h1>
        <p class="text-lg md:text-xl opacity-50 leading-relaxed max-w-2xl mx-auto mb-12">
          Film graduate. Cybersecurity MBA. SpaceX engineer.<br class="hidden md:block" />
          Nature photographer. Building at the intersection.
        </p>
      </div>

      <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/about" class="btn btn-primary">
          About me
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="mailto:hello@thejohndwilliams.com" class="btn btn-outline">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- NAVIGATION CARDS — progressive disclosure -->
  <section class="section-light py-16 md:py-24">
    <div class="container-narrow">
      <p class="text-subhead mb-8 reveal">Explore</p>
      <div class="stagger-children grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/about" class="group relative block rounded-card overflow-hidden aspect-[4/3] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500">
          <img src="/images/photography/gallery/7r52258.webp" alt="" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h2 class="text-lg font-serif mb-1 group-hover:text-gold transition-colors duration-300">About</h2>
            <p class="text-xs opacity-40">Background, philosophy, credentials</p>
          </div>
        </a>
        <a href="/work" class="group relative block rounded-card overflow-hidden aspect-[4/3] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500">
          <img src="/images/photography/gallery/dscf0530.webp" alt="" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h2 class="text-lg font-serif mb-1 group-hover:text-gold transition-colors duration-300">Work</h2>
            <p class="text-xs opacity-40">Projects I have built and shipped</p>
          </div>
        </a>
        <a href="/photography" class="group relative block rounded-card overflow-hidden aspect-[4/3] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500">
          <img src="/images/photography/gallery/dscf0952.webp" alt="" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h2 class="text-lg font-serif mb-1 group-hover:text-gold transition-colors duration-300">Photography</h2>
            <p class="text-xs opacity-40">Sky, earth, water, structure, light</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- SOCIAL TILES — bento grid with hero images -->
  <section class="py-16 md:py-24">
    <div class="container-narrow">
      <p class="text-subhead mb-8 reveal">Elsewhere</p>
      <div class="stagger-children grid grid-cols-1 sm:grid-cols-2 gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block rounded-card overflow-hidden aspect-[16/10] ring-1 ring-white/6 hover:ring-gold/30 transition-all duration-500"
          >
            <picture>
              <source srcset={link.hero} type="image/webp" />
              <img
                src={link.heroFallback}
                alt=""
                class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-white/10 backdrop-blur-sm p-1.5 flex-shrink-0 ring-1 ring-white/10">
                  <img src={link.icon} alt="" class="w-full h-full object-contain" />
                </div>
                <div>
                  <span class="font-medium text-sm text-white">{link.name}</span>
                  <p class="text-xs opacity-50">{link.description}</p>
                </div>
              </div>
            </div>
            <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FOOTER SCRIPTURE -->
  <section class="pb-16 text-center">
    <p class="text-sm opacity-30 italic font-serif">John 15:13</p>
  </section>

</BaseLayout>
