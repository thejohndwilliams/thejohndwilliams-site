---
import SocialIcon from '../components/SocialIcon.astro';
import { socialLinks } from '../utils/date';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPillGL from '../components/GlassPillGL.astro';

const charities = [
  {
    name: 'Global Christian Relief',
    mission: 'Support for the persecuted Church.',
    url: 'https://www.globalchristianrelief.org/',
    image: 'img-7029-hdr-enhanced',
    alt: 'Clouds parting over a deep blue sky, light breaking through'
  },
  {
    name: 'Restoring Faith',
    mission: 'Faith-based recovery and renewal.',
    url: 'https://www.restoringfaithinc.org/',
    image: '7r51108-enhanced-sr',
    alt: 'Sunlight filtering through a tree canopy'
  },
  {
    name: 'STCH Ministries',
    mission: 'Refuge and care for children in need.',
    url: 'https://www.stchm.org/',
    image: 'dscf0783',
    alt: 'Looking up through a bamboo canopy'
  },
  {
    name: 'St. Jude',
    mission: 'Treatment and research; no family ever billed.',
    url: 'https://www.stjude.org/',
    image: '7r51505-enhanced-sr',
    alt: 'A bee tending a lemon blossom in dark leaves'
  }
];

---

<BaseLayout title="Home" description="Making visible: threats on a network, patterns in data, light on a moment. Photography, cybersecurity, and data by John D. Williams." ogImage="/og/pages/home.jpg" ogImageWidth={1200} ogImageHeight={630} lcpImage="7r52326" lcpImagePortrait="7r52326">

  {/* HERO - Full-bleed cloudscape with left-aligned identity */}
  <section class="relative min-h-[65vh] sm:min-h-[75vh] md:min-h-[80vh] flex items-end overflow-hidden" data-glass-bench>
    <picture>
      <source media="(max-width: 640px)" type="image/avif" srcset="/images/photography/portrait/7r52326.avif" />
      <source media="(max-width: 640px)" type="image/webp" srcset="/images/photography/portrait/7r52326.webp" />
      <source
        type="image/avif"
        srcset="/images/photography/thumb/7r52326.avif 400w, /images/photography/gallery/7r52326.avif 1200w, /images/photography/hero/7r52326.avif 2400w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/photography/thumb/7r52326.webp 400w, /images/photography/gallery/7r52326.webp 1200w, /images/photography/hero/7r52326.webp 2400w"
        sizes="100vw"
      />
      <img
        src="/images/photography/hero/7r52326.webp"
        alt="Dramatic cloudscape with towering cumulus clouds illuminated against a dark sky"
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
        id="hero-img"
        data-dawn="/images/photography/hero/img-3058.webp"
        data-midday="/images/photography/hero/7r52326.webp"
        data-golden="/images/photography/hero/img-6552.webp"
        data-night="/images/photography/hero/7r52268.webp"
      />
    </picture>
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.78) 22%, rgba(10,10,10,0.56) 44%, rgba(10,10,10,0.28) 68%, rgba(10,10,10,0) 100%);"
    ></div>
    <div class="hero-lockup relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-12 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">making visible</p>
        <h1 class="t-title mb-4 sm:mb-5 font-serif tracking-tight" transition:name="site-title">John D. Williams</h1>
        <p class="text-sm sm:text-base leading-relaxed opacity-70 max-w-xl mb-6 sm:mb-8">
          Enterprise operations, satellite communications. Fine-art photographer.
        </p>
      </div>

      {/* Glass Build B promotion (owner verdict 2026-08-01: variant C).
          The cloud complications become true refractive glass - the pills
          bend the hero photograph behind them, per the June ruling. Both are
          secondaries; the nav's ivory key keeps the single flame. On touch
          or low tiers the component leaves the token CSS pill. */}
      <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-3 sm:gap-4 max-w-sm sm:max-w-none">
        <GlassPillGL label="About me" variant="c" href="/about" class="w-full sm:w-auto justify-center" />
        <GlassPillGL label="Photography" variant="c" href="/photography" class="w-full sm:w-auto justify-center" />
      </div>
    </div>
  </section>


  {/* IN SERVICE - charitable organizations, staggered bento */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">In Service</h2>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-3 md:gap-5">
        {charities.map((org, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          return (
            <a
              href={org.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-square sm:aspect-[16/10] ${mdAspect} ${mdSpan} ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-all duration-500`}
            >
              <picture>
                <source
                  type="image/avif"
                  srcset={`/images/photography/thumb/${org.image}.avif 400w, /images/photography/gallery/${org.image}.avif 1200w`}
                  sizes={isWide ? '(max-width: 767px) 50vw, 58vw' : '(max-width: 767px) 50vw, 42vw'}
                />
                <source
                  type="image/webp"
                  srcset={`/images/photography/thumb/${org.image}.webp 400w, /images/photography/gallery/${org.image}.webp 1200w`}
                  sizes={isWide ? '(max-width: 767px) 50vw, 58vw' : '(max-width: 767px) 50vw, 42vw'}
                />
                <img
                  src={`/images/photography/gallery/${org.image}.webp`}
                  alt={org.alt}
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-5 md:p-6">
                <h3 class="t-sub font-serif mb-0.5 sm:mb-1 text-cream">{org.name}</h3>
                <p class="text-[10px] sm:text-xs md:text-sm opacity-60 hidden sm:block">{org.mission}</p>
              </div>
              <div class="absolute top-3 right-3 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* NAVIGATION CARDS - bento grid with visual hierarchy */}
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">The Work</h2>
      <div class="stagger-children grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-5">
        {/* Photography - the flagship. Spans all three rows of the right-hand
            stack; the image is absolutely positioned so the three 16:10 cards
            alone define the grid's row heights. */}
        <a href="/photography" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[4/5] md:aspect-auto md:row-span-3 md:col-span-7 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-all duration-500">
          <img
            src="/images/photography/gallery/7r51848.webp"
            srcset="/images/photography/thumb/7r51848.webp 400w, /images/photography/gallery/7r51848.webp 1200w, /images/photography/hero/7r51848.webp 2400w"
            sizes="(max-width: 767px) 100vw, 58vw"
            alt="A storm shelf at dusk, one ember of sunset at the horizon" class="absolute inset-0 w-full h-full object-cover object-[center_62%] transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6 md:p-8">
            <h3 class="t-sub font-serif mb-1.5 group-hover:text-cream transition-colors duration-300">Photography</h3>
            <p class="text-xs sm:text-sm opacity-60">Sky, earth, water, structure, light.</p>
          </div>
        </a>
        {/* About */}
        <a href="/about" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-all duration-500">
          <img
            src="/images/photography/gallery/img-0132.webp"
            srcset="/images/photography/thumb/img-0132.webp 400w, /images/photography/gallery/img-0132.webp 1200w"
            sizes="(max-width: 767px) 100vw, 42vw"
            alt="A crystal chandelier lit low in a dark hall" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <h3 class="t-sub font-serif mb-1 group-hover:text-cream transition-colors duration-300">About</h3>
            <p class="text-xs opacity-60">Security engineer. Film-trained eye.</p>
          </div>
        </a>
        {/* Work */}
        <a href="/work" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-all duration-500">
          <img
            src="/images/photography/gallery/dscf1928.webp"
            srcset="/images/photography/thumb/dscf1928.webp 400w, /images/photography/gallery/dscf1928.webp 1200w"
            sizes="(max-width: 767px) 100vw, 42vw"
            alt="Windows lit at dusk across the water" class="w-full h-full object-cover object-[center_32%] transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <h3 class="t-sub font-serif mb-1 group-hover:text-cream transition-colors duration-300">Work</h3>
            <p class="text-xs opacity-60">Data, security, operations.</p>
          </div>
        </a>
        {/* Relief - the object axis. Third card of the right-hand stack. The
            asset is a purpose-rendered 16:10 detail of the carved hull (native
            1280x800, bench recipe, register-graded) - it is the cell's exact
            ratio, so the material fills the tile with no crop and renders
            below native width at every breakpoint. */}
        <a href="/beyond" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-all duration-500">
          <picture>
            <source type="image/avif" srcset="/images/relief/card.avif" />
            <img src="/images/relief/card.webp" alt="A tower carved as plaster relief, raked by one low light" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" decoding="async" />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <h3 class="t-sub font-serif mb-1 group-hover:text-cream transition-colors duration-300">Beyond</h3>
            <p class="text-xs opacity-60">Depth, holograms, and a photograph cut as a surface.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* SOCIAL TILES - bento grid with alternating spans */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">Connect</h2>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-3 md:gap-5">
        {socialLinks.map((link, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`glass-luminous group relative block rounded-card overflow-hidden aspect-square sm:aspect-[16/10] ${mdAspect} ${mdSpan} ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/25 transition-all duration-500`}
            >
              <picture>
                <source srcset={link.hero} type="image/webp" />
                <img
                  src={link.heroFallback}
                  alt={link.heroAlt}
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 md:p-6">
                <div class="flex items-center gap-2 sm:gap-3">
                  <SocialIcon
                    name={link.name.toLowerCase()}
                    class="w-5 h-5 sm:w-7 sm:h-7 flex-shrink-0 text-cream group-hover:text-cream transition-colors duration-300"
                  />
                  <div>
                    <span class="font-medium text-xs sm:text-sm text-cream">{link.name}</span>
                    <p class="text-[10px] sm:text-xs opacity-60 hidden sm:block">{link.description}</p>
                  </div>
                </div>
              </div>
              <div class="absolute top-3 right-3 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    // Time-aware hero - swaps hero image based on visitor's local time.
    //
    // CRITICAL: Runs only AFTER the page has fully loaded so the initial
    // paint uses the preloaded LCP image (7r52326, midday). Mutating img.src
    // before LCP fires invalidates the preload and tanks Lighthouse's
    // lcp-discovery-insight + prioritize-lcp-image scores.
    //
    // Also compares getAttribute('src') - the raw relative path -
    // against dataset values. img.src returns an absolute URL and would
    // never match a relative dataset path, causing every visit to
    // re-download the hero at midday (a silent regression we shipped
    // briefly in #20).
    function initTimeHero() {
      const img = document.getElementById('hero-img');
      if (img == null) return;
      const h = new Date().getHours();
      let slot = 'midday';
      if (h >= 5 && h < 11) slot = 'dawn';
      else if (h >= 11 && h < 16) slot = 'midday';
      else if (h >= 16 && h < 20) slot = 'golden';
      else slot = 'night';

      const src = img.dataset[slot];
      if (src == null) return;

      // No-op when the slot matches the server-rendered hero.
      // Relative-path comparison avoids the absolute-URL mismatch bug.
      const currentAttr = img.getAttribute('src');
      if (currentAttr === src) return;

      const performSwap = () => {
        img.src = src;
        const picture = img.closest('picture');
        if (picture) {
          const sources = picture.querySelectorAll('source');
          const base = src.replace('/hero/', '/TIER/').replace('.webp', '');
          sources.forEach(s => {
            if (s.hasAttribute('media')) return; // keep portrait art-direction sources
            const type = s.getAttribute('type');
            const ext = type === 'image/avif' ? '.avif' : '.webp';
            const thumb = base.replace('/TIER/', '/thumb/') + ext + ' 400w';
            const gallery = base.replace('/TIER/', '/gallery/') + ext + ' 1200w';
            const hero = base.replace('/TIER/', '/hero/') + ext + ' 2400w';
            s.srcset = `${thumb}, ${gallery}, ${hero}`;
          });
        }
      };

      // Defer past the LCP measurement window so the preloaded midday
      // hero earns the paint. requestIdleCallback keeps the fetch off
      // the critical path; setTimeout is the Safari fallback.
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(performSwap, { timeout: 3000 });
      } else {
        setTimeout(performSwap, 2000);
      }
    }

    if (document.readyState === 'complete') {
      initTimeHero();
    } else {
      window.addEventListener('load', initTimeHero, { once: true });
    }
    document.addEventListener('astro:after-swap', initTimeHero);
  </script>

</BaseLayout>
