---
import SocialIcon from '../components/SocialIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const charities = [
  {
    name: 'Global Christian Relief',
    mission: 'Support for the persecuted Church.',
    url: 'https://www.globalchristianrelief.org/',
    image: 'img-7029-hdr-enhanced',
    alt: 'Clouds parting over a deep blue sky, light breaking through'
  },
  {
    name: 'Restoring Faith',
    mission: 'Faith-based recovery and renewal.',
    url: 'https://www.restoringfaithinc.org/',
    image: '7r51108-enhanced-sr',
    alt: 'Sunlight filtering through a tree canopy'
  },
  {
    name: 'STCH Ministries',
    mission: 'Refuge and care for children in need.',
    url: 'https://www.stchm.org/',
    image: '7r51784-enhanced-sr',
    alt: 'Flowering tree reaching into soft cloud'
  },
  {
    name: 'St. Jude',
    mission: 'Treatment and research; no family ever billed.',
    url: 'https://www.stjude.org/',
    image: 'dscf0082',
    alt: 'Cumulus cloud illuminated from within'
  }
];

const socialLinks = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/john-davis-williams/',
    description: 'Professional network',
    icon: '/images/previews/linkedin.svg',
    hero: '/images/linkedin-hero.webp',
    heroFallback: '/images/linkedin-hero.jpg',
    heroAlt: 'Macro photograph of wet moss with water droplets and golden highlights'
  },
  {
    name: 'GitHub',
    url: 'https://github.com/thejohndwilliams',
    description: 'Code & projects',
    icon: '/images/previews/github.svg',
    hero: '/images/github-hero.webp',
    heroFallback: '/images/github-hero.jpg',
    heroAlt: 'Thermal visualization of a floor plan in neon pink and cyan'
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/thejohndwilliams/',
    description: 'Visual journal',
    icon: '/images/previews/instagram.svg',
    hero: '/images/instagram-hero.webp',
    heroFallback: '/images/instagram-hero.jpg',
    heroAlt: 'Single white cloud against a deep blue night sky'
  },
  {
    name: 'Behance',
    url: 'https://www.behance.net/killthewizard',
    description: 'Design work',
    icon: '/images/previews/behance.svg',
    hero: '/images/behance-hero.webp',
    heroFallback: '/images/behance-hero.jpg',
    heroAlt: 'Abstract minimalist silhouettes in soft gray and pale green tones'
  }
];
---

<BaseLayout title="Home" description="Making visible — threats on a network, patterns in data, light on a moment. Photography, cybersecurity, and data by John D. Williams." ogImage="/images/photography/hero/7r52326.webp" lcpImage="7r52326">

  {/* HERO — Full-bleed cloudscape with left-aligned identity */}
  <section class="relative min-h-[65vh] sm:min-h-[75vh] md:min-h-[80vh] flex items-center overflow-hidden">
    <picture>
      <source
        type="image/avif"
        srcset="/images/photography/thumb/7r52326.avif 400w, /images/photography/gallery/7r52326.avif 1200w, /images/photography/hero/7r52326.avif 2400w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/photography/thumb/7r52326.webp 400w, /images/photography/gallery/7r52326.webp 1200w, /images/photography/hero/7r52326.webp 2400w"
        sizes="100vw"
      />
      <img
        src="/images/photography/hero/7r52326.webp"
        alt="Dramatic cloudscape with towering cumulus clouds illuminated against a dark sky"
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
        id="hero-img"
        data-dawn="/images/photography/hero/dscf0088.webp"
        data-midday="/images/photography/hero/7r52326.webp"
        data-golden="/images/photography/hero/7r50971-enhanced-sr.webp"
        data-night="/images/photography/hero/7r50993-enhanced-sr.webp"
      />
    </picture>
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.78) 22%, rgba(10,10,10,0.56) 44%, rgba(10,10,10,0.28) 68%, rgba(10,10,10,0) 100%);"
    ></div>
    <div class="relative z-10 container-narrow w-full">
      <div class="reveal max-w-2xl">
        <p class="text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-60 mb-3 sm:mb-4">making visible</p>
        <h1 class="text-title md:text-headline mb-6 sm:mb-8 font-serif tracking-tight" transition:name="site-title">John D. Williams</h1>
      </div>

      <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-3 sm:gap-4 max-w-sm sm:max-w-none">
        <a href="/about" class="btn btn-primary w-full sm:w-auto justify-center">
          About me
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="mailto:jndwcreative@gmail.com" class="btn btn-outline w-full sm:w-auto justify-center">Get in touch</a>
      </div>
    </div>
  </section>


  {/* IN SERVICE — charitable organizations, staggered bento */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">In Service</h2>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-2 sm:gap-3 md:gap-4">
        {charities.map((org, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          return (
            <a
              href={org.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-square sm:aspect-[16/10] ${mdAspect} ${mdSpan} ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/30 transition-all duration-500`}
            >
              <picture>
                <source
                  type="image/avif"
                  srcset={`/images/photography/thumb/${org.image}.avif 400w, /images/photography/gallery/${org.image}.avif 1200w`}
                  sizes={isWide ? '(max-width: 767px) 100vw, 58vw' : '(max-width: 767px) 50vw, 42vw'}
                />
                <source
                  type="image/webp"
                  srcset={`/images/photography/thumb/${org.image}.webp 400w, /images/photography/gallery/${org.image}.webp 1200w`}
                  sizes={isWide ? '(max-width: 767px) 100vw, 58vw' : '(max-width: 767px) 50vw, 42vw'}
                />
                <img
                  src={`/images/photography/gallery/${org.image}.webp`}
                  alt={org.alt}
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-5 md:p-6">
                <h3 class="text-sm sm:text-lg md:text-xl font-serif mb-0.5 sm:mb-1 text-cream">{org.name}</h3>
                <p class="text-[10px] sm:text-xs md:text-sm opacity-60 hidden sm:block">{org.mission}</p>
              </div>
              <div class="absolute top-3 right-3 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* NAVIGATION CARDS — bento grid with visual hierarchy */}
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">The Work</h2>
      <div class="stagger-children grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4">
        {/* Photography — hero card, spans 2 rows on desktop */}
        <a href="/photography" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-auto md:row-span-2 md:col-span-7 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/30 transition-all duration-500">
          <img
            src="/images/photography/gallery/dscf0952.webp"
            srcset="/images/photography/thumb/dscf0952.webp 400w, /images/photography/gallery/dscf0952.webp 1200w, /images/photography/hero/dscf0952.webp 2400w"
            sizes="(max-width: 767px) 100vw, 58vw"
            alt="Serene river landscape with traditional wooden boats and forested hills" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6 md:p-8">
            <h3 class="text-xl md:text-2xl font-serif mb-1.5 group-hover:text-cream transition-colors duration-300">Photography</h3>
            <p class="text-xs sm:text-sm opacity-60">Sky, earth, water, structure, light.</p>
          </div>
        </a>
        {/* About */}
        <a href="/about" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/30 transition-all duration-500">
          <img
            src="/images/photography/gallery/7r52258.webp"
            srcset="/images/photography/thumb/7r52258.webp 400w, /images/photography/gallery/7r52258.webp 1200w"
            sizes="(max-width: 767px) 100vw, 42vw"
            alt="Cumulus cloud formation rising against a deep blue-black sky" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <h3 class="text-lg sm:text-xl font-serif mb-1 group-hover:text-cream transition-colors duration-300">About</h3>
            <p class="text-xs opacity-60">Film graduate turned security engineer</p>
          </div>
        </a>
        {/* Work */}
        <a href="/work" class="press-feedback glass-luminous group relative block rounded-card overflow-hidden aspect-[16/9] md:aspect-[16/10] md:col-span-5 ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/30 transition-all duration-500">
          <img
            src="/images/photography/gallery/dscf0530.webp"
            srcset="/images/photography/thumb/dscf0530.webp 400w, /images/photography/gallery/dscf0530.webp 1200w"
            sizes="(max-width: 767px) 100vw, 42vw"
            alt="Night urban street scene with warm-lit buildings and neon signage" class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <h3 class="text-lg sm:text-xl font-serif mb-1 group-hover:text-cream transition-colors duration-300">Work</h3>
            <p class="text-xs opacity-60">Built, shipped, open-sourced</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* SOCIAL TILES — bento grid with alternating spans */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-wide">
      <h2 class="text-subhead mb-6 sm:mb-8 reveal">Connect</h2>
      <div class="stagger-children grid grid-cols-2 md:grid-cols-12 gap-2 sm:gap-3 md:gap-4">
        {socialLinks.map((link, i) => {
          const isWide = i === 0 || i === 3;
          const mdSpan = isWide ? 'md:col-span-7' : 'md:col-span-5';
          const mdAspect = isWide ? 'md:aspect-[16/9]' : 'md:aspect-[4/3]';
          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`glass-luminous group relative block rounded-card overflow-hidden aspect-square sm:aspect-[16/10] ${mdAspect} ${mdSpan} ring-1 ring-white/5 hover:ring-cream/20 active:ring-cream/30 transition-all duration-500`}
            >
              <picture>
                <source srcset={link.hero} type="image/webp" />
                <img
                  src={link.heroFallback}
                  alt={link.heroAlt}
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 md:p-6">
                <div class="flex items-center gap-2 sm:gap-3">
                  <SocialIcon
                    name={link.name.toLowerCase()}
                    class="w-5 h-5 sm:w-7 sm:h-7 flex-shrink-0 text-cream group-hover:text-cream transition-colors duration-300"
                  />
                  <div>
                    <span class="font-medium text-xs sm:text-sm text-cream">{link.name}</span>
                    <p class="text-[10px] sm:text-xs opacity-60 hidden sm:block">{link.description}</p>
                  </div>
                </div>
              </div>
              <div class="absolute top-3 right-3 sm:top-4 sm:right-4 opacity-0 group-hover:opacity-60 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    // Time-aware hero — swaps hero image based on visitor's local time.
    //
    // CRITICAL: Runs only AFTER the page has fully loaded so the initial
    // paint uses the preloaded LCP image (7r52326, midday). Mutating img.src
    // before LCP fires invalidates the preload and tanks Lighthouse's
    // lcp-discovery-insight + prioritize-lcp-image scores.
    //
    // Also compares getAttribute('src') — the raw relative path —
    // against dataset values. img.src returns an absolute URL and would
    // never match a relative dataset path, causing every visit to
    // re-download the hero at midday (a silent regression we shipped
    // briefly in #20).
    function initTimeHero() {
      const img = document.getElementById('hero-img');
      if (img == null) return;
      const h = new Date().getHours();
      let slot = 'midday';
      if (h >= 5 && h < 11) slot = 'dawn';
      else if (h >= 11 && h < 16) slot = 'midday';
      else if (h >= 16 && h < 20) slot = 'golden';
      else slot = 'night';

      const src = img.dataset[slot];
      if (src == null) return;

      // No-op when the slot matches the server-rendered hero.
      // Relative-path comparison avoids the absolute-URL mismatch bug.
      const currentAttr = img.getAttribute('src');
      if (currentAttr === src) return;

      const performSwap = () => {
        img.src = src;
        const picture = img.closest('picture');
        if (picture) {
          const sources = picture.querySelectorAll('source');
          const base = src.replace('/hero/', '/TIER/').replace('.webp', '');
          sources.forEach(s => {
            const type = s.getAttribute('type');
            const ext = type === 'image/avif' ? '.avif' : '.webp';
            const thumb = base.replace('/TIER/', '/thumb/') + ext + ' 400w';
            const gallery = base.replace('/TIER/', '/gallery/') + ext + ' 1200w';
            const hero = base.replace('/TIER/', '/hero/') + ext + ' 2400w';
            s.srcset = `${thumb}, ${gallery}, ${hero}`;
          });
        }
      };

      // Defer past the LCP measurement window so the preloaded midday
      // hero earns the paint. requestIdleCallback keeps the fetch off
      // the critical path; setTimeout is the Safari fallback.
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(performSwap, { timeout: 3000 });
      } else {
        setTimeout(performSwap, 2000);
      }
    }

    if (document.readyState === 'complete') {
      initTimeHero();
    } else {
      window.addEventListener('load', initTimeHero, { once: true });
    }
    document.addEventListener('astro:after-swap', initTimeHero);
  </script>

</BaseLayout>
