---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPhotoMeta, formatMetaLine } from '../../utils/photo-meta';
import { categories, totalImages, getPlaceholder } from '../../data/photography';

const SITE = 'https://thejohndwilliams.com';

// JSON-LD ImageGallery schema - dedup by file so showcase re-listings
// (e.g. `light` re-displaying images from `earth`/`water`) don't emit duplicate
// ImageObject entries with conflicting names.
const seenSchemaFiles = new Set<string>();
const allImages = categories.flatMap(cat =>
  cat.images.filter(img => {
    if (seenSchemaFiles.has(img.file)) return false;
    seenSchemaFiles.add(img.file);
    return true;
  }).map(img => {
    const meta = getPhotoMeta(img.file);
    const obj: Record<string, unknown> = {
      '@type': 'ImageObject',
      contentUrl: `${SITE}/images/photography/hero/${img.file}.webp`,
      thumbnailUrl: `${SITE}/images/photography/thumb/${img.file}.webp`,
      name: img.alt,
      description: img.alt,
      creator: { '@type': 'Person', name: 'John D. Williams' },
      copyrightHolder: { '@type': 'Person', name: 'John D. Williams' },
      creditText: 'John D. Williams',
      license: `${SITE}/photography`,
      acquireLicensePage: 'mailto:jndwcreative@gmail.com',
      copyrightNotice: `© John D. Williams`,
      keywords: [cat.name, 'fine art photography', meta.camera].filter(Boolean).join(', '),
    };
    if (meta.captureDate) obj.datePublished = meta.captureDate;
    if (meta.location) obj.contentLocation = { '@type': 'Place', name: meta.location };
    return obj;
  })
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Photography · John D. Williams',
  description: 'Fine art photography by John D. Williams. Sky, earth, water, structure, and light, shot on Sony Alpha and Fujifilm X-Series.',
  url: `${SITE}/photography`,
  author: { '@type': 'Person', name: 'John D. Williams', url: SITE },
  image: allImages,
};
---

<BaseLayout
  title="Photography"
  description="Fine art photography by John D. Williams. Sky, earth, water, structure, and light, shot on Sony Alpha and Fujifilm X-Series."
  ogImage="/images/photography/hero/img-1066.webp"
  lcpImage="img-1066"
  lcpImagePortrait="img-1066"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  {/* Scroll-linked atmosphere overlay */}
  <div id="atmos-overlay" class="fixed inset-0 pointer-events-none z-0 transition-[background-color] duration-1000 ease-out" aria-hidden="true"></div>

  {/* HERO - Featured image full-bleed */}
  <section class="relative min-h-[50vh] sm:min-h-[60vh] md:min-h-[80vh] flex items-end overflow-hidden">
    <picture>
      <source media="(max-width: 640px)" type="image/avif" srcset="/images/photography/portrait/img-1066.avif" />
      <source media="(max-width: 640px)" type="image/webp" srcset="/images/photography/portrait/img-1066.webp" />
      <source
        type="image/avif"
        srcset="/images/photography/thumb/img-1066.avif 400w, /images/photography/gallery/img-1066.avif 1200w, /images/photography/hero/img-1066.avif 2400w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/photography/thumb/img-1066.webp 400w, /images/photography/gallery/img-1066.webp 1200w, /images/photography/hero/img-1066.webp 2400w"
        sizes="100vw"
      />
      <img
        src="/images/photography/hero/img-1066.webp"
        alt="A single tree beneath a darkening storm"
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/40 to-transparent"></div>
    <div class="relative z-10 container-narrow pb-10 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">Noticing</p>
        <h1 class="t-title font-serif mb-4 sm:mb-6 tracking-tight">Photography</h1>
        <div class="mt-6 sm:mt-8">
          <a
            href="mailto:jndwcreative@gmail.com?subject=Print%20inquiry"
            class="btn btn-primary"
          >
            Inquire
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* CATEGORY CONTENTS - quiet, non-sticky wayfinding (not a persistent
      filter). Scrolls away with the page so no chrome follows the work; each
      link smooth-scrolls to its section via the global scroll-behavior. The
      sticky glass filter bar was retired here 2026-05-30. */}
  <nav class="border-y border-white/5 py-4 sm:py-5" aria-label="Browse by category">
    <div class="container-narrow">
      <ul class="flex items-center justify-start sm:justify-center gap-5 sm:gap-8 overflow-x-auto scrollbar-hide -mx-1 px-1">
        {categories.map((cat) => (
          <li>
            <a
              href={`#gallery-${cat.id}`}
              class="cat-link text-xs sm:text-sm tracking-[0.15em] uppercase text-mute hover:text-navy-hour transition-colors duration-300 whitespace-nowrap py-2 min-h-[44px] flex items-center"
              data-cat={cat.id}
            >
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  {/* GALLERY SECTIONS */}
  {categories.map((cat, catIndex) => (
    <section
      class={`gallery-section scroll-mt-[84px] md:scroll-mt-[120px] py-10 sm:py-16 md:py-24 ${catIndex % 2 === 0 ? '' : 'section-light'}`}
      data-category={cat.id}
      id={`gallery-${cat.id}`}
    >
      <div class="container-wide">
        <div class="reveal mb-6 sm:mb-10 md:mb-14">
          <h2 class="t-section font-serif mb-1 sm:mb-2 tracking-tight">{cat.name}</h2>
          <p class="text-xs sm:text-sm opacity-60 italic">{cat.description}</p>
        </div>

        <div class="photo-grid columns-2 md:columns-3 gap-2 sm:gap-3 md:gap-4">
          {cat.images.map((img, i) => {
            // Tile takes the photograph's true aspect ratio (no crop) + LQIP blur
            // underneath. Triptych rows; framing preserved.
            const ph = getPlaceholder(img.file);
            const ratio = ph && ph.width && ph.height
              ? (ph.width / ph.height).toFixed(4)
              : (img.orientation === 'portrait' ? '0.75' : '1.5');
            const lqipStyle = `aspect-ratio: ${ratio};`
              + (ph ? ` background-image: url('${ph.lqip}'); background-size: cover; background-position: center;` : '');

            return (
              <a
                href={`/photography/${img.file}`}
                class={`gallery-item photo-protect press-feedback glass-luminous group relative overflow-hidden block w-full break-inside-avoid mb-2 sm:mb-3 md:mb-4 rounded-lg sm:rounded-card ring-1 ring-white/5 hover:ring-navy-hour/30 active:ring-navy-hour/40 focus-visible:ring-2 focus-visible:ring-cream/70 focus-visible:outline-none transition-all duration-500 cursor-pointer`}
                data-src={`/images/photography/hero/${img.file}.webp`}
                data-alt={img.alt}
                data-file={img.file}
                data-meta={formatMetaLine(getPhotoMeta(img.file))}
                style={lqipStyle}
              >
                <picture>
                  <source
                    type="image/avif"
                    srcset={`/images/photography/thumb/${img.file}.avif 400w, /images/photography/gallery/${img.file}.avif 1200w`}
                    sizes="(max-width: 767px) 50vw, 33vw"
                  />
                  <source
                    type="image/webp"
                    srcset={`/images/photography/thumb/${img.file}.webp 400w, /images/photography/gallery/${img.file}.webp 1200w`}
                    sizes="(max-width: 767px) 50vw, 33vw"
                  />
                  <img
                    src={`/images/photography/gallery/${img.file}.webp`}
                    alt={img.alt}
                    class={`w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-[1.03] will-change-transform`}
                    loading={catIndex === 0 && i < 4 ? 'eager' : 'lazy'}
                    decoding={catIndex === 0 && i < 4 ? 'auto' : 'async'}
                    width={ph?.width}
                    height={ph?.height}
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                {/* Caption is visual-only; img.alt already provides the accessible name for the link,
                    so expose this to sighted users only. Prevents axe image-redundant-alt from firing
                    when the same string appears as both alt and adjacent visible text. */}
                <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 sm:translate-y-4 sm:opacity-0 sm:group-hover:translate-y-0 sm:group-hover:opacity-100 transition-all duration-300 pointer-events-none" aria-hidden="true">
                  <p class="text-[10px] sm:text-xs opacity-60 sm:opacity-60">{img.alt}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  {/* LIGHTBOX - touch-friendly with swipe support */}
  <div id="lightbox" class="fixed inset-0 z-50 bg-[#0a0a0a]/92 backdrop-blur-2xl hidden items-center justify-center" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button id="lightbox-close" class="absolute top-3 right-3 sm:top-6 sm:right-6 z-10 w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center opacity-60 sm:opacity-60 hover:opacity-100 transition-opacity duration-300 bg-black/30 sm:bg-transparent rounded-full" aria-label="Close">
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button id="lightbox-prev" class="hidden sm:flex absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 items-center justify-center opacity-60 hover:opacity-100 transition-opacity duration-300" aria-label="Previous image">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button id="lightbox-next" class="hidden sm:flex absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 items-center justify-center opacity-60 hover:opacity-100 transition-opacity duration-300" aria-label="Next image">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <img id="lightbox-img" src="" srcset="" sizes="92vw" alt="" class="photo-protect max-w-[96vw] sm:max-w-[92vw] max-h-[80vh] sm:max-h-[85vh] object-contain select-none" draggable="false" />
    <div class="absolute bottom-3 sm:bottom-6 left-1/2 -translate-x-1/2 text-center max-w-[92vw]">
      <p id="lightbox-caption" class="text-xs sm:text-sm text-cream whitespace-nowrap truncate"></p>
      <p id="lightbox-meta" class="text-[10px] sm:text-xs text-mute tracking-[0.1em] mt-1 truncate"></p>
    </div>
  </div>

  {/* ABOUT / EQUIPMENT / COLLECTING */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal grid sm:grid-cols-2 gap-8 sm:gap-12 md:gap-16">
        <div>
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-3 sm:mb-4">Equipment</p>
          <p class="text-base sm:text-lg font-serif mb-1.5 sm:mb-2 opacity-80">Sony Alpha 7R V</p>
          <p class="text-xs sm:text-sm opacity-60 mb-4 sm:mb-6">Landscape, macro, and fine art work.</p>
          <p class="text-base sm:text-lg font-serif mb-1.5 sm:mb-2 opacity-80">Fujifilm X100VI</p>
          <p class="text-xs sm:text-sm opacity-60">Street, travel, and night photography.</p>
        </div>
        <div>
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-3 sm:mb-4">Philosophy</p>
          <p class="text-sm sm:text-base opacity-50 leading-relaxed mb-6 sm:mb-8">
            A thunderhead and a rain-wet leaf carry the same weight. Scale is not the subject; attention is. I photograph the threshold between the vast and the intimate, where looking up and looking close become the same act.
          </p>
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-3 sm:mb-4">Collecting</p>
          <p class="text-xs tracking-[0.15em] uppercase opacity-60 mb-3 sm:mb-4">{totalImages} selected from an archive of 3,000+</p>
          <p class="text-sm sm:text-base opacity-50 leading-relaxed mb-2">
            Available as limited edition archival prints.
          </p>
          <p class="text-xs sm:text-sm opacity-60 leading-relaxed mb-6 sm:mb-8">
            Giclée on Hahnemühle Photo Rag. Signed and numbered editions. Licensing inquiries welcome.
          </p>
          <a href="mailto:jndwcreative@gmail.com" class="btn btn-primary w-full sm:w-auto">
            Inquire about acquisitions
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* SCRIPTURE - the full verse as an intentional moment; the footer carries the short citation */}
  <section class="py-16 sm:py-20 md:py-24">
    <div class="container-narrow text-center reveal">
      <p class="font-serif italic text-cream opacity-80 text-xl sm:text-2xl md:text-[2rem] leading-relaxed max-w-2xl mx-auto">
        &ldquo;Greater love has no one than this: to lay down one&rsquo;s life for one&rsquo;s friends.&rdquo;
      </p>
    </div>
  </section>

  {/* Scroll-linked category atmosphere */}
  <script>
    function initAtmosphere() {
      const overlay = document.getElementById('atmos-overlay');
      if (!overlay) return;

      const colors = {
        sky:        'rgba(70, 100, 160, 0.035)',
        earth:      'rgba(160, 120, 60, 0.035)',
        water:      'rgba(50, 130, 140, 0.035)',
        structure:  'rgba(120, 110, 100, 0.025)',
        light:      'rgba(184, 151, 63, 0.03)',
      };

      const sections = document.querySelectorAll('.gallery-section[data-category]');
      if (!sections.length) return;

      const catLinks = document.querySelectorAll('.cat-link');
      let currentCat = '';

      const observer = new IntersectionObserver((entries) => {
        let topmost = null;
        let topY = Infinity;

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const rect = entry.boundingClientRect;
            if (rect.top < topY) {
              topY = rect.top;
              topmost = entry.target;
            }
          }
        });

        if (topmost) {
          const cat = topmost.getAttribute('data-category');
          if (cat && cat !== currentCat) {
            currentCat = cat;
            overlay.style.backgroundColor = colors[cat] || 'transparent';
            // Reflect scroll position in the contents row.
            catLinks.forEach((l) => {
              const on = (l as HTMLElement).dataset.cat === cat;
              l.classList.toggle('text-navy-hour', on);
              l.classList.toggle('text-mute', !on);
              if (on) l.setAttribute('aria-current', 'true');
              else l.removeAttribute('aria-current');
            });
          }
        }
      }, {
        threshold: 0.15,
        rootMargin: '-10% 0px -60% 0px'
      });

      sections.forEach(s => observer.observe(s));
    }

    function initCatScroll() {
      document.querySelectorAll('.cat-link').forEach((a) => {
        const el = a as HTMLElement;
        if (el.dataset.lenisBound) return;
        el.dataset.lenisBound = '1';
        a.addEventListener('click', (e) => {
          const href = a.getAttribute('href') || '';
          if (!href.startsWith('#')) return;
          const target = document.querySelector(href);
          const lenis = (window as any).__lenis;
          if (target && lenis) { e.preventDefault(); lenis.scrollTo(target, { offset: -100 }); }
        });
      });
    }

    initAtmosphere();
    initCatScroll();
    document.addEventListener('astro:after-swap', () => { initAtmosphere(); initCatScroll(); });
  </script>

</BaseLayout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  .gallery-section[data-hidden="true"] { display: none; }

  #lightbox.active { display: flex; }

  /* Develop-from-black: photos settle up out of shadow as they load. JS adds
     .developing only to not-yet-loaded imgs and removes on load - a JS failure
     can never hide them (visible by default). */
  .photo-grid img { transition: filter 1.1s cubic-bezier(.22,.61,.36,1), opacity 1.1s cubic-bezier(.22,.61,.36,1); }
  .photo-grid img.developing { filter: brightness(.5) saturate(.9); opacity: .55; }
  @media (prefers-reduced-motion: reduce) { .photo-grid img.developing { filter: none; opacity: 1; } }

  /* Immersive viewer: shared-element morph (tile <-> full photo) + idle chrome fade. */
  ::view-transition-old(lb-photo), ::view-transition-new(lb-photo) { animation-duration: .5s; mix-blend-mode: normal; }
  #lightbox button, #lightbox #lightbox-caption, #lightbox #lightbox-meta { transition: opacity .6s ease; }
  #lightbox.idle button, #lightbox.idle #lightbox-caption, #lightbox.idle #lightbox-meta { opacity: 0; pointer-events: none; }
</style>

<script>
  function initGallery() {
    // Category wayfinding is now plain anchor links (.cat-link) + native
    // smooth scroll - no JS filter/hide. The lightbox cycles the full gallery.

    // Lightbox - intercept gallery link clicks
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxMeta = document.getElementById('lightbox-meta');
    const items = document.querySelectorAll('.gallery-item');
    const closeBtn = document.getElementById('lightbox-close');
    let currentIndex = 0;
    let visibleItems: Element[] = [];
    let lastFocused: HTMLElement | null = null;
    let idleT: ReturnType<typeof setTimeout>;
    const reduceMo = matchMedia('(prefers-reduced-motion: reduce)');
    const canVT = () => typeof (document as any).startViewTransition === 'function' && !reduceMo.matches;
    const tileImg = (item: any): HTMLElement | null => item ? item.querySelector('img') : null;
    function armIdle() { lightbox?.classList.remove('idle'); clearTimeout(idleT); idleT = setTimeout(() => lightbox?.classList.add('idle'), 2000); }

    // Set the lightbox image from a gallery item. Serves the 1200px gallery
    // tier on phones and the 2400px hero on retina desktop (native sizes
    // selection) - previously every open fetched the full 2400px hero.
    function setLightboxImage(item: HTMLElement) {
      const file = item.dataset.file || '';
      const alt = item.dataset.alt || '';
      if (file) {
        lightboxImg.srcset = `/images/photography/gallery/${file}.webp 1200w, /images/photography/hero/${file}.webp 2400w`;
        lightboxImg.src = `/images/photography/hero/${file}.webp`;
      } else {
        lightboxImg.removeAttribute('srcset');
        lightboxImg.src = item.dataset.src || '';
      }
      lightboxImg.alt = alt;
      if (lightboxCaption) lightboxCaption.textContent = alt;
      if (lightboxMeta) lightboxMeta.textContent = item.dataset.meta || '';
    }

    // Warm the next/prev gallery-tier image so navigation feels instant.
    function prefetchNeighbors() {
      if (!visibleItems.length) return;
      for (const d of [-1, 1]) {
        const n = (currentIndex + d + visibleItems.length) % visibleItems.length;
        const f = (visibleItems[n] as HTMLElement)?.dataset.file;
        if (f) { const im = new Image(); im.src = `/images/photography/gallery/${f}.webp`; }
      }
    }

    function updateVisibleItems() {
      visibleItems = Array.from(document.querySelectorAll('.gallery-section:not([data-hidden]) .gallery-item'));
    }

    function openLightbox(index: number) {
      updateVisibleItems();
      currentIndex = index;
      const item = visibleItems[currentIndex] as HTMLElement;
      if (!item) return;
      lastFocused = document.activeElement as HTMLElement;
      const src = tileImg(item);
      const reveal = () => {
        setLightboxImage(item);
        lightbox!.classList.add('active');
        document.body.style.overflow = 'hidden';
        (closeBtn as HTMLElement | null)?.focus();
        prefetchNeighbors();
        armIdle();
      };
      if (canVT() && src) {
        src.style.viewTransitionName = 'lb-photo';
        lightboxImg.style.viewTransitionName = 'lb-photo';
        const t = (document as any).startViewTransition(reveal);
        t.finished.finally(() => { src.style.viewTransitionName = ''; lightboxImg.style.viewTransitionName = ''; });
      } else reveal();
    }

    function closeLightbox() {
      const src = tileImg(visibleItems[currentIndex] as HTMLElement);
      const hide = () => { lightbox!.classList.remove('active'); document.body.style.overflow = ''; lastFocused?.focus(); };
      if (canVT() && src) {
        lightboxImg.style.viewTransitionName = 'lb-photo';
        const t = (document as any).startViewTransition(() => { hide(); src.style.viewTransitionName = 'lb-photo'; });
        t.finished.finally(() => { lightboxImg.style.viewTransitionName = ''; src.style.viewTransitionName = ''; });
      } else hide();
    }

    function navigate(dir: number) {
      updateVisibleItems();
      currentIndex = (currentIndex + dir + visibleItems.length) % visibleItems.length;
      const item = visibleItems[currentIndex] as HTMLElement;
      if (!item) return;
      const swap = () => { setLightboxImage(item); prefetchNeighbors(); };
      if (canVT()) {
        lightboxImg.style.viewTransitionName = 'lb-photo';
        const t = (document as any).startViewTransition(swap);
        t.finished.finally(() => { lightboxImg.style.viewTransitionName = ''; });
      } else swap();
      armIdle();
    }

    // Intercept clicks on gallery links - open lightbox instead of navigating.
    // Middle-click / Ctrl+click / right-click still follow the link naturally.
    items.forEach((item) => {
      item.addEventListener('click', (e) => {
        // Let modified clicks pass through for "open in new tab"
        const me = e as MouseEvent;
        if (me.ctrlKey || me.metaKey || me.shiftKey || me.button !== 0) return;
        e.preventDefault();
        updateVisibleItems();
        const idx = visibleItems.indexOf(item);
        openLightbox(idx >= 0 ? idx : 0);
      });
    });

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => navigate(-1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => navigate(1));

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Develop-from-black: dim not-yet-loaded gallery photos, restore on load.
    if (!reduceMo.matches) {
      items.forEach((item) => {
        const im = (item as HTMLElement).querySelector('img');
        if (!im || (im as HTMLImageElement).complete) return;
        im.classList.add('developing');
        im.addEventListener('load', () => im.classList.remove('developing'), { once: true });
      });
    }
    lightbox?.addEventListener('mousemove', armIdle);
    lightbox?.addEventListener('touchstart', armIdle, { passive: true });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
      if (e.key === 'Tab') {
        // Focus trap: keep Tab within the dialog's visible controls.
        const f = (Array.from(lightbox!.querySelectorAll('button')) as HTMLElement[])
          .filter((b) => b.offsetParent !== null);
        if (f.length) {
          const first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      }
    });

    // Touch/swipe support for mobile lightbox
    let touchStartX = 0;
    let touchStartY = 0;

    lightbox?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    lightbox?.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const deltaX = touchEndX - touchStartX;
      const deltaY = e.changedTouches[0].screenY - touchStartY;

      if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
        if (deltaX < 0) navigate(1);
        else navigate(-1);
      }
    }, { passive: true });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
