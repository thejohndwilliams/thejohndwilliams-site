---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPhotoMeta, formatMetaLine } from '../../utils/photo-meta';
import { categories, totalImages } from '../../data/photography';

const SITE = 'https://thejohndwilliams.com';

// JSON-LD ImageGallery schema
const allImages = categories.flatMap(cat =>
  cat.images.map(img => {
    const meta = getPhotoMeta(img.file);
    const obj: Record<string, unknown> = {
      '@type': 'ImageObject',
      contentUrl: `${SITE}/images/photography/hero/${img.file}.webp`,
      thumbnailUrl: `${SITE}/images/photography/thumb/${img.file}.webp`,
      name: img.alt,
      description: img.alt,
      creator: { '@type': 'Person', name: 'John D. Williams' },
      copyrightHolder: { '@type': 'Person', name: 'John D. Williams' },
      creditText: 'John D. Williams',
      license: `${SITE}/photography`,
      acquireLicensePage: 'mailto:jndwcreative@gmail.com',
      copyrightNotice: `© John D. Williams`,
      keywords: [cat.name, 'fine art photography', meta.camera].filter(Boolean).join(', '),
    };
    if (meta.captureDate) obj.datePublished = meta.captureDate;
    if (meta.location) obj.contentLocation = { '@type': 'Place', name: meta.location };
    return obj;
  })
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Photography — John D. Williams',
  description: 'Fine art photography by John D. Williams. Sky, earth, water, structure, and light — shot on Sony Alpha and Fujifilm X-Series.',
  url: `${SITE}/photography`,
  author: { '@type': 'Person', name: 'John D. Williams', url: SITE },
  image: allImages,
};
---

<BaseLayout
  title="Photography"
  description="Fine art photography by John D. Williams. Sky, earth, water, structure, and light — shot on Sony Alpha and Fujifilm X-Series."
  ogImage="/images/photography/hero/7r52326.webp"
  lcpImage="7r52326"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  {/* Scroll-linked atmosphere overlay */}
  <div id="atmos-overlay" class="fixed inset-0 pointer-events-none z-0 transition-[background-color] duration-1000 ease-out" aria-hidden="true"></div>

  {/* HERO — Featured image full-bleed */}
  <section class="relative min-h-[50vh] sm:min-h-[60vh] md:min-h-[80vh] flex items-end overflow-hidden">
    <picture>
      <source
        type="image/avif"
        srcset="/images/photography/thumb/7r52326.avif 400w, /images/photography/gallery/7r52326.avif 1200w, /images/photography/hero/7r52326.avif 2400w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/photography/thumb/7r52326.webp 400w, /images/photography/gallery/7r52326.webp 1200w, /images/photography/hero/7r52326.webp 2400w"
        sizes="100vw"
      />
      <img
        src="/images/photography/hero/7r52326.webp"
        alt="Thunderheads against black sky"
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/40 to-transparent"></div>
    <div class="relative z-10 container-narrow pb-10 sm:pb-16 md:pb-24">
      <div class="reveal max-w-2xl">
        <p class="text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-60 mb-3 sm:mb-4 font-light">The Threshold</p>
        <h1 class="text-title md:text-headline font-serif mb-4 sm:mb-6 tracking-tight">Photography</h1>
        <p class="text-base sm:text-lg md:text-xl leading-relaxed opacity-60 max-w-lg">
          Where the vast meets the intimate.<br />
          Looking up. Looking close.
        </p>
        {/* Archive signal */}
        <p class="text-xs tracking-[0.15em] uppercase opacity-40 mt-3 sm:mt-4 font-light">{totalImages} selected from an archive of 3,000+</p>
        <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
          <a
            href="https://www.etsy.com/shop/thejohndwilliams"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm tracking-[0.15em] uppercase font-medium px-4 sm:px-5 py-2 sm:py-2.5 min-h-[44px] rounded-full bg-gold text-midnight hover:bg-gold-light transition-colors duration-300"
          >
            Shop Prints
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a
            href="mailto:jndwcreative@gmail.com?subject=Custom%20Print%20Inquiry"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm tracking-[0.15em] uppercase font-medium px-4 sm:px-5 py-2 sm:py-2.5 min-h-[44px] rounded-full border border-stone/40 text-stone-light hover:border-stone hover:bg-stone/10 transition-all duration-300"
          >
            Commission Custom
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* CATEGORY FILTER */}
  <section class="section-light py-3 sm:py-4 md:py-5 sticky top-[60px] sm:top-[72px] md:top-[88px] z-30 glass-nav">
    <div class="container-narrow">
      <nav class="flex items-center gap-1 sm:gap-4 md:gap-6 overflow-x-auto scrollbar-hide -mx-1 px-1" id="category-nav" role="tablist">
        <button
          class="category-btn active text-sm opacity-90 whitespace-nowrap py-2 px-3 sm:px-2 sm:pb-2 sm:pt-0 border-b-2 border-gold transition-all duration-300 min-h-[44px] flex items-center"
          data-category="all"
          role="tab"
          aria-selected="true"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            class="category-btn text-sm opacity-60 hover:opacity-70 whitespace-nowrap py-2 px-3 sm:px-2 sm:pb-2 sm:pt-0 border-b-2 border-transparent transition-all duration-300 min-h-[44px] flex items-center"
            data-category={cat.id}
            role="tab"
            aria-selected="false"
          >
            {cat.name}
          </button>
        ))}
      </nav>
    </div>
  </section>

  {/* GALLERY SECTIONS */}
  {categories.map((cat, catIndex) => (
    <section
      class={`gallery-section py-10 sm:py-16 md:py-24 ${catIndex % 2 === 0 ? '' : 'section-light'}`}
      data-category={cat.id}
      id={`gallery-${cat.id}`}
    >
      <div class="container-wide">
        <div class="reveal mb-6 sm:mb-10 md:mb-14">
          <h2 class="text-xl sm:text-2xl md:text-3xl font-serif mb-1 sm:mb-2 tracking-tight">{cat.name}</h2>
          <p class="text-xs sm:text-sm opacity-60 italic">{cat.description}</p>
        </div>

        <div class="stagger-children grid grid-cols-1 min-[480px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 min-[480px]:gap-3 md:gap-4">
          {cat.images.map((img, i) => {
            const spanClass = img.featured
              ? 'min-[480px]:col-span-2 min-[480px]:row-span-2'
              : img.orientation === 'portrait'
                ? 'min-[480px]:row-span-2'
                : '';
            const aspectClass = img.featured
              ? 'aspect-[16/9] min-[480px]:aspect-square md:aspect-auto md:h-full'
              : img.orientation === 'portrait'
                ? 'aspect-[4/3] min-[480px]:aspect-[3/4]'
                : 'aspect-[4/3]';

            return (
              <a
                href={`/photography/${img.file}`}
                class={`gallery-item photo-protect press-feedback glass-luminous group relative overflow-hidden rounded-lg sm:rounded-card ring-1 ring-white/5 hover:ring-stone-light/30 active:ring-stone-light/40 focus-visible:ring-2 focus-visible:ring-gold/60 focus-visible:outline-none transition-all duration-500 cursor-pointer ${spanClass}`}
                data-src={`/images/photography/hero/${img.file}.webp`}
                data-alt={img.alt}
                data-meta={formatMetaLine(getPhotoMeta(img.file))}
              >
                <picture>
                  <source
                    type="image/avif"
                    srcset={`/images/photography/thumb/${img.file}.avif 400w, /images/photography/gallery/${img.file}.avif 1200w`}
                    sizes={img.featured
                      ? '(max-width: 479px) 100vw, (max-width: 767px) 100vw, (max-width: 1023px) 66vw, 50vw'
                      : '(max-width: 479px) 100vw, (max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw'}
                  />
                  <source
                    type="image/webp"
                    srcset={`/images/photography/thumb/${img.file}.webp 400w, /images/photography/gallery/${img.file}.webp 1200w`}
                    sizes={img.featured
                      ? '(max-width: 479px) 100vw, (max-width: 767px) 100vw, (max-width: 1023px) 66vw, 50vw'
                      : '(max-width: 479px) 100vw, (max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw'}
                  />
                  <img
                    src={`/images/photography/gallery/${img.file}.webp`}
                    alt={img.alt}
                    class={`w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-[1.03] will-change-transform ${aspectClass}`}
                    loading={catIndex === 0 && i < 4 ? 'eager' : 'lazy'}
                    decoding={catIndex === 0 && i < 4 ? 'auto' : 'async'}
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                {/* Caption is visual-only; img.alt already provides the accessible name for the link,
                    so expose this to sighted users only. Prevents axe image-redundant-alt from firing
                    when the same string appears as both alt and adjacent visible text. */}
                <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 sm:translate-y-4 sm:opacity-0 sm:group-hover:translate-y-0 sm:group-hover:opacity-100 transition-all duration-300 pointer-events-none" aria-hidden="true">
                  <p class="text-[10px] sm:text-xs opacity-60 sm:opacity-60">{img.alt}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  {/* LIGHTBOX — touch-friendly with swipe support */}
  <div id="lightbox" class="fixed inset-0 z-50 bg-[#0a0a0a]/92 backdrop-blur-2xl hidden items-center justify-center" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button id="lightbox-close" class="absolute top-3 right-3 sm:top-6 sm:right-6 z-10 w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center opacity-60 sm:opacity-60 hover:opacity-100 transition-opacity duration-300 bg-black/30 sm:bg-transparent rounded-full" aria-label="Close">
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button id="lightbox-prev" class="hidden sm:flex absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 items-center justify-center opacity-60 hover:opacity-100 transition-opacity duration-300" aria-label="Previous image">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button id="lightbox-next" class="hidden sm:flex absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 items-center justify-center opacity-60 hover:opacity-100 transition-opacity duration-300" aria-label="Next image">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="photo-protect max-w-[96vw] sm:max-w-[92vw] max-h-[80vh] sm:max-h-[85vh] object-contain select-none" draggable="false" />
    <div class="absolute bottom-3 sm:bottom-6 left-1/2 -translate-x-1/2 text-center max-w-[92vw]">
      <p id="lightbox-caption" class="text-xs sm:text-sm text-cream whitespace-nowrap truncate"></p>
      <p id="lightbox-meta" class="text-[10px] sm:text-xs text-mute tracking-[0.1em] mt-1 truncate"></p>
    </div>
    <div id="swipe-hint" class="sm:hidden absolute bottom-10 left-1/2 -translate-x-1/2 flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] opacity-0 transition-opacity duration-500 pointer-events-none">
      <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" /></svg>
      <span class="opacity-60">Swipe</span>
      <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
    </div>
  </div>

  {/* ABOUT / EQUIPMENT / COLLECTING */}
  <section class="section-light py-12 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal grid sm:grid-cols-2 gap-8 sm:gap-12 md:gap-16">
        <div>
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-3 sm:mb-4">Equipment</p>
          <p class="text-base sm:text-lg font-serif mb-1.5 sm:mb-2 opacity-80">Sony Alpha 7R V</p>
          <p class="text-xs sm:text-sm opacity-60 mb-4 sm:mb-6">61 megapixels. Landscape, macro, and fine art work.</p>
          <p class="text-base sm:text-lg font-serif mb-1.5 sm:mb-2 opacity-80">Fujifilm X100VI</p>
          <p class="text-xs sm:text-sm opacity-60">40 megapixels. Street, travel, and night photography.</p>
        </div>
        <div>
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-3 sm:mb-4">Philosophy</p>
          <p class="text-sm sm:text-base opacity-50 leading-relaxed mb-6 sm:mb-8">
            A thunderhead and a rain-wet leaf carry the same weight. Scale is not the subject — attention is. I photograph the threshold between the vast and the intimate, where looking up and looking close become the same act.
          </p>
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-3 sm:mb-4">Collecting</p>
          <p class="text-sm sm:text-base opacity-50 leading-relaxed mb-2">
            Available as limited edition archival prints.
          </p>
          <p class="text-xs sm:text-sm opacity-60 leading-relaxed mb-6 sm:mb-8">
            Giclée on Hahnemühle Photo Rag. Signed and numbered editions. Licensing inquiries welcome.
          </p>
          <a href="mailto:jndwcreative@gmail.com" class="btn btn-primary w-full sm:w-auto">
            Inquire about acquisitions
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* SCRIPTURE */}
  <section class="py-12">
    <div class="container-narrow text-center">
      <p class="text-sm opacity-60 italic font-serif">John 15:13</p>
    </div>
  </section>

  {/* Scroll-linked category atmosphere */}
  <script>
    function initAtmosphere() {
      const overlay = document.getElementById('atmos-overlay');
      if (!overlay) return;

      const colors = {
        sky:        'rgba(70, 100, 160, 0.035)',
        earth:      'rgba(160, 120, 60, 0.035)',
        water:      'rgba(50, 130, 140, 0.035)',
        structure:  'rgba(120, 110, 100, 0.025)',
        light:      'rgba(184, 151, 63, 0.03)',
      };

      const sections = document.querySelectorAll('.gallery-section[data-category]');
      if (!sections.length) return;

      let currentCat = '';

      const observer = new IntersectionObserver((entries) => {
        let topmost = null;
        let topY = Infinity;

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const rect = entry.boundingClientRect;
            if (rect.top < topY) {
              topY = rect.top;
              topmost = entry.target;
            }
          }
        });

        if (topmost) {
          const cat = topmost.getAttribute('data-category');
          if (cat && cat !== currentCat) {
            currentCat = cat;
            overlay.style.backgroundColor = colors[cat] || 'transparent';
          }
        }
      }, {
        threshold: 0.15,
        rootMargin: '-10% 0px -60% 0px'
      });

      sections.forEach(s => observer.observe(s));
    }

    initAtmosphere();
    document.addEventListener('astro:after-swap', initAtmosphere);
  </script>

</BaseLayout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  .gallery-section[data-hidden="true"] { display: none; }

  #lightbox.active { display: flex; }

  #lightbox img {
    animation: lightbox-in 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes lightbox-in {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  function initGallery() {
    // Category filtering
    const buttons = document.querySelectorAll('.category-btn');
    const sections = document.querySelectorAll('.gallery-section');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.category;

        buttons.forEach(b => {
          b.classList.remove('active', 'opacity-90', 'border-gold');
          b.classList.add('opacity-60', 'border-transparent');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active', 'opacity-90', 'border-gold');
        btn.classList.remove('opacity-60', 'border-transparent');
        btn.setAttribute('aria-selected', 'true');

        sections.forEach(s => {
          const el = s as HTMLElement;
          if (cat === 'all' || el.dataset.category === cat) {
            el.removeAttribute('data-hidden');
            el.style.display = '';
          } else {
            el.setAttribute('data-hidden', 'true');
            el.style.display = 'none';
          }
        });
      });
    });

    // Lightbox — intercept gallery link clicks
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxMeta = document.getElementById('lightbox-meta');
    const items = document.querySelectorAll('.gallery-item');
    let currentIndex = 0;
    let visibleItems: Element[] = [];

    function updateVisibleItems() {
      visibleItems = Array.from(document.querySelectorAll('.gallery-section:not([data-hidden]) .gallery-item'));
    }

    let swipeHintShown = false;

    function openLightbox(index: number) {
      updateVisibleItems();
      currentIndex = index;
      const item = visibleItems[currentIndex] as HTMLElement;
      if (!item) return;
      lightboxImg.src = item.dataset.src || '';
      lightboxImg.alt = item.dataset.alt || '';
      if (lightboxCaption) lightboxCaption.textContent = item.dataset.alt || '';
      if (lightboxMeta) lightboxMeta.textContent = item.dataset.meta || '';
      lightbox!.classList.add('active');
      document.body.style.overflow = 'hidden';

      if (!swipeHintShown && window.innerWidth < 640) {
        swipeHintShown = true;
        const hint = document.getElementById('swipe-hint');
        if (hint) {
          setTimeout(() => { hint.style.opacity = '1'; }, 400);
          setTimeout(() => { hint.style.opacity = '0'; }, 2500);
        }
      }
    }

    function closeLightbox() {
      lightbox!.classList.remove('active');
      document.body.style.overflow = '';
    }

    function navigate(dir: number) {
      updateVisibleItems();
      currentIndex = (currentIndex + dir + visibleItems.length) % visibleItems.length;
      const item = visibleItems[currentIndex] as HTMLElement;
      if (!item) return;
      lightboxImg.src = item.dataset.src || '';
      lightboxImg.alt = item.dataset.alt || '';
      if (lightboxCaption) lightboxCaption.textContent = item.dataset.alt || '';
      if (lightboxMeta) lightboxMeta.textContent = item.dataset.meta || '';
    }

    // Intercept clicks on gallery links — open lightbox instead of navigating.
    // Middle-click / Ctrl+click / right-click still follow the link naturally.
    items.forEach((item) => {
      item.addEventListener('click', (e) => {
        // Let modified clicks pass through for "open in new tab"
        const me = e as MouseEvent;
        if (me.ctrlKey || me.metaKey || me.shiftKey || me.button !== 0) return;
        e.preventDefault();
        updateVisibleItems();
        const idx = visibleItems.indexOf(item);
        openLightbox(idx >= 0 ? idx : 0);
      });
    });

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => navigate(-1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => navigate(1));

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
    });

    // Touch/swipe support for mobile lightbox
    let touchStartX = 0;
    let touchStartY = 0;

    lightbox?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    lightbox?.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const deltaX = touchEndX - touchStartX;
      const deltaY = e.changedTouches[0].screenY - touchStartY;

      if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
        if (deltaX < 0) navigate(1);
        else navigate(-1);
      }
    }, { passive: true });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
