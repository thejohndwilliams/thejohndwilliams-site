---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPhotoMeta, formatMetaLine } from '../../utils/photo-meta';
import { categories, getAllSlugs, getAllSlugsSequential, getPhotoBySlug, getRelatedImages, getPlaceholder } from '../../data/photography';

export function getStaticPaths() {
  return getAllSlugs().map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const entry = getPhotoBySlug(slug!);

if (!entry) {
  return Astro.redirect('/photography');
}

const { image, category } = entry;
const meta = getPhotoMeta(image.file);
const metaLine = formatMetaLine(meta);
const related = getRelatedImages(image.file, 4);

const SITE = 'https://thejohndwilliams.com';

// ─── Ambient Color Bleed: category-driven palette ───
// Each category maps to a subtle color that bleeds into the page background.
// These are intentional, not extracted - the semantics drive the atmosphere.
const categoryColors: Record<string, { glow: string; accent: string }> = {
  sky:        { glow: 'rgba(70, 100, 160, 0.08)',  accent: 'rgba(70, 100, 160, 0.04)' },
  earth:      { glow: 'rgba(160, 120, 60, 0.08)',  accent: 'rgba(160, 120, 60, 0.04)' },
  water:      { glow: 'rgba(50, 130, 140, 0.08)',  accent: 'rgba(50, 130, 140, 0.04)' },
  structure:  { glow: 'rgba(120, 110, 100, 0.06)', accent: 'rgba(120, 110, 100, 0.03)' },
  light:      { glow: 'rgba(126, 156, 184, 0.07)',  accent: 'rgba(126, 156, 184, 0.035)' },
};
const bleed = categoryColors[category.id] || categoryColors.structure;

// ─── Keyboard navigation: prev/next in sequential order ───
const allSlugs = getAllSlugsSequential();
const currentIdx = allSlugs.indexOf(image.file);
const prevSlug = currentIdx > 0 ? allSlugs[currentIdx - 1] : null;
const nextSlug = currentIdx < allSlugs.length - 1 ? allSlugs[currentIdx + 1] : null;

// JSON-LD for individual image
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: `${SITE}/images/photography/hero/${image.file}.webp`,
  thumbnailUrl: `${SITE}/images/photography/thumb/${image.file}.webp`,
  name: image.alt,
  description: image.alt,
  creator: { '@type': 'Person', name: 'John D. Williams', url: SITE },
  copyrightHolder: { '@type': 'Person', name: 'John D. Williams' },
  creditText: 'John D. Williams',
  copyrightNotice: '© John D. Williams',
  license: `${SITE}/photography`,
  acquireLicensePage: `mailto:jndwcreative@gmail.com?subject=Print%20Inquiry:%20${encodeURIComponent(image.alt)}`,
  keywords: [category.name, 'fine art photography', meta.camera].filter(Boolean).join(', '),
  ...(meta.captureDate ? { datePublished: meta.captureDate } : {}),
  ...(meta.location ? { contentLocation: { '@type': 'Place', name: meta.location } } : {}),
  isPartOf: {
    '@type': 'ImageGallery',
    name: `${category.name} · Photography by John D. Williams`,
    url: `${SITE}/photography#gallery-${category.id}`,
  },
};

// Build EXIF detail lines
const exifDetails: Array<{ label: string; value: string }> = [];
if (meta.camera) exifDetails.push({ label: 'Camera', value: meta.camera });
if (meta.lens) exifDetails.push({ label: 'Lens', value: meta.lens });
if (meta.focalLength) exifDetails.push({ label: 'Focal Length', value: meta.focalLength });
if (meta.aperture) exifDetails.push({ label: 'Aperture', value: meta.aperture });
if (meta.shutter) exifDetails.push({ label: 'Shutter', value: meta.shutter });
if (meta.iso) exifDetails.push({ label: 'ISO', value: String(meta.iso) });
if (meta.captureDate) {
  const d = new Date(meta.captureDate);
  if (!isNaN(d.getTime())) {
    exifDetails.push({ label: 'Date', value: d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) });
  }
}
if (meta.location) exifDetails.push({ label: 'Location', value: meta.location });
---

<BaseLayout
  title={`${image.alt} · Photography`}
  description={`${image.alt}. Fine art photograph by John D. Williams. ${category.name} series. ${metaLine || ''}`}
  ogImage={`/og/photography/${image.file}.jpg`}
  ogImageWidth={1200}
  ogImageHeight={630}
  lcpImage={image.file}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  {/* Ambient Color Bleed - subtle radial glow behind the hero, driven by category */}
  <div
    class="fixed inset-0 pointer-events-none z-0"
    aria-hidden="true"
    style={`background: radial-gradient(ellipse 80% 60% at 50% 30%, ${bleed.glow}, ${bleed.accent}, transparent 70%);`}
  ></div>

  {/* FULL-BLEED HERO IMAGE */}
  <section
    class="relative min-h-[60vh] sm:min-h-[70vh] md:min-h-[85vh] flex items-end overflow-hidden z-10"
    style={(() => {
      const ph = getPlaceholder(image.file);
      return ph ? `background-image: url('${ph.lqip}'); background-size: cover; background-position: center;` : '';
    })()}
  >
    <picture>
      <source
        type="image/avif"
        srcset={`/images/photography/thumb/${image.file}.avif 400w, /images/photography/gallery/${image.file}.avif 1200w, /images/photography/hero/${image.file}.avif 2400w`}
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset={`/images/photography/thumb/${image.file}.webp 400w, /images/photography/gallery/${image.file}.webp 1200w, /images/photography/hero/${image.file}.webp 2400w`}
        sizes="100vw"
      />
      <img
        src={`/images/photography/hero/${image.file}.webp`}
        alt={image.alt}
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority="high"
        width={getPlaceholder(image.file)?.width}
        height={getPlaceholder(image.file)?.height}
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/30 to-transparent"></div>

    {/* Print preview frame - ghost overlay, visible when CTA is hovered */}
    <div id="print-frame" class="absolute inset-[8%] sm:inset-[10%] md:inset-[12%] z-[5] pointer-events-none opacity-0 transition-opacity duration-500" aria-hidden="true">
      <div class="w-full h-full border-[6px] sm:border-[8px] border-white/[0.07] shadow-[inset_0_0_0_1px_rgba(255,255,255,0.04),0_0_60px_rgba(0,0,0,0.3)]"></div>
    </div>

    {/* Back nav + keyboard hint */}
    <a
      href="/photography"
      class="absolute top-4 left-4 sm:top-8 sm:left-8 z-10 inline-flex items-center gap-1.5 text-xs tracking-[0.15em] uppercase opacity-60 hover:opacity-100 transition-opacity duration-300 min-h-[44px]"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Gallery
    </a>

    {/* Keyboard nav arrows (desktop only, visible on hover) */}
    {prevSlug && (
      <a
        href={`/photography/${prevSlug}`}
        id="nav-prev"
        class="hidden md:flex absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 z-10 w-10 h-10 items-center justify-center rounded-full glass-control opacity-0 hover:opacity-80 transition-opacity duration-300"
        aria-label="Previous photo"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      </a>
    )}
    {nextSlug && (
      <a
        href={`/photography/${nextSlug}`}
        id="nav-next"
        class="hidden md:flex absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 z-10 w-10 h-10 items-center justify-center rounded-full glass-control opacity-0 hover:opacity-80 transition-opacity duration-300"
        aria-label="Next photo"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
    )}

    <div class="relative z-10 container-narrow pb-10 sm:pb-16 md:pb-20">
      <div class="reveal max-w-2xl">
        <p class="text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-60 mb-2 sm:mb-3">
          <a href={`/photography#gallery-${category.id}`} class="hover:opacity-100 transition-opacity duration-300">{category.name}</a>
        </p>
        <h1 class="t-section font-serif tracking-tight mb-2 sm:mb-3">{image.alt}</h1>
        {metaLine && (
          <p class="text-xs sm:text-sm text-mute tracking-[0.05em]">{metaLine}</p>
        )}
      </div>
    </div>
  </section>

  {/* DETAILS + EXIF + CTA */}
  <section class="section-light py-10 sm:py-16 md:py-20 relative z-10">
    <div class="container-narrow">
      <div class="grid sm:grid-cols-2 gap-8 sm:gap-12 md:gap-16 max-w-3xl">

        {/* EXIF Technical Details - staggered reveal on scroll */}
        {exifDetails.length > 0 && (
          <div>
            <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-4 sm:mb-6">Technical Details</p>
            <dl class="space-y-3" id="exif-list">
              {exifDetails.map(({ label, value }, i) => (
                <div
                  class="exif-row flex items-baseline justify-between gap-4 opacity-0 translate-y-2"
                  style={`transition: opacity 0.4s ease ${i * 60}ms, transform 0.4s ease ${i * 60}ms;`}
                >
                  <dt class="text-xs text-mute uppercase tracking-[0.1em] flex-shrink-0">{label}</dt>
                  <dd class="text-sm opacity-80 text-right">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {/* Print / Licensing CTA */}
        <div>
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-4 sm:mb-6">Acquire</p>
          <p class="text-sm sm:text-base opacity-50 leading-relaxed mb-2">
            Available as a limited edition archival print.
          </p>
          {/* Edition of 25 scarcity signal */}
          <p class="text-[10px] sm:text-xs tracking-[0.2em] uppercase text-mute mb-4 sm:mb-6">
            Edition of 25 &middot; Fine art gicl&eacute;e on Hahnem&uuml;hle Photo Rag
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={`mailto:jndwcreative@gmail.com?subject=Print%20Inquiry:%20${encodeURIComponent(image.alt)}`}
              class="btn btn-primary"
            >
              Inquire about this print
            </a>
            <a
              href="/photography"
              class="btn btn-outline"
            >
              Browse all prints
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* RELATED IMAGES */}
  {related.length > 0 && (
    <section class="py-10 sm:py-16 md:py-20 relative z-10">
      <div class="container-wide">
        <div class="reveal">
          <p class="text-xs tracking-[0.25em] uppercase opacity-60 mb-6 sm:mb-8">More from {category.name}</p>
        </div>
        <div class="stagger-children grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3 md:gap-4">
          {related.map((rel) => (
            <a
              href={`/photography/${rel.file}`}
              class="group relative block rounded-lg sm:rounded-card overflow-hidden aspect-[4/3] ring-1 ring-white/5 hover:ring-navy-hour/30 focus-visible:ring-2 focus-visible:ring-cream/70 focus-visible:outline-none transition-all duration-500"
            >
              <picture>
                <source
                  type="image/avif"
                  srcset={`/images/photography/thumb/${rel.file}.avif 400w, /images/photography/gallery/${rel.file}.avif 1200w`}
                  sizes="(max-width: 767px) 50vw, 25vw"
                />
                <source
                  type="image/webp"
                  srcset={`/images/photography/thumb/${rel.file}.webp 400w, /images/photography/gallery/${rel.file}.webp 1200w`}
                  sizes="(max-width: 767px) 50vw, 25vw"
                />
                <img
                  src={`/images/photography/gallery/${rel.file}.webp`}
                  alt={rel.alt}
                  class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-105 will-change-transform"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <p class="text-[10px] sm:text-xs opacity-70">{rel.alt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Back to Gallery CTA */}
  <section class="pb-12 sm:pb-16 md:pb-20 relative z-10">
    <div class="container-narrow text-center">
      <a
        href="/photography"
        class="inline-flex items-center gap-2 text-xs tracking-[0.15em] uppercase text-mute hover:text-navy-hour transition-colors duration-300 min-h-[44px]"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to gallery
      </a>
    </div>
  </section>

  {/* EXIF reveal on scroll - IntersectionObserver, no libraries */}
  <script>
    function initExifReveal() {
      const rows = document.querySelectorAll('.exif-row');
      if (!rows.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3, rootMargin: '0px 0px -40px 0px' });

      rows.forEach(row => observer.observe(row));
    }

    initExifReveal();
    document.addEventListener('astro:after-swap', initExifReveal);
  </script>

  {/* Keyboard navigation - arrow keys between photo pages */}
  <script>
    function initKeyboardNav() {
      const prev = document.getElementById('nav-prev') as HTMLAnchorElement | null;
      const next = document.getElementById('nav-next') as HTMLAnchorElement | null;

      function handleKey(e: KeyboardEvent) {
        // Don't intercept if user is in an input or modifier keys held
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;

        if (e.key === 'ArrowLeft' && prev) {
          e.preventDefault();
          prev.click();
        } else if (e.key === 'ArrowRight' && next) {
          e.preventDefault();
          next.click();
        }
      }

      document.addEventListener('keydown', handleKey);

      // Show arrows on any mouse movement in hero area (desktop affordance)
      const hero = document.querySelector('section:first-of-type');
      if (hero) {
        hero.addEventListener('mouseenter', () => {
          if (prev) prev.style.opacity = '0.6';
          if (next) next.style.opacity = '0.6';
        });
        hero.addEventListener('mouseleave', () => {
          if (prev) prev.style.opacity = '0';
          if (next) next.style.opacity = '0';
        });
      }
    }

    initKeyboardNav();
    document.addEventListener('astro:after-swap', initKeyboardNav);
  </script>

  {/* Print preview on hover - desktop only, CSS-driven */}
  <style>
    @media (hover: hover) {
      .print-cta-hover:hover ~ #print-frame,
      .print-cta-hover:focus-visible ~ #print-frame {
        opacity: 1;
      }
    }
  </style>
  <script>
    function initPrintPreview() {
      const btn = document.querySelector('.btn.btn-primary[href^="mailto:"]');
      const frame = document.getElementById('print-frame');
      if (!btn || !frame) return;

      // Only on desktop with hover capability
      if (!window.matchMedia('(hover: hover)').matches) return;

      btn.addEventListener('mouseenter', () => {
        frame.style.opacity = '1';
      });
      btn.addEventListener('mouseleave', () => {
        frame.style.opacity = '0';
      });
      btn.addEventListener('focus', () => {
        frame.style.opacity = '1';
      });
      btn.addEventListener('blur', () => {
        frame.style.opacity = '0';
      });
    }

    initPrintPreview();
    document.addEventListener('astro:after-swap', initPrintPreview);
  </script>

</BaseLayout>
