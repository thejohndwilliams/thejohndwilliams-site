---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlassPillGL from '../../components/GlassPillGL.astro';
import { getPhotoMeta, formatMetaLine } from '../../utils/photo-meta';
import { categories, getAllSlugs, getAllSlugsSequential, getPhotoBySlug, getRelatedImages, getPlaceholder } from '../../data/photography';

export function getStaticPaths() {
  return getAllSlugs().map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const entry = getPhotoBySlug(slug!);

if (!entry) {
  return Astro.redirect('/photography');
}

const { image, category } = entry;
const meta = getPhotoMeta(image.file);
const metaLine = formatMetaLine(meta);
const related = getRelatedImages(image.file, 4);

const SITE = 'https://thejohndwilliams.com';

// ─── Ambient Color Bleed: category-driven palette ───
// Each category maps to a subtle color that bleeds into the page background.
// These are intentional, not extracted - the semantics drive the atmosphere.
const categoryColors: Record<string, { glow: string; accent: string }> = {
  sky:        { glow: 'rgba(70, 100, 160, 0.08)',  accent: 'rgba(70, 100, 160, 0.04)' },
  earth:      { glow: 'rgba(160, 120, 60, 0.08)',  accent: 'rgba(160, 120, 60, 0.04)' },
  water:      { glow: 'rgba(50, 130, 140, 0.08)',  accent: 'rgba(50, 130, 140, 0.04)' },
  structure:  { glow: 'rgba(120, 110, 100, 0.06)', accent: 'rgba(216, 196, 168, 0.03)' },
  light:      { glow: 'rgba(244, 234, 222, 0.042)',  accent: 'rgba(244, 234, 222, 0.021)' },
};
const bleed = categoryColors[category.id] || categoryColors.structure;

// ─── Keyboard navigation: prev/next in sequential order ───
const allSlugs = getAllSlugsSequential();
const currentIdx = allSlugs.indexOf(image.file);
const prevSlug = currentIdx > 0 ? allSlugs[currentIdx - 1] : null;
const nextSlug = currentIdx < allSlugs.length - 1 ? allSlugs[currentIdx + 1] : null;

// JSON-LD for individual image
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: `${SITE}/images/photography/hero/${image.file}.webp`,
  thumbnailUrl: `${SITE}/images/photography/thumb/${image.file}.webp`,
  name: image.alt,
  description: image.alt,
  creator: { '@type': 'Person', name: 'John D. Williams', url: SITE },
  copyrightHolder: { '@type': 'Person', name: 'John D. Williams' },
  creditText: 'John D. Williams',
  copyrightNotice: '© John D. Williams',
  license: `${SITE}/photography`,
  acquireLicensePage: `mailto:jndwcreative@gmail.com?subject=Print%20Inquiry:%20${encodeURIComponent(image.alt)}`,
  keywords: [category.name, 'fine art photography', meta.camera].filter(Boolean).join(', '),
  ...(meta.captureDate ? { datePublished: meta.captureDate } : {}),
  ...(meta.location ? { contentLocation: { '@type': 'Place', name: meta.location } } : {}),
  isPartOf: {
    '@type': 'ImageGallery',
    name: `${category.name} · Photography by John D. Williams`,
    url: `${SITE}/photography#gallery-${category.id}`,
  },
};

// Build EXIF detail lines
const exifDetails: Array<{ label: string; value: string }> = [];
<REST_OF_FILE_PLACEHOLDER>