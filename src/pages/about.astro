---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPillGL from '../components/GlassPillGL.astro';
import KineticPlate from '../components/KineticPlate.astro';
import KineticPlate3D from '../components/KineticPlate3D.astro';
import Photo from '../components/Photo.astro';
import { getPhotoBySlug } from '../data/photography';

const lightStill = getPhotoBySlug('dsc-0378');
const waterStill = getPhotoBySlug('7r50680-enhanced-sr');
if (!lightStill || !waterStill) {
  throw new Error('About stills are missing from photography.ts');
}
---

<BaseLayout
  title="About"
  description="Making visible. The through-line across film, cybersecurity, data, and photography. John D. Williams."
  ogImage="/og/pages/about.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  lcpImage="john-portrait-bw"
  lcpImagePortrait="john-portrait-bw"
>
  <!-- Scroll progress indicator -->

  <!-- HERO - Portrait with full-bleed image -->
  <section class="relative py-10 sm:py-16 md:py-24 overflow-hidden" data-glass-bench>
    <picture>
      <source media="(max-width: 640px)" type="image/avif" srcset="/images/photography/portrait/john-portrait-bw.avif" />
      <source media="(max-width: 640px)" type="image/webp" srcset="/images/photography/portrait/john-portrait-bw.webp" />
      <source
        type="image/avif"
        srcset="/images/photography/thumb/john-portrait-bw.avif 400w, /images/photography/gallery/john-portrait-bw.avif 1200w, /images/photography/hero/john-portrait-bw.avif 2400w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/photography/thumb/john-portrait-bw.webp 400w, /images/photography/gallery/john-portrait-bw.webp 1200w, /images/photography/hero/john-portrait-bw.webp 2400w"
        sizes="100vw"
      />
      <img
        src="/images/photography/hero/john-portrait-bw.webp"
        alt="John D. Williams, black and white portrait"
        class="absolute inset-0 w-full h-full object-cover object-[center_12%]"
        fetchpriority="high"
      />
    </picture>
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.78) 22%, rgba(10,10,10,0.56) 44%, rgba(10,10,10,0.28) 68%, rgba(10,10,10,0) 100%);"
    ></div>
    <!-- (removed) duplicate hero grain: global body::before already supplies film grain across the whole site -->
    <div class="relative z-10 container-narrow">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">Rising</p>
        <h1 class="mb-5 sm:mb-8">John D. Williams</h1>
      </div>
      {/* More stays under the name. The page-level Inquire pill is gone:
          the footer Inquire is on this page. */}
      <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-3 sm:gap-4 max-w-sm sm:max-w-none">
        <GlassPillGL label="More" href="/" variant="c" class="w-full sm:w-auto justify-center" srSuffix=" from John D. Williams" />
      </div>
    </div>
  </section>

  <!-- BACKGROUND - single merged section, no accordion -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Background</h2>
          <p>
            BA in Film and Digital Media from Baylor, 2015. That degree taught me
            composition, narrative structure, and visual communication: skills I use
            daily. An MBA in Cybersecurity from Baylor followed in 2024.
          </p>
          <p>
            Film takes raw material and organizes it so
            someone else can see what you see. Data engineering is the same problem
            with different inputs. Security makes the invisible visible before it
            causes damage. Photography notices what is already there.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-2 lg:w-[560px] lg:pt-2">
          <KineticPlate3D category="earth" />
          <KineticPlate category="earth" class="plate-fallback" />
          <p class="mt-3 text-micro sm:text-xs tracking-[0.3em] uppercase opacity-60">Earth · rain-wet leaf</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- WHAT I AM BUILDING -->
  <section class="py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1 lg:order-2">
          <h2>What I Am Building</h2>
          <p>
            Outside of work I photograph landscape and nature, and I keep a faith-based
            project.
          </p>
          <p>
            Most of what matters is already in front of us. The work is learning to see it.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-1 lg:w-[560px] lg:pt-2">
          <Photo
            image={lightStill.image}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="block w-full h-auto"
            fallbackTier="gallery"
          />
          <p class="mt-3 text-micro sm:text-xs tracking-[0.3em] uppercase opacity-60">{lightStill.image.alt}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS + OUTSIDE WORK - merged, tight -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Credentials &amp; Practice</h2>
          <p>
            BA in Film and Digital Media, Baylor University (2015). MBA in Cybersecurity,
            Baylor University (2024). Eagle Scout.
          </p>
          <p>
            <a href="/files/Williams-John-D-Resume.pdf">Resume (PDF)</a>
          </p>
          <p>
            I am a nature photographer. I am a person of faith.
            I believe in service, in showing up when it is hard, and in
            doing the work in front of you without waiting for applause.
          </p>
          <p>
            Made things, made visible, in service. That is the whole of it.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-2 lg:w-[560px] lg:pt-2">
          <Photo
            image={waterStill.image}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="block w-full h-auto"
            fallbackTier="gallery"
          />
          <p class="mt-3 text-micro sm:text-xs tracking-[0.3em] uppercase opacity-60">{waterStill.image.alt}</p>
        </aside>
      </div>
    </div>
  </section>

</BaseLayout>
