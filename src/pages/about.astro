---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPillGL from '../components/GlassPillGL.astro';
import KineticPlate from '../components/KineticPlate.astro';
import KineticPlate3D from '../components/KineticPlate3D.astro';
import Photo from '../components/Photo.astro';
import { getPhotoBySlug } from '../data/photography';
import { photoTiers, portraitSrcset } from '../utils/photo-src';

const streamStill = getPhotoBySlug('dscf1792');
const waterStill = getPhotoBySlug('7r50680-enhanced-sr');
if (!streamStill || !waterStill) {
  throw new Error('About stills are missing from photography.ts');
}

// 2026-11-24 cohesion pass (owner): the portrait is a white-ground
// photograph, and full-bleed it made About the one light surface on an ink
// site. It now hangs as a print on the dark wall, the way the gallery hangs
// photographs: the white stays inside the frame instead of becoming the page.
const portrait = photoTiers('john-portrait-bw').portrait!;
const PRINT_SIZES = '(min-width: 1024px) 432px, 78vw';
---

<BaseLayout
  title="About"
  description="Making visible. The through-line across film, cybersecurity, data, and photography. John D. Williams."
  ogImage="/og/pages/about.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <!-- HERO. Lockup on the dark wall, the portrait hung beside it as a print. -->
  <section class="about-hero relative overflow-hidden pb-12 sm:pb-16 md:pb-24" data-hero-under>
    <div class="relative z-10 container-wide">
      <div class="about-hero__grid">
        <div class="reveal about-hero__lockup">
          <p class="eyebrow mb-3 sm:mb-4">Rising</p>
          <h1 class="t-title font-serif tracking-tight mb-4 sm:mb-5">John D. Williams</h1>
          <p class="text-base leading-relaxed max-w-xl mb-6 sm:mb-8">
            Film, then business, then operations.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 max-w-sm sm:max-w-none">
            <GlassPillGL label="Selected work" href="/work/" variant="c" class="w-full sm:w-auto justify-center" />
          </div>
        </div>
        <figure class="reveal reveal-delay-2 about-print">
          <picture>
            <source type="image/avif" srcset={portraitSrcset('john-portrait-bw', 'avif')} sizes={PRINT_SIZES} />
            <source type="image/webp" srcset={portraitSrcset('john-portrait-bw', 'webp')} sizes={PRINT_SIZES} />
            <img
              src="/images/photography/portrait/john-portrait-bw.webp"
              width={portrait.w}
              height={portrait.h}
              alt="John D. Williams, black and white portrait"
              class="about-print__img"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </div>
  </section>

  <!-- BACKGROUND -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Background</h2>
          <p>
            A BA in Film and Digital Media from Baylor in 2015, then an MBA in
            Cybersecurity from Baylor in 2024. Film taught composition,
            narrative structure and visual communication. I use all three daily.
          </p>
          <p>
            I work in operations, risk and controls: process design, escalation
            discipline and analytics, where reliability is not abstract. The
            discipline is the point.
          </p>
          <p>
            Film takes raw material and organizes it so
            someone else can see what you see. Data engineering is the same problem
            with different inputs. Security makes the invisible visible before it
            causes damage. Photography notices what is already there.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-2 lg:w-[560px] lg:pt-2">
          <KineticPlate3D category="earth" />
          <KineticPlate category="earth" class="plate-fallback" />
          <p class="mt-3 text-sm tracking-[0.22em] uppercase text-mute">Earth · rain-wet leaf</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- OUTSIDE OF WORK -->
  <section class="py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1 lg:order-2">
          <h2>Outside of work</h2>
          <p>
            Outside of work I run Noticing: technology consulting, a photography
            practice in landscape and nature work, and a faith-based content
            project.
          </p>
          <p>
            The name comes from a conviction: most of what matters is already in front
            of us. The work is learning to see it.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-1 lg:w-[560px] lg:pt-2">
          <Photo
            image={streamStill.image}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="block w-full h-auto"
            fallbackTier="gallery"
          />
          <p class="mt-3 text-sm tracking-[0.22em] uppercase text-mute">{streamStill.image.alt}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- PRACTICE. Credentials live in the record on Work; this is the person. -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Practice</h2>
          <p>
            I am an Eagle Scout, a nature photographer and a person of faith.
            I believe in service, in showing up when it is hard, and in
            doing the work in front of you without waiting for applause.
          </p>
          <p>
            Made things, made visible, in service. That is the whole of it.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-2 lg:w-[560px] lg:pt-2">
          <Photo
            image={waterStill.image}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="block w-full h-auto"
            fallbackTier="gallery"
          />
          <p class="mt-3 text-sm tracking-[0.22em] uppercase text-mute">{waterStill.image.alt}</p>
        </aside>
      </div>
    </div>
  </section>

</BaseLayout>
