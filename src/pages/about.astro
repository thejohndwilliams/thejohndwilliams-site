---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPillGL from '../components/GlassPillGL.astro';
import KineticPlate from '../components/KineticPlate.astro';
import KineticPlate3D from '../components/KineticPlate3D.astro';
import Photo from '../components/Photo.astro';
import { getPhotoBySlug } from '../data/photography';
import { bleedSizes, heroCapClass, photoSrcset, portraitSizes, portraitSrcset } from '../utils/photo-src';

// 2026-11-24 second pass (owner: "some things have been messed up").
// Restored: the full-bleed portrait hero with the glass More pill bending
// it (his 2026-08-01 design), and the page's elemental sequence, one
// element per section: Earth (the moving plate), Light, Water. The first
// cohesion pass had hung the portrait as a small print and swapped Light
// for a second water picture; both are undone.
const lightStill = getPhotoBySlug('dsc-0378');
const waterStill = getPhotoBySlug('7r50680-enhanced-sr');
if (!lightStill || !waterStill) {
  throw new Error('About stills are missing from photography.ts');
}
const caption = (element: string, alt: string) => `${element} · ${alt.charAt(0).toLowerCase()}${alt.slice(1)}`;
---

<BaseLayout
  title="About"
  description="Making visible. The through-line across film, cybersecurity, data, and photography. John D. Williams."
  ogImage="/og/pages/about.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  lcpImage="john-portrait-bw"
  lcpImagePortrait="john-portrait-bw"
  lcpImageSizes={bleedSizes('john-portrait-bw')}
>
  <!-- HERO - Portrait with full-bleed image. Width stops at the bitmap. -->
  <section class:list={['hero-bleed', heroCapClass('john-portrait-bw'), 'about-hero relative py-10 sm:py-16 md:py-24 overflow-hidden']} data-glass-bench data-hero-under>
    <picture>
      <source media="(max-width: 640px)" type="image/avif" srcset={portraitSrcset('john-portrait-bw', 'avif')} sizes={portraitSizes('john-portrait-bw')} />
      <source media="(max-width: 640px)" type="image/webp" srcset={portraitSrcset('john-portrait-bw', 'webp')} sizes={portraitSizes('john-portrait-bw')} />
      <source
        type="image/avif"
        srcset={photoSrcset('john-portrait-bw', 'avif')}
        sizes={bleedSizes('john-portrait-bw')}
      />
      <source
        type="image/webp"
        srcset={photoSrcset('john-portrait-bw', 'webp')}
        sizes={bleedSizes('john-portrait-bw')}
      />
      <img
        src="/images/photography/hero/john-portrait-bw.webp"
        alt="John D. Williams, black and white portrait"
        class="absolute inset-0 w-full h-full object-cover object-[center_12%]"
        data-bleed-short
        fetchpriority="high"
      />
    </picture>
    <div class="hero-scrim-left absolute inset-0"></div>
    {/* Phones: the portrait crop puts the white ground behind the name and
        the More pill, where the side scrim cannot reach. A second scrim,
        phone only, darkens the top and fades to nothing (attenuation law:
        no opacity on the image, no solid start). */}
    <div class="absolute inset-0 sm:hidden" style="background-image: linear-gradient(to bottom, rgba(10,10,10,0.72) 0%, rgba(10,10,10,0.5) 45%, rgba(10,10,10,0.18) 75%, rgba(10,10,10,0) 100%);"></div>
    <!-- (removed) duplicate hero grain: global body::before already supplies film grain across the whole site -->
    <div class="relative z-10 container-narrow">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-3 sm:mb-4">Rising</p>
        <h1 class="mb-4 sm:mb-5">John D. Williams</h1>
        <p class="text-base leading-relaxed max-w-xl mb-6 sm:mb-8">Film, then business, then operations.</p>
      </div>
      {/* More stays under the name. The page-level pill is gone:
          the footer Contact is on this page. */}
      <div class="reveal reveal-delay-2 flex flex-col sm:flex-row gap-3 sm:gap-4 max-w-sm sm:max-w-none">
        <GlassPillGL label="More" href="/" variant="c" class="w-full sm:w-auto justify-center" srSuffix=" from John D. Williams" />
      </div>
    </div>
  </section>

  <!-- BACKGROUND · EARTH -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="about-row">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Background</h2>
          <p>
            A BA in Film and Digital Media from Baylor in 2015, then an MBA in
            Cybersecurity from Baylor in 2024. Film taught composition,
            narrative structure and visual communication. I use all three daily.
          </p>
          <p>
            I work in operations, risk and controls: process design, escalation
            discipline and analytics, where reliability is not abstract. The
            discipline is the point.
          </p>
          <p>
            Film takes raw material and organizes it so someone else can see
            what you see. Data engineering is the same problem with different
            inputs. Security makes the invisible visible before it causes damage.
            Photography notices what is already there.
          </p>
        </div>
        <aside class="reveal about-figure lg:order-2">
          <KineticPlate3D category="earth" />
          <KineticPlate category="earth" class="plate-fallback" />
          <p class="about-caption">Earth · rain-wet leaf</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- NOTICING · LIGHT -->
  <section class="py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="about-row">
        <div class="reveal prose max-w-2xl lg:flex-1 lg:order-2">
          <h2>Noticing</h2>
          <p>
            Outside of work I run Noticing: technology consulting, a photography
            practice in landscape and nature work, and a faith-based content
            project.
          </p>
          <p>
            The name comes from a conviction: most of what matters is already in
            front of us. The work is learning to see it.
          </p>
        </div>
        <aside class="reveal about-figure lg:order-1">
          <Photo
            image={lightStill.image}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="block w-full h-auto"
            fallbackTier="gallery"
          />
          <p class="about-caption">{caption('Light', lightStill.image.alt)}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- PRACTICE · WATER -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="about-row">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Practice</h2>
          <p>
            I am an Eagle Scout, a nature photographer and a person of faith.
            I believe in service, in showing up when it is hard, and in doing
            the work in front of you without waiting for applause.
          </p>
          <p>
            Made things, made visible, in service. That is the whole of it.
          </p>
        </div>
        <aside class="reveal about-figure lg:order-2">
          <Photo
            image={waterStill.image}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="block w-full h-auto"
            fallbackTier="gallery"
          />
          <p class="about-caption">{caption('Water', waterStill.image.alt)}</p>
        </aside>
      </div>
    </div>
  </section>

</BaseLayout>
