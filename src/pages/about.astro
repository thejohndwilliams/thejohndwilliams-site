---
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticPlate from '../components/KineticPlate.astro';
---

<BaseLayout
  title="About"
  description="Making visible. The through-line across film, cybersecurity, data, and photography. John D. Williams."
  ogImage="/images/photography/hero/john-portrait-bw.webp"
  lcpImage="john-portrait-bw"
>
  <!-- Scroll progress indicator -->
  <div id="scroll-progress" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-gold to-gold-light z-50 pointer-events-none" style="width: 0%; transition: width 0.1s linear;" aria-hidden="true"></div>

  <!-- HERO — Portrait with full-bleed image -->
  <section class="relative py-10 sm:py-16 md:py-24 overflow-hidden">
    <picture>
      <source
        type="image/avif"
        srcset="/images/photography/thumb/john-portrait-bw.avif 400w, /images/photography/gallery/john-portrait-bw.avif 1200w, /images/photography/hero/john-portrait-bw.avif 2400w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/photography/thumb/john-portrait-bw.webp 400w, /images/photography/gallery/john-portrait-bw.webp 1200w, /images/photography/hero/john-portrait-bw.webp 2400w"
        sizes="100vw"
      />
      <img
        src="/images/photography/hero/john-portrait-bw.webp"
        alt="John D. Williams — black and white portrait"
        class="absolute inset-0 w-full h-full object-cover object-top opacity-15"
        fetchpriority="high"
      />
    </picture>
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(to right, #0a0a0a 0%, rgba(10,10,10,0.96) 18%, rgba(10,10,10,0.82) 34%, rgba(10,10,10,0.58) 52%, rgba(10,10,10,0.28) 74%, rgba(10,10,10,0) 100%);"
    ></div>
    <div
      class="absolute inset-0 pointer-events-none"
      aria-hidden="true"
      style="opacity:0.025; mix-blend-mode:soft-light; background-image: url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>&quot;);"
    ></div>
    <div class="relative z-10 container-narrow">
      <div class="reveal max-w-2xl">
        <p class="text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-60 mb-3 sm:mb-4">Rising</p>
        <h1 class="mb-5 sm:mb-8">John D. Williams</h1>
        <p class="text-base sm:text-lg md:text-xl leading-relaxed opacity-70">
          I studied film. I work in cybersecurity. I shoot landscapes on a Sony&nbsp;A7R
          and build data pipelines in Python. The through-line is simple: I make
          things visible — threats on a network, patterns in data, light on a mountain.
        </p>
      </div>
    </div>
  </section>

  <!-- BACKGROUND — single merged section, no accordion -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Background</h2>
          <p>
            BA in Film and Digital Media from Baylor, 2015. That degree taught me
            composition, narrative structure, and visual communication — skills I use
            daily in contexts the film school never imagined. I started law school.
            Life intervened. I finished an MBA in Cybersecurity at Baylor instead
            (2024, 3.86 GPA) and found that the analytical discipline of security
            work suited me better than the courtroom ever would have.
          </p>
          <p>
            For two years I have run enterprise operations for a satellite
            communications company — incident command, forecasting tools built from
            scratch, operational analytics where downtime is not abstract. I cannot
            name the systems or the customers. The discipline is the point.
          </p>
          <p>
            People ask why a film graduate ended up here. The honest answer: I never
            left the core discipline. Film takes raw material and organizes it so
            someone else can see what you see. Data engineering is the same problem
            with different inputs. Security makes the invisible visible before it
            causes damage. Photography notices what is already there.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-2 lg:w-[560px] lg:pt-2">
          <KineticPlate category="earth" />
          <p class="mt-3 text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-60">Earth — rain-wet leaf</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- WHAT I AM BUILDING -->
  <section class="py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1 lg:order-2">
          <h2>What I Am Building</h2>
          <p>
            Outside of work, I am building Noticing — a venture with three arms.
            Noticing Solutions handles AI and technology consulting. Noticing Nature
            is my photography practice: landscape and nature work, nearly 3,000 images
            in the archive, print sales on the way. Noticing Scripture is a
            faith-based content project structured as a nonprofit.
          </p>
          <p>
            The name comes from a conviction: most of what matters is already in front
            of us. The work is learning to see it.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-1 lg:w-[560px] lg:pt-2">
          <KineticPlate category="structure" />
          <p class="mt-3 text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-60">Structure — Shanghai Tower</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS + OUTSIDE WORK — merged, tight -->
  <section class="section-light py-10 sm:py-16 md:py-24">
    <div class="container-wide">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <div class="reveal prose max-w-2xl lg:flex-1">
          <h2>Credentials &amp; Practice</h2>
          <p>
            BA in Film and Digital Media, Baylor University (2015). MBA in Cybersecurity,
            Baylor University (2024, 3.86 GPA). Eagle Scout. CompTIA Security+ (in progress).
            Pursuing an Air Force Reserve commission in cybersecurity operations.
          </p>
          <p>
            I am a nature photographer. That is not a hobby line — it is a practice
            with commercial intent, and it feeds everything else I do. I am a person
            of faith. I believe in service, in showing up when it is hard, and in
            doing the work in front of you without waiting for applause.
          </p>
        </div>
        <aside class="reveal shrink-0 lg:order-2 lg:w-[560px] lg:pt-2">
          <KineticPlate category="sky" />
          <p class="mt-3 text-[10px] sm:text-xs tracking-[0.3em] uppercase opacity-60">Sky — thunderheads</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-10 sm:py-16 md:py-24">
    <div class="container-narrow">
      <div class="reveal glass-card p-6 sm:p-8 md:p-10 max-w-lg">
        <h2 class="text-lg sm:text-xl font-serif mb-3 sm:mb-4">Work together?</h2>
        <p class="text-sm sm:text-base opacity-50 mb-6 sm:mb-8">
          I take on select consulting work in data engineering, cybersecurity
          operations, and technical strategy.
        </p>
        <a href="mailto:jndwcreative@gmail.com" class="inline-flex items-center gap-1.5 text-xs sm:text-sm tracking-[0.15em] uppercase font-medium px-5 py-2.5 rounded-full border border-stone/40 text-stone-light hover:border-stone hover:bg-stone/10 transition-all duration-300">
          Get in touch
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>

<script>
  function initScrollProgress() {
    const bar = document.getElementById('scroll-progress');
    if (!bar) return;
    let ticking = false;
    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min((scrollTop / docHeight) * 100, 100) : 0;
      bar.style.width = progress + '%';
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }, { passive: true });
    updateProgress();
  }
  initScrollProgress();
  document.addEventListener('astro:after-swap', initScrollProgress);
</script>
</BaseLayout>
