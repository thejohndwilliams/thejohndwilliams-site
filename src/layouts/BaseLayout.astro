---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** OG image width in px (Twitter/FB/LinkedIn unfurl hint). Defaults to
      2400 for backwards-compat with the full-res default portrait. Pass
      1200 when using a per-page OG generated by scripts/build-og-images.mjs. */
  ogImageWidth?: number;
  /** OG image height in px. Defaults to 1600 for full-res default. Pass
      630 when using a per-page OG. */
  ogImageHeight?: number;
  /** LCP image basename (no extension), served from /images/photography/.
      Browsers will preload the AVIF tier; WebP fallback is implicit via
      imagesrcset with type negotiation. Leave undefined to skip. */
  lcpImage?: string;
  /** Override imagesizes for LCP preload. Default "100vw" fits full-bleed
      heroes. */
  lcpImageSizes?: string;
}

const {
  title = 'John D. Williams',
  description = 'Photography, cybersecurity, and data — the work of John D. Williams.',
  ogImage = '/images/photography/hero/john-portrait-bw.webp',
  ogImageWidth = 2400,
  ogImageHeight = 1600,
  lcpImage,
  lcpImageSizes = '100vw'
} = Astro.props;

const fullTitle = title === 'Home' ? 'John D. Williams' : `${title} | John D. Williams`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://thejohndwilliams.com');
const ogImageURL = new URL(ogImage, Astro.site || 'https://thejohndwilliams.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="John D. Williams" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Theme color — brand midnight for mobile status bars */}
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="msapplication-TileColor" content="#0a0a0a" />

    {/* Apply saved dim/true-black background preference before first paint
         (no flash). Swaps only the solid background tone, never the palette. */}
    <script is:inline>
      try {
        if (localStorage.getItem('jw-theme') === 'black') {
          document.documentElement.setAttribute('data-theme', 'black');
        }
      } catch (e) {}
    </script>

    {/* iOS standalone-mode (Add to Home Screen) — matches theme-color
         so the status bar blends with the page; black-translucent
         lets the hero photograph extend behind it. */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="John D. Williams" />



    {/* Preload critical fonts — self-hosted, no third-party dependency.
         Body font (IBM Plex Sans 400) is critical for LCP; Libre
         Baskerville display serif is used above the fold on every page. */}
    <link rel="preload" href="/fonts/plex/plex-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kmKnZrc3Hgbbcjq75U4uslyuy4kn0qNZaxMaC82U.woff2" as="font" type="font/woff2" crossorigin />

    {/* HDR + wide-gamut palette overrides (Tier 1). Served verbatim from
         public/ so Astro's CSS build pass doesn't gamut-map color(display-p3)
         to sRGB hex. The media attribute makes this non-render-blocking on
         sRGB displays — they still download it at low priority but don't
         delay first paint. The file itself is scoped under
         @media (color-gamut: p3) as a belt-and-suspenders gate. */}
    <link rel="stylesheet" href="/hdr-palette.css" media="(color-gamut: p3)" />

    {lcpImage && (
      <>
        {/* LCP preload ladder. imagesrcset MUST mirror every candidate the
            <picture> tag can resolve to — including the 400w thumb tier —
            or Lighthouse flags prioritize-lcp-image for partial coverage when
            the viewport picks a narrower candidate than the preload offers. */}
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={`/images/photography/hero/${lcpImage}.avif`}
          imagesrcset={`/images/photography/thumb/${lcpImage}.avif 400w, /images/photography/gallery/${lcpImage}.avif 1200w, /images/photography/hero/${lcpImage}.avif 2400w`}
          imagesizes={lcpImageSizes}
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          type="image/webp"
          href={`/images/photography/hero/${lcpImage}.webp`}
          imagesrcset={`/images/photography/thumb/${lcpImage}.webp 400w, /images/photography/gallery/${lcpImage}.webp 1200w, /images/photography/hero/${lcpImage}.webp 2400w`}
          imagesizes={lcpImageSizes}
          fetchpriority="high"
        />
      </>
    )}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{fullTitle}</title>

    {/* JSON-LD Person schema — semantic identity for search engines */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "John D. Williams",
      "url": "https://thejohndwilliams.com",
      "image": "https://thejohndwilliams.com/favicon-512.png",
      "jobTitle": "Cybersecurity & Data Professional",
      "description": "Photography, cybersecurity, and data — the work of John D. Williams.",
      "sameAs": [
        "https://www.linkedin.com/in/john-davis-williams/",
        "https://github.com/thejohndwilliams",
        "https://www.instagram.com/thejohndwilliams/"
      ],
      "knowsAbout": ["Cybersecurity", "Data Analytics", "Photography", "Enterprise Operations"]
    })} />

    {/* View Transitions — cinematic page-to-page feel */}
    <ViewTransitions />

    {/* Directional page transitions — pages occupy a spatial strip.
         Clicking right in the nav slides content left; clicking left
         slides right. Gives each page a physical address. */}
    <style is:global>
      /* Directional dissolve keyframes */
      @keyframes page-drift-out-left {
        from { opacity: 1; transform: translateX(0); }
        to   { opacity: 0; transform: translateX(-40px); }
      }
      @keyframes page-drift-in-right {
        from { opacity: 0; transform: translateX(40px); }
        to   { opacity: 1; transform: translateX(0); }
      }
      @keyframes page-drift-out-right {
        from { opacity: 1; transform: translateX(0); }
        to   { opacity: 0; transform: translateX(40px); }
      }
      @keyframes page-drift-in-left {
        from { opacity: 0; transform: translateX(-40px); }
        to   { opacity: 1; transform: translateX(0); }
      }

      /* Default direction: forward (drift left) */
      ::view-transition-old(page) {
        animation: page-drift-out-left 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }
      ::view-transition-new(page) {
        animation: page-drift-in-right 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }

      /* Reverse direction: backward (drift right) */
      html.nav-back ::view-transition-old(page) {
        animation: page-drift-out-right 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }
      html.nav-back ::view-transition-new(page) {
        animation: page-drift-in-left 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }

      /* Reduced motion: crossfade only, no spatial drift */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(page),
        html.nav-back ::view-transition-old(page) {
          animation: none;
          opacity: 0;
        }
        ::view-transition-new(page),
        html.nav-back ::view-transition-new(page) {
          animation: none;
          opacity: 1;
        }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col pb-32 md:pb-0">
    {/* Liquid Glass Tier 2: SVG displacement filter for .glass-nav.
         Kept for future use; currently unreferenced because iOS Safari
         cannot resolve backdrop-filter: url() at paint time. */}
    <svg width="0" height="0" style="position:absolute;pointer-events:none" aria-hidden="true" focusable="false">
      <filter id="glass-lens" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.013" numOctaves="2" seed="7" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="1.1" result="soft" />
        <feDisplacementMap in="SourceGraphic" in2="soft" scale="2.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-gold focus:text-midnight focus:rounded-md focus:text-sm focus:font-medium">Skip to content</a>
    <Header />
    <main id="content" class="flex-grow" transition:name="page">
      <slot />
    </main>
    <Footer />

    {/* Mobile bottom tab navigation — thumb zone, gallery-grade */}
    <nav id="bottom-nav" class="md:hidden fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-transform duration-300" aria-label="Mobile navigation">
      {/* Inquire pill — floats above the tab bar */}
      <div class="flex justify-center pb-2">
        <a href="mailto:jndwcreative@gmail.com" class="inline-flex items-center gap-2 px-5 py-2.5 min-h-[44px] bg-gold text-[#0a0a0a] rounded-full text-[11px] font-semibold tracking-wide uppercase shadow-lg shadow-gold/25 ring-1 ring-gold-light/30 active:scale-95 transition-transform duration-150">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Inquire
        </a>
      </div>
      {/* Tab bar — 4 items, glass bezel (mobile). Uses .glass-tabbar
           for parity with .glass-nav on desktop: same blur, saturate,
           and a bottom-oriented rim highlight via ::before. */}
      <div class="glass-tabbar relative">
        <div class="flex items-center justify-evenly px-6 h-[52px]">
          <a href="/" class="bottom-nav-item flex flex-col items-center justify-center gap-1 min-w-[4rem] py-2" data-path="/">
            <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1" /></svg>
            <span class="text-[10px] tracking-wider uppercase">Home</span>
          </a>
          <a href="/photography" class="bottom-nav-item flex flex-col items-center justify-center gap-1 min-w-[4rem] py-2" data-path="/photography">
            <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span class="text-[10px] tracking-wider uppercase">Photos</span>
          </a>
          <a href="/work" class="bottom-nav-item flex flex-col items-center justify-center gap-1 min-w-[4rem] py-2" data-path="/work">
            <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
            <span class="text-[10px] tracking-wider uppercase">Work</span>
          </a>
          <a href="/about" class="bottom-nav-item flex flex-col items-center justify-center gap-1 min-w-[4rem] py-2" data-path="/about">
            <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            <span class="text-[10px] tracking-wider uppercase">About</span>
          </a>
        </div>
        {/* Safe area padding for notched phones — transparent so
             the glass tab bar above it reads as one continuous
             surface when blurring content behind. */}
        <div class="h-[env(safe-area-inset-bottom,0px)]"></div>
      </div>
    </nav>

    {/* Back to top — desktop only; mobile uses active-tab-tap convention */}
    <button
      id="back-to-top"
      class="hidden md:flex fixed bottom-8 right-4 sm:right-6 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white/8 backdrop-blur-2xl border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] items-center justify-center opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:bg-white/12 hover:border-white/16"
      aria-label="Back to top"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    {/* Scroll reveal observer — IntersectionObserver, no scroll hijacking */}
    <script>
      function initBottomNav() {
        const nav = document.getElementById('bottom-nav');
        const btn = document.getElementById('back-to-top');
        if (!nav) return;

        // Highlight active tab + scroll-to-top on active tap
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        nav.querySelectorAll('.bottom-nav-item').forEach((item) => {
          const el = item as HTMLElement;
          if (el.dataset.path === currentPath) {
            el.classList.add('text-gold');
            el.addEventListener('click', (e) => {
              e.preventDefault();
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          } else {
            el.classList.add('opacity-60');
          }
        });

        // Show nav after scrolling past hero, hide near footer
        let ticking = false;

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const scrollY = window.scrollY;
              const docHeight = document.documentElement.scrollHeight;
              const winHeight = window.innerHeight;
              const nearBottom = scrollY + winHeight > docHeight - 200;

              // Show bottom nav after 300px scroll
              if (scrollY > 300 && !nearBottom) {
                nav.style.transform = 'translateY(0)';
              } else if (scrollY <= 300) {
                nav.style.transform = 'translateY(100%)';
              }

              // Back to top button — desktop only
              if (btn && window.innerWidth >= 768) {
                if (scrollY > 600) {
                  btn.style.opacity = '1';
                  btn.style.pointerEvents = 'auto';
                  btn.style.transform = 'translateY(0)';
                } else {
                  btn.style.opacity = '0';
                  btn.style.pointerEvents = 'none';
                  btn.style.transform = 'translateY(1rem)';
                }
              }

              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Back to top click
        btn?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      function initReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -48px 0px' }
        );

        document.querySelectorAll('.reveal, .stagger-children').forEach((el) => {
          observer.observe(el);
        });
      }


      // Liquid Glass Tier 1: pointer-tracked specular on glass-card/panel.
      // rAF-throttled, delegated, passive. No-op under prefers-reduced-motion.
      function initGlassSpecular() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        // Pointer tracking is wasted CPU on touch-only devices -- they can't
        // hover, so the specular highlight has nothing to anchor to.
        const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (!canHover) return;
        const selector = '.glass-card, .glass-panel';
        let pending = false;
        let lastX = 0, lastY = 0;
        const handler = (e) => {
          lastX = e.clientX;
          lastY = e.clientY;
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => {
            pending = false;
            const el = document.elementFromPoint(lastX, lastY)?.closest(selector);
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const mx = ((lastX - rect.left) / rect.width) * 100;
            const my = ((lastY - rect.top) / rect.height) * 100;
            el.style.setProperty('--mx', mx + '%');
            el.style.setProperty('--my', my + '%');
          });
        };
        window.addEventListener('pointermove', handler, { passive: true });
      }


      // Photo-theft friction — block native context menu on protected
      // photos and drag. Honest: this does not prevent screenshots
      // (browsers cannot intercept OS-level screen capture). It only
      // raises the floor against casual save-as and drag-to-desktop.
      function initPhotoProtect() {
        document.addEventListener('contextmenu', (e) => {
          const t = e.target;
          if (t instanceof HTMLElement && t.closest('.photo-protect')) {
            e.preventDefault();
          }
        });
        document.addEventListener('dragstart', (e) => {
          const t = e.target;
          if (t instanceof HTMLElement && t.closest('.photo-protect')) {
            e.preventDefault();
          }
        });
      }

      // Run on initial load
      initReveal();
      initBottomNav();
      initGlassSpecular();
      initPhotoProtect();

      // Re-run after View Transitions navigate
      document.addEventListener('astro:after-swap', () => {
        initReveal();
        initBottomNav();
        // Specular listener is attached to window once; no re-init needed.
      });
    </script>

    {/* Transition direction detector — determines spatial relationship
         between current and target page to set drift direction. */}
    <script>
      function getPagePosition(path: string): number {
        const clean = path.replace(/\/$/, '') || '/';
        if (clean === '/') return 0;
        if (clean.startsWith('/photography')) return 1;
        if (clean === '/work') return 2;
        if (clean === '/about') return 3;
        if (clean === '/privacy') return 4;
        return 99;
      }

      document.addEventListener('astro:before-preparation', (ev: any) => {
        const from = getPagePosition(window.location.pathname);
        const to = getPagePosition(new URL(ev.to, window.location.origin).pathname);
        if (to < from) {
          document.documentElement.classList.add('nav-back');
        } else {
          document.documentElement.classList.remove('nav-back');
        }
      });

      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.remove('nav-back');
      });
    </script>
  </body>
</html>
