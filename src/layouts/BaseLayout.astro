---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** OG image width in px (Twitter/FB/LinkedIn unfurl hint). Defaults to
      2400 for backwards-compat with the full-res default portrait. Pass
      1200 when using a per-page OG generated by scripts/build-og-images.mjs. */
  ogImageWidth?: number;
  /** OG image height in px. Defaults to 1600 for full-res default. Pass
      630 when using a per-page OG. */
  ogImageHeight?: number;
  /** LCP image basename (no extension), served from /images/photography/.
      Browsers will preload the AVIF tier; WebP fallback is implicit via
      imagesrcset with type negotiation. Leave undefined to skip. */
  lcpImage?: string;
  /** Override imagesizes for LCP preload. Default "100vw" fits full-bleed
      heroes. */
  lcpImageSizes?: string;
  /** Portrait crop basename in /images/photography/portrait/ for <=640px.
      When set, the LCP preload is split media-wise so phones preload the
      portrait art-direction, not the landscape they won't paint. */
  lcpImagePortrait?: string;
  /** Emit <meta name="robots" content="noindex, nofollow">. For unlinked
      preview/lab pages that must build but never be indexed. */
  noindex?: boolean;
}

const {
  title = 'John D. Williams',
  description = 'Photography, cybersecurity, and data - the work of John D. Williams.',
  ogImage = '/og/pages/home.jpg',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  lcpImage,
  lcpImageSizes = '100vw',
  lcpImagePortrait,
  noindex = false
} = Astro.props;

const fullTitle = title === 'Home' ? 'John D. Williams' : `${title} | John D. Williams`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://thejohndwilliams.com');
const ogImageURL = new URL(ogImage, Astro.site || 'https://thejohndwilliams.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="John D. Williams" />

    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Theme color - brand midnight for mobile status bars */}
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="msapplication-TileColor" content="#0a0a0a" />

    {/* Apply saved dim/true-black background preference before first paint
         (no flash). Swaps only the solid background tone, never the palette. */}
    <script is:inline>
      try {
        if (localStorage.getItem('jw-theme') === 'black') {
          document.documentElement.setAttribute('data-theme', 'black');
        }
      } catch (e) {}
    </script>

    {/* iOS standalone-mode (Add to Home Screen) - matches theme-color
         so the status bar blends with the page; black-translucent
         lets the hero photograph extend behind it. */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="John D. Williams" />



    {/* Preload critical fonts - self-hosted, no third-party dependency.
         Body font (IBM Plex Sans 400) is critical for LCP; EB Garamond
         display serif is used above the fold on every page. */}
    <link rel="preload" href="/fonts/plex/plex-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/eb-garamond/eb-garamond-normal.woff2" as="font" type="font/woff2" crossorigin />

    {/* HDR + wide-gamut palette overrides (Tier 1). Served verbatim from
         public/ so Astro's CSS build pass doesn't gamut-map color(display-p3)
         to sRGB hex. The media attribute makes this non-render-blocking on
         sRGB displays - they still download it at low priority but don't
         delay first paint. The file itself is scoped under
         @media (color-gamut: p3) as a belt-and-suspenders gate. */}
    <link rel="stylesheet" href="/hdr-palette.css" media="(color-gamut: p3)" />

    {lcpImage && (
      <>
        {/* LCP preload ladder — AVIF only, deliberately. Browsers fetch every
            preload whose `type` they support, so pairing AVIF + WebP preloads
            made dual-format engines (all evergreen browsers) download the LCP
            image twice: ~108 KB wasted on desktop, ~36 KB on mobile, measured
            against production 2026-07-01. Engines without AVIF (Safari ≤16.3)
            skip the typed preload and still discover the WebP through the
            <picture> element at parse time.
            imagesrcset MUST mirror every AVIF candidate the <picture> tag can
            resolve to - including the 400w thumb tier - or Lighthouse flags
            prioritize-lcp-image for partial coverage when the viewport picks
            a narrower candidate than the preload offers. */}
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={`/images/photography/hero/${lcpImage}.avif`}
          imagesrcset={`/images/photography/thumb/${lcpImage}.avif 400w, /images/photography/gallery/${lcpImage}.avif 1200w, /images/photography/hero/${lcpImage}.avif 2400w`}
          imagesizes={lcpImageSizes}
          media={lcpImagePortrait ? '(min-width: 641px)' : undefined}
          fetchpriority="high"
        />
        {lcpImagePortrait && (
          <link rel="preload" as="image" type="image/avif" href={`/images/photography/portrait/${lcpImagePortrait}.avif`} media="(max-width: 640px)" fetchpriority="high" />
        )}
      </>
    )}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{fullTitle}</title>

    {/* JSON-LD Person schema - semantic identity for search engines */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "John D. Williams",
      "url": "https://thejohndwilliams.com",
      "image": "https://thejohndwilliams.com/favicon-512.png",
      "jobTitle": "Enterprise Operations, Satellite Communications",
      "description": "Enterprise operations and fine-art photography. The work of John D. Williams.",
      "sameAs": [
        "https://www.linkedin.com/in/john-davis-williams/",
        "https://github.com/thejohndwilliams",
        "https://www.instagram.com/thejohndwilliams/"
      ],
      "knowsAbout": ["Cybersecurity", "Data Analytics", "Photography", "Enterprise Operations"]
    })} />

    {/* View Transitions - cinematic page-to-page feel */}
    <ViewTransitions />

    {/* Directional page transitions - pages occupy a spatial strip.
         Clicking right in the nav slides content left; clicking left
         slides right. Gives each page a physical address. */}
    <style is:global>
      /* Directional dissolve keyframes */
      @keyframes page-drift-out-left {
        from { opacity: 1; transform: translateX(0); }
        to   { opacity: 0; transform: translateX(-40px); }
      }
      @keyframes page-drift-in-right {
        from { opacity: 0; transform: translateX(40px); }
        to   { opacity: 1; transform: translateX(0); }
      }
      @keyframes page-drift-out-right {
        from { opacity: 1; transform: translateX(0); }
        to   { opacity: 0; transform: translateX(40px); }
      }
      @keyframes page-drift-in-left {
        from { opacity: 0; transform: translateX(-40px); }
        to   { opacity: 1; transform: translateX(0); }
      }

      /* Default direction: forward (drift left) */
      ::view-transition-old(page) {
        animation: page-drift-out-left 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }
      ::view-transition-new(page) {
        animation: page-drift-in-right 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }

      /* Reverse direction: backward (drift right) */
      html.nav-back ::view-transition-old(page) {
        animation: page-drift-out-right 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }
      html.nav-back ::view-transition-new(page) {
        animation: page-drift-in-left 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
      }

      /* Reduced motion: crossfade only, no spatial drift */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(page),
        html.nav-back ::view-transition-old(page) {
          animation: none;
          opacity: 0;
        }
        ::view-transition-new(page),
        html.nav-back ::view-transition-new(page) {
          animation: none;
          opacity: 1;
        }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col pb-32 md:pb-0">
    {/* Liquid Glass Tier 2: SVG displacement filter for .glass-nav.
         Kept for future use; currently unreferenced because iOS Safari
         cannot resolve backdrop-filter: url() at paint time. */}
    <svg width="0" height="0" style="position:absolute;pointer-events:none" aria-hidden="true" focusable="false">
      <filter id="glass-lens" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.013" numOctaves="2" seed="7" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="1.1" result="soft" />
        <feDisplacementMap in="SourceGraphic" in2="soft" scale="2.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-cream focus:text-midnight focus:rounded-md focus:text-sm focus:font-medium">Skip to content</a>
    <Header />
    <main id="content" class="flex-grow" transition:name="page">
      <slot />
    </main>
    <Footer />


    {/* Back to top - desktop only; mobile uses active-tab-tap convention */}
    <button
      id="back-to-top"
      class="hidden md:flex fixed bottom-8 right-4 sm:right-6 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-full glass-control items-center justify-center opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
      aria-label="Back to top"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    {/* Scroll reveal observer - IntersectionObserver, no scroll hijacking */}
    <script>
      // P1 lock, 2026-07-19: initBottomNav re-runs on every astro:after-swap
      // while window persists. Without teardown, each navigation stacked one
      // more scroll listener whose closure retained that page's detached DOM
      // (the 2026-06-09 failure class). All listeners ride one controller,
      // aborted at the top of every re-init.
      let bottomNavAbort = null;
      function initBottomNav() {
        bottomNavAbort?.abort();
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        bottomNavAbort = new AbortController();
        const signal = bottomNavAbort.signal;
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              if (window.innerWidth >= 768) {
                if (window.scrollY > 600) {
                  btn.style.opacity = '1';
                  btn.style.pointerEvents = 'auto';
                  btn.style.transform = 'translateY(0)';
                } else {
                  btn.style.opacity = '0';
                  btn.style.pointerEvents = 'none';
                  btn.style.transform = 'translateY(1rem)';
                }
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true, signal });
        btn.addEventListener('click', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); }, { signal });
      }

      function initReveal() {
        // Tell the inline failsafe the bundle executed.
        window.__revealReady = true;
        const els = document.querySelectorAll('.reveal, .stagger-children');
        // Reduced-motion or no IntersectionObserver: reveal immediately.
        // Content must never be stuck at opacity:0.
        if (!('IntersectionObserver' in window) ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -48px 0px' }
        );
        els.forEach((el) => observer.observe(el));
      }


      // Liquid Glass Tier 1: pointer-tracked specular on glass-card/panel.
      // rAF-throttled, delegated, passive. No-op under prefers-reduced-motion.
      function initGlassSpecular() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        // Pointer tracking is wasted CPU on touch-only devices -- they can't
        // hover, so the specular highlight has nothing to anchor to.
        const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (!canHover) return;
        const selector = '.glass-card, .glass-panel, .glass-chip-rail, .glass-disc, #site-header, footer.glass-footer';
        let pending = false;
        let lastX = 0, lastY = 0;
        const handler = (e) => {
          lastX = e.clientX;
          lastY = e.clientY;
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => {
            pending = false;
            const el = document.elementFromPoint(lastX, lastY)?.closest(selector);
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const mx = ((lastX - rect.left) / rect.width) * 100;
            const my = ((lastY - rect.top) / rect.height) * 100;
            el.style.setProperty('--mx', mx + '%');
            el.style.setProperty('--my', my + '%');
          });
        };
        window.addEventListener('pointermove', handler, { passive: true });
      }


      // Photo-theft friction - block native context menu on protected
      // photos and drag. Honest: this does not prevent screenshots
      // (browsers cannot intercept OS-level screen capture). It only
      // raises the floor against casual save-as and drag-to-desktop.
      function initPhotoProtect() {
        document.addEventListener('contextmenu', (e) => {
          const t = e.target;
          if (t instanceof HTMLElement && t.closest('.photo-protect')) {
            e.preventDefault();
          }
        });
        document.addEventListener('dragstart', (e) => {
          const t = e.target;
          if (t instanceof HTMLElement && t.closest('.photo-protect')) {
            e.preventDefault();
          }
        });
      }

      // Run on initial load
      initReveal();
      initBottomNav();
      initPhotoProtect();
      initGlassSpecular();

      // Re-run after View Transitions navigate
      document.addEventListener('astro:after-swap', () => {
        initReveal();
        initBottomNav();
        // Specular listener is attached to window once; no re-init needed.
      });
    </script>

    {/* Reveal failsafe - inline (NOT bundled), so it runs even if the main
        module fails to load/parse on older mobile Safari or a flaky chunk.
        If the bundle never set __revealReady, force all reveal content
        visible so images can never be stuck invisible. */}
    <script is:inline>
      addEventListener('load', function () {
        setTimeout(function () {
          if (window.__revealReady) return;
          document.querySelectorAll('.reveal, .stagger-children').forEach(function (el) {
            el.classList.add('visible');
          });
        }, 1500);
      });
    </script>

    {/* Transition direction detector - determines spatial relationship
         between current and target page to set drift direction. */}
    <script>
      function getPagePosition(path: string): number {
        const clean = path.replace(/\/$/, '') || '/';
        if (clean === '/') return 0;
        if (clean.startsWith('/photography')) return 1;
        if (clean === '/work') return 2;
        if (clean === '/about') return 3;
        if (clean === '/privacy') return 4;
        return 99;
      }

      document.addEventListener('astro:before-preparation', (ev: any) => {
        const from = getPagePosition(window.location.pathname);
        const to = getPagePosition(new URL(ev.to, window.location.origin).pathname);
        if (to < from) {
          document.documentElement.classList.add('nav-back');
        } else {
          document.documentElement.classList.remove('nav-back');
        }
      });

      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.remove('nav-back');
      });
    </script>
    {/* Lenis - patient smooth scroll (Reverent Dark "slowness is the brand").
         Desktop wheel; touch stays native. Off under reduced-motion. Exposed as
         window.__lenis so in-page anchors can scrollTo past the sticky header. */}
    <script>
      import Lenis from 'lenis';
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ duration: 1.4, easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
        (window as any).__lenis = lenis;
        const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
        document.addEventListener('astro:after-swap', () => {
          // P1 lock, 2026-07-19: the lightbox scroll lock stops this persisted
          // Lenis instance and sets html.lb-open. History-traversing away with
          // the viewer open skipped unlockScroll, leaving wheel input dead and
          // the chrome hidden on the next page. <html> and Lenis both persist,
          // so the swap handler is the one owner that always runs.
          document.documentElement.classList.remove('lb-open');
          lenis.start?.();
          lenis.scrollTo(0, { immediate: true });
        });
      }
    </script>
    {/* Inject the encircle-then-dissolve wake element into every crystal button
         so the tuned ::before rim and ::after specular stay untouched. */}
    <script>
      function addBtnWake() {
        document.querySelectorAll('.btn-primary, .btn-outline').forEach((b) => {
          if (!b.querySelector('.btn-wake')) {
            const s = document.createElement('span');
            s.className = 'btn-wake';
            s.setAttribute('aria-hidden', 'true');
            b.appendChild(s);
          }
        });
      }
      addBtnWake();
      document.addEventListener('astro:after-swap', addBtnWake);
    </script>
  </body>
</html>
