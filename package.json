{
  "name": "thejohndwilliams",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "gate": "node scripts/check-node.mjs && npm run build && vitest run && playwright test",
    "gate:quick": "node scripts/check-node.mjs && npm run build && vitest run",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/emit-kinetic-frames.mjs && astro build && node scripts/build-og-images.mjs",
    "build:og": "node scripts/build-og-images.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "build:placeholders": "node scripts/build-photo-placeholders.mjs",
    "audit:pages": "node scripts/audit-pages.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.0",
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "astro": "^4.16.0",
    "lenis": "^1.3.23",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@vitest/coverage-v8": "^4.0.17",
    "dom-accessibility-api": "^0.7.1",
    "happy-dom": "^20.3.3",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "simple-icons": "^16.16.0",
    "vitest": "^4.0.17"
  }
}
