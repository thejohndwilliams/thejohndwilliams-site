{
  "name": "thejohndwilliams",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "gate": "node scripts/check-node.mjs && npm run build && vitest run && playwright test",
    "gate:quick": "node scripts/check-node.mjs && npm run build && vitest run",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/emit-kinetic-frames.mjs && astro build && node scripts/build-og-images.mjs",
    "build:og": "node scripts/build-og-images.mjs",
    "build:portraits": "node scripts/build-portrait-crops.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "build:placeholders": "node scripts/build-photo-placeholders.mjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "kinetic:setup": "node scripts/kinetic/setup.mjs",
    "kinetic:build": "node scripts/kinetic/build.mjs",
    "preview:status": "node scripts/preview-status.mjs",
    "visual:baseline": "node scripts/visual-regress.mjs --update",
    "visual:check": "node scripts/visual-regress.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/vue": "^4.5.3",
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@quasar/extras": "^2.0.2",
    "astro": "^4.16.0",
    "lenis": "^1.3.23",
    "quasar": "^2.23.4",
    "tailwindcss": "^3.4.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.0.17",
    "@vue/test-utils": "^2.4.11",
    "dom-accessibility-api": "^0.7.1",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "vitest": "^4.0.17"
  }
}
