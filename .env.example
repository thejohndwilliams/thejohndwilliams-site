# ── R2 ingestion (scripts/ingest-to-r2.mjs) ──────────────────────────
# Required for uploading originals to Cloudflare R2. Not needed for
# day-to-day `astro build` or `vitest` runs — only when running
# `node scripts/ingest-to-r2.mjs` against the R2 bucket.
#
# See docs/r2-migration-runbook.md for setup (token scopes, click path).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=thejohndwilliams-photos

# Optional: where ingest-to-r2 records the public base URL in the
# manifest. When set, <Photo source="r2"> emits srcset URLs rooted at
# this hostname; otherwise falls back to /cdn-cgi/image/ path form.
R2_PUBLIC_BASE=https://images.thejohndwilliams.com

# Optional: override the source directory for ingestion (defaults to
# the iCloud Gallery_Images path in ingest-to-r2.mjs).
# SOURCE_DIR=/Users/you/path/to/batch

# ── Astro build-time (read via import.meta.env) ──────────────────────
# Custom hostname for Cloudflare Image Resizing. When set, <Photo>
# components with source: 'r2' emit srcset URLs like
#   https://images.thejohndwilliams.com/cdn-cgi/image/width=1200,format=auto/<key>
#
# Leave empty to use the zone-direct path form. MUST be set for
# production unless the R2 bucket is bound to the same zone as the site.
PUBLIC_R2_IMAGE_BASE=https://images.thejohndwilliams.com

# ── Traffic report (scripts/traffic-report.mjs) ──────────────────────
# Read-only Cloudflare Analytics token (Zone.Zone:Read + Zone.Analytics:Read,
# scoped to thejohndwilliams.com). OPTIONAL here — the script's preferred
# source is the macOS keychain item `cloudflare-analytics`:
#   security add-generic-password -s cloudflare-analytics -a thejohndwilliams.com -w '<token>' -U
# CLOUDFLARE_ANALYTICS_TOKEN=

# Optional: zone ID cache; skips the one REST lookup per run.
# CF_ZONE_ID=
